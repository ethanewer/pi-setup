# LF everywhere by default: bin/pi-setup-vendor --verify must reproduce
# forks/ byte for byte from patches/, which record LF content. On machines
# with core.autocrlf=true, per-file LF lists miss new paths and the
# verification gate breaks.
* text=auto eol=lf

# cmd.exe shims
*.cmd text eol=crlf
*.bat text eol=crlf
