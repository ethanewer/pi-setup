@prefix ex: <http://keystone.sage.example/seed/> .
@prefix kbs: <http://keystone.sage.example/schema#> .

ex:q-axa a kbs:Recruit ; kbs:name "Reva Ostry" ; kbs:secondedTo ex:h-core .
ex:q-ben a kbs:Recruit ; kbs:name "Dion Falkner" ; kbs:secondedTo ex:h-core , ex:h-west , ex:h-core .
ex:q-cle a kbs:Recruit ; kbs:name "Undella Pyr" ; kbs:secondedTo ex:h-west .
ex:q-zor a kbs:Recruit ; kbs:name "Marin Wren" .                     # no secondment -> skip
ex:q-uno a kbs:Recruit ;                       kbs:secondedTo ex:h-core .  # no name -> skip
ex:decoy kbs:name "Lor Boarding" ;               kbs:secondedTo ex:h-west .  # not a Recruit
ex:anchor a kbs:Recruit ; kbs:name "Anchor Ray" ; kbs:secondedTo ex:h-opn .    # firm with no name
ex:h-core a kbs:Studio ; kbs:name "Core Hearth" .
ex:h-west a kbs:Studio ; kbs:name "West Docks" .
ex:h-site a kbs:Studio ; kbs:name "Site Assembly" .
ex:h-opn  a kbs:Studio .
