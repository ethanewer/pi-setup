{
  "builder": "haru-amber",
  "imageld": "haru-amber-initramfs",
  "shell_path": "/bin/sh",
  "busybox_source": "/usr/bin/busybox",
  "busybox_dest": "/bin/busybox",
  "applet_links": [
    "/bin/sh", "/bin/ls", "/bin/cat", "/bin/echo", "/bin/mount",
    "/bin/ps", "/bin/date", "/bin/printf", "/bin/sleep", "/bin/poweroff"
  ],
  "directory_roots": ["/proc", "/sys", "/dev", "/dev/pts", "/tmp", "/bin"],
  "device_nodes": [
    { "path": "/dev/console", "type": "c", "major": 5, "minor": 1 },
    { "path": "/dev/null",    "type": "c", "major": 1, "minor": 3 },
    { "path": "/dev/ttyS0",   "type": "c", "major": 4, "minor": 64 }
  ],
  "init": {
    "mount_steps": [
      "mount -t proc proc /proc",
      "mount -t sysfs sys /sys",
      "mkdir -p /dev/pts",
      "mount -t devpts devpts /dev/pts"
    ],
    "banner": "amber-upland-boot-v1",
    "exec_shell": "/bin/sh"
  },
  "archive": "gzipped newc cpio"
}