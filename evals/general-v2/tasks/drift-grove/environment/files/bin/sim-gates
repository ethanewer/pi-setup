#!/usr/bin/env python3
"""Grove gate simulator: topological evaluation of a combinational netlist.

usage: sim-gates <net.def> <bits.txt>

net.def format:
  INPUTS <n>
  g<k> XOR <a> <b>     (wires: integer input bit, or g<j> earlier gate)
  OUT <gid | int>
bits.txt: exactly n chars of '0'/'1' on one line.
Gates with a line count above the processing bound (32000) are rejected
(EXPANDED) before evaluation.
Prints RESULT=<0|1> and exits 0 on success, 1 on any rejection.
"""
import sys

STEP_CAP = 32000


def main() -> int:
    net, bits = sys.argv[1], sys.argv[2]
    with open(bits) as fh:
        raw = fh.read().strip()
    ins = [int(ch) for ch in raw if ch in "01"]

    lines = [ln.strip() for ln in open(net) if ln.strip()]
    gate_lines = [ln for ln in lines[1:-1]] if lines and lines[0].startswith("INPUTS") else lines
    if len(gate_lines) + 2 > STEP_CAP:
        print("EXPANDED gates=%d cap=%d" % (len(gate_lines) + 2, STEP_CAP))
        return 1

    if not lines[0].startswith("INPUTS"):
        print("BAD_HEADER")
        return 1
    n = int(lines[0].split()[1])
    if len(ins) != n:
        print("BAD_WIDTH got=%d want=%d" % (len(ins), n))
        return 1

    values = dict((str(i), v) for i, v in enumerate(ins))
    for ln in lines[1:-1]:
        parts = ln.replace(",", " ").split()
        if len(parts) != 4 or parts[0][0] != "g":
            print("PARSE_ERROR: " + ln)
            return 1
        gid, op, a, b = parts[0], parts[1], parts[2], parts[3]
        if a not in values or b not in values:
            print("DANGLING_WIRE: " + ln)
            return 1
        va, vb = values[a], values[b]
        if op == "XOR":
            values[gid] = va ^ vb
        elif op == "AND":
            values[gid] = va & vb
        elif op == "OR":
            values[gid] = va | vb
        else:
            print("BAD_OP: " + op)
            return 1
    out_wire = lines[-1].split()[1]
    if out_wire not in values:
        print("BAD_OUT")
        return 1
    print("RESULT=%d" % values[out_wire])
    return 0


if __name__ == "__main__":
    sys.exit(main())