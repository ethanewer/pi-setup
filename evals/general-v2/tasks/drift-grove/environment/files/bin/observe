#!/usr/bin/env python3
"""The Grove drift-observer oracle fixture.

Exposes a read-only 'drift log' of unknown length via two endpoints only:
    observe <ctx> span <k>   -> prints 1 if log position k exists, else 0
    observe <ctx> leaf <k>   -> prints the log entry at position k, or -EOF

The total length L of the log is derived from the context file, NOT trivially
from its size: an agent that just counts lines/bytes of the ctx file gets the
wrong answer. All probing must go through this program.
"""
import json
import sys


def main() -> int:
    if len(sys.argv) < 3:
        print("USAGE observe <ctx> span|leaf [k]")
        return 2
    ctx = sys.argv[1]
    cmd = sys.argv[2]
    with open(ctx, "rb") as fh:
        raw = fh.read()
    data = json.loads(raw)
    seed = int(data["seed"])
    L = (seed * 73 + 41) % 2001  # hidden length, not readable off the file
    if cmd == "span":
        try:
            k = int(sys.argv[3])
        except (IndexError, ValueError):
            return 2
        print(1 if 0 <= k < L else 0)
        return 0
    if cmd == "leaf":
        try:
            k = int(sys.argv[3])
        except (IndexError, ValueError):
            return 2
        print("leaf-%06d/%04d" % (k, L) if 0 <= k < L else "-EOF")
        return 0
    print("ERR unknown endpoint")
    return 2


if __name__ == "__main__":
    sys.exit(main())