<configuration>
  <!--
    ShoreDFS node-level site configuration (Brume Delta hydrology lab).

    UNCONFIGURED: fill in the required values before the cluster can start.

      - dfs.namenode.rpc-address  : must name the SAME host:port as
                                    fs.defaultFS (complementary functions)
      - dfs.datanode.address      : host:port the datanode binds
      - dfs.replication           : positive integer (single node: 1)
      - dfs.permissions.enabled   : false for the lab sandbox
      - dfs.namenode.name.dir     : namenode metadata directory
      - dfs.datanode.data.dir     : datanode block storage directory
  -->
  <property>
    <name>dfs.namenode.rpc-address</name>
    <value></value>
  </property>
  <property>
    <name>dfs.datanode.address</name>
    <value></value>
  </property>
  <property>
    <name>dfs.replication</name>
    <value></value>
  </property>
  <property>
    <name>dfs.permissions.enabled</name>
    <value></value>
  </property>
  <property>
    <name>dfs.namenode.name.dir</name>
    <value></value>
  </property>
  <property>
    <name>dfs.datanode.data.dir</name>
    <value></value>
  </property>
</configuration>
