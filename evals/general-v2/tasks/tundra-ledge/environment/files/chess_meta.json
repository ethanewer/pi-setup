{
  "meta": "NNT1",
  "class": "ChessNet",
  "forward": {
    "conv1": "Conv2d(in=1, out=16, k=3, pad=1) + ReLU",
    "conv2": "Conv2d(in=16, out=24, k=3, pad=1) + ReLU",
    "conv3": "Conv2d(in=24, out=32, k=3, pad=1) + ReLU",
    "pool":  "global-mean over H,W  -> 32-vector",
    "fc1":   "Linear(32, 8) + ReLU",
    "head":  "Linear(8, 1)"
  },
  "param_order": [
    "conv1.weight", "conv1.bias",
    "conv2.weight", "conv2.bias",
    "conv3.weight", "conv3.bias",
    "fc1.weight",   "fc1.bias",
    "head.weight",  "head.bias"
  ],
  "codecs": "each tensor is int8-quantized (type byte 1) with float32 scale, or raw float32 (type byte 2) for biases"
}