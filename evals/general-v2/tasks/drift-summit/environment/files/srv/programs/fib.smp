# fib.smp - register Fibonacci loop; result printed via OUT.
# R0 = iteration counter (n), R1 = fib(k-1), R2 = fib(k), R3 = scratch.
# fib(8) = 21 is left on the stack and printed by OUT at the end.
0x0000 PUSH 8
0x0001 STORE 0
0x0002 PUSH 0
0x0003 STORE 1
0x0004 PUSH 1
0x0005 STORE 2
0x0006 LOAD 0
0x0007 JZ 0x0015
0x0008 LOAD 1
0x0009 LOAD 2
0x000a ADD
0x000b STORE 3
0x000c LOAD 2
0x000d STORE 1
0x000e LOAD 3
0x000f STORE 2
0x0010 LOAD 0
0x0011 PUSH 1
0x0012 SUB
0x0013 STORE 0
0x0014 JMP 0x0006
0x0015 LOAD 2
0x0016 OUT
0x0017 HALT