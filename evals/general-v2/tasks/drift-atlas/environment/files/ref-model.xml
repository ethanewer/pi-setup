<mujoco model="atlas_swing">
  <compiler angle="radian" coordinate="local" autolimits="true"/>
  <option gravity="0 0 -9.81" integrator="RK4" timestep="0.002"/>
  <default>
    <geom density="1000" friction="1 0.005 0.0001" condim="1"/>
    <joint damping="0.15" armature="0.01"/>
    <motor ctrllimited="true" ctrlrange="-30 30"/>
  </default>
  <worldbody>
    <light pos="0 0 3" directional="true"/>
    <body name="pend" pos="0 0 0">
      <joint name="shoulder" type="hinge" axis="0 0 1" limited="false"/>
      <geom name="rod" type="cylinder" fromto="0 0 0 0.8 0 0" size="0.02" mass="0.9"/>
      <geom name="tip" type="sphere" pos="0.8 0 0" size="0.06" mass="0.4"/>
    </body>
  </worldbody>
  <actuator>
    <motor name="drive" joint="shoulder" gear="0.07" ctrllimited="true" ctrlrange="-30 30"/>
  </actuator>
  <sensor>
    <jointpos joint="shoulder" name="angle"/>
  </sensor>
</mujoco>