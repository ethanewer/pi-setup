# plotsmith Makefile. Reads HEADLESS from config.mk (generated by ./configure).
#   HEADLESS=1 -> builds `plotsmith`   (non-graphical engine, no X11 at all)
#   HEADLESS=0 -> builds `plotsmith-x` (X11 frontend, links the X11 shim)

include config.mk

CC      ?= gcc
CFLAGS  ?= -O2 -Wall -Wextra
COMPAT  = compat

CORE_SRC = core/main.c core/canvas.c core/job.c core/pbm.c core/front_null.c
CORE_OBJ = $(CORE_SRC:.c=.o)

ifeq ($(HEADLESS),1)
BIN     = plotsmith
OBJS    = $(CORE_OBJ)
XFLAGS  =
XLIBS   =
else
BIN     = plotsmith-x
OBJS    = $(CORE_OBJ) gui/xfront.o
CPPFLAGS += -I$(COMPAT)
LDFLAGS += -L$(COMPAT) -Wl,-rpath,$(CURDIR)/$(COMPAT)
XLIBS   = -lX11
endif

all: $(BIN)

$(BIN): $(OBJS)
	$(CC) $(CFLAGS) -o $@ $(OBJS) $(LDFLAGS) $(XLIBS)

core/%.o: core/%.c core/canvas.h core/job.h core/pbm.h core/front.h
	$(CC) $(CFLAGS) -c -o $@ $<

gui/%.o: gui/%.c core/front.h
	$(CC) $(CFLAGS) $(CPPFLAGS) -c -o $@ $<

$(COMPAT)/libX11.so.1: $(COMPAT)/xstub.c $(COMPAT)/X11/Xlib.h
	$(CC) -shared -fPIC -Wl,-soname,libX11.so.1 -o $@ $(COMPAT)/xstub.c

ifeq ($(HEADLESS),0)
$(BIN): $(COMPAT)/libX11.so.1
endif

clean:
	rm -f $(CORE_OBJ) gui/xfront.o $(BIN) $(COMPAT)/libX11.so.1

.PHONY: all clean
