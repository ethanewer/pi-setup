#!/bin/sh
# plotsmith configure. Writes config.mk for the Makefile.
#
#   --with-x      (default) build the X11 frontend binary `plotsmith-x`,
#                 which links against the X11 library shim under compat/
#   --without-x   build only the non-graphical engine as `plotsmith`;
#                 the X11 frontend and its linking are excluded entirely
#
# Unknown options are rejected with a non-zero exit.

HEADLESS=0
for arg in "$@"; do
    case "$arg" in
        --with-x)    HEADLESS=0 ;;
        --without-x) HEADLESS=1 ;;
        *) echo "configure: unknown option: $arg" >&2; exit 1 ;;
    esac
done

cat > config.mk <<EOF
# Generated by ./configure
HEADLESS=$HEADLESS
EOF
echo "configure: HEADLESS=$HEADLESS (run 'make' next)"
