#!/usr/bin/env python3
"""Patch the bundled pi-ai inside @earendil-works/pi-coding-agent dist/bundle.

The npm entrypoint of pi (`bin = dist/bundle/cli.js`) loads pi-ai from
`dist/bundle/chunks/openai-completions-*.js`, NOT from node_modules. The
repo's node_modules patch (patches/pi-ai@0.84.3-reasoning-details.patch)
therefore has no effect on any pi invoked through the bundle — e.g. every
harbor container install. This script applies the same reasoning-details
fix (stream-delta concatenation + historical replay normalization) to the
bundle chunk by exact string replacement.

Version-guarded to pi-coding-agent 0.84.3. Idempotent. Fails loudly.

Usage: patch-pi-bundle <pi-coding-agent-root>
"""
import glob
import json
import sys

PINNED_VERSION = "0.84.3"

PARSE_OLD = (
    "function parseOpenAIReasoningDetails(signature){if(signature)try{"
    "let parsed=JSON.parse(signature);return Array.isArray(parsed)&&"
    "parsed.length>0&&parsed.every(isOpenAIReasoningDetail)?parsed:void 0}"
    "catch{return}}"
)
PARSE_NEW = (
    "function fillMissingCommonReasoningDetailFields(target,source){"
    "target.id??=source.id;target.format||=source.format;target.index??=source.index}"
    "function appendOpenAIReasoningDetail(details,detail){"
    "let lastDetail=details[details.length-1];"
    'if(detail.type==="reasoning.text"&&lastDetail?.type==="reasoning.text"){'
    "lastDetail.text+=detail.text;lastDetail.signature||=detail.signature;"
    "fillMissingCommonReasoningDetailFields(lastDetail,detail);return}"
    'if(detail.type==="reasoning.summary"&&lastDetail?.type==="reasoning.summary"){'
    "lastDetail.summary+=detail.summary;"
    "fillMissingCommonReasoningDetailFields(lastDetail,detail);return}"
    "details.push({...detail})}"
    "function normalizeOpenAIReasoningDetails(details){"
    "let normalized=[];for(let detail of details)appendOpenAIReasoningDetail(normalized,detail);"
    "return normalized}"
    "function parseOpenAIReasoningDetails(signature){if(signature)try{"
    "let parsed=JSON.parse(signature);return Array.isArray(parsed)&&"
    "parsed.length>0&&parsed.every(isOpenAIReasoningDetail)?"
    "normalizeOpenAIReasoningDetails(parsed):void 0}catch{return}}"
)
PUSH_OLD = (
    "preservedDetails.push(detail),"
    "block.thinkingSignature=JSON.stringify(preservedDetails)"
)
PUSH_NEW = (
    "appendOpenAIReasoningDetail(preservedDetails,detail),"
    "block.thinkingSignature=JSON.stringify(preservedDetails)"
)
MARKER = "normalizeOpenAIReasoningDetails"


def fail(msg: str) -> None:
    print(f"patch-pi-bundle: {msg}", file=sys.stderr)
    sys.exit(1)


def main() -> None:
    if len(sys.argv) != 2:
        fail("usage: patch-pi-bundle <pi-coding-agent-root>")
    root = sys.argv[1].rstrip("/")

    try:
        version = json.load(open(f"{root}/package.json"))["version"]
    except Exception as exc:
        fail(f"cannot read {root}/package.json: {exc}")
    if version != PINNED_VERSION:
        fail(
            f"refusing to patch pi-coding-agent {version}; "
            f"this patcher is version-guarded to {PINNED_VERSION}."
        )

    candidates = glob.glob(f"{root}/dist/bundle/chunks/openai-completions-*.js")
    if len(candidates) != 1:
        fail(f"expected exactly one bundle chunk, found: {candidates}")
    chunk = candidates[0]

    src = open(chunk, encoding="utf-8").read()
    if MARKER in src and PUSH_OLD not in src and PARSE_OLD not in src:
        print(f"patch-pi-bundle: already patched ({chunk})")
        return

    if src.count(PARSE_OLD) != 1:
        fail(f"parseOpenAIReasoningDetails anchor not found exactly once in {chunk}")
    if src.count(PUSH_OLD) != 1:
        fail(f"preservedDetails.push anchor not found exactly once in {chunk}")

    src = src.replace(PARSE_OLD, PARSE_NEW).replace(PUSH_OLD, PUSH_NEW)
    open(chunk, "w", encoding="utf-8").write(src)

    check = open(chunk, encoding="utf-8").read()
    if MARKER not in check or "appendOpenAIReasoningDetail(preservedDetails,detail)" not in check:
        fail("post-patch verification failed")
    print(f"patch-pi-bundle: patched {chunk}")


if __name__ == "__main__":
    main()
