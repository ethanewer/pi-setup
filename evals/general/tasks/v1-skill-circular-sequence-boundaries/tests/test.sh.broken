#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/wrapped.json ]; then
  if python3 - <<'EOF'
import json,sys
d=json.load(open('/app/seq.json'))
exp=[d['seq'][i%len(d['seq'])] for i in d['queries']]
got=json.load(open('/app/wrapped.json'))
if got.get('values')!=exp: sys.exit("mismatch")
sys.exit(0)
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt