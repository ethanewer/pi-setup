    {"cmd": "add-course", "args": ["MATH201", "Linear Algebra", 2], "exit": 0},
    {"cmd": "register", "args": ["ada@example.org", "CS101", "2024F"], "exit": 0, "quiet": true},
    {"cmd": "register", "args": ["alan@example.org", "CS101", "2024F"], "exit": 0, "quiet": true},
    {"cmd": "register", "args": ["grace@example.org", "MATH201", "2024F"], "exit": 0, "quiet": true},
    {"cmd": "complete", "args": ["ada@example.org", "CS101", "B"], "exit": 0, "quiet": true},
    {"cmd": "roster", "args": ["CS101"], "exit": 0,
     "out": ["EMAIL\tNAME\tSTATUS",
             "ada@example.org\tAda Lovelace\tcompleted",
             "alan@example.org\tAlan Turing\tactive"]},
    {"cmd": "usage", "exit": 0,
     "out": ["CODE\tTITLE\tSEATS\tREGISTERED",
             "CS101\tIntro to Computing\t2\t1",
             "MATH201\tLinear Algebra\t2\t1"]},
    {"cmd": "history", "args": ["ada@example.org"], "exit": 0,
     "out": ["CODE\tTITLE\tSEMESTER\tSTATUS\tGRADE",
             "CS101\tIntro to Computing\t2024F\tcompleted\tB"]},
    {"cmd": "retake", "args": ["ada@example.org", "CS101", "2025S"], "exit": 0, "quiet": true},
    {"cmd": "attempts", "args": ["ada@example.org"], "exit": 0,
     "out": ["EVENT\tCODE\tTITLE\tSEMESTER",
             "registration\tCS101\tIntro to Computing\t2024F",
             "retake\tCS101\tIntro to Computing\t2025S"]},
    {"cmd": "retake", "args": ["ada@example.org", "CS101", "2025S"], "exit": 2},
    {"cmd": "register", "args": ["ada@example.org", "CS101", "2026S"], "exit": 2},
    {"cmd": "withdraw", "args": ["alan@example.org", "CS101"], "exit": 0, "quiet": true},
    {"cmd": "roster", "args": ["CS101"], "exit": 0,
     "out": ["EMAIL\tNAME\tSTATUS",
             "ada@example.org\tAda Lovelace\tcompleted",
             "alan@example.org\tAlan Turing\tdropped"]},
    {"cmd": "usage", "exit": 0,
     "out": ["CODE\tTITLE\tSEATS\tREGISTERED",
             "CS101\tIntro to Computing\t2\t0",
             "MATH201\tLinear Algebra\t2\t1"]},
    {"cmd": "history", "args": ["alan@example.org"], "exit": 0,
     "out": ["CODE\tTITLE\tSEMESTER\tSTATUS\tGRADE",
             "CS101\tIntro to Computing\t2024F\tdropped\t"]},
    {"cmd": "retake", "args": ["grace@example.org", "CS101", "2025S"], "exit": 2},
    {"cmd": "attempts", "args": ["alan@example.org"], "exit": 0,
     "out": ["EVENT\tCODE\tTITLE\tSEMESTER",
             "registration\tCS101\tIntro to Computing\t2024F"]}
  ]
}