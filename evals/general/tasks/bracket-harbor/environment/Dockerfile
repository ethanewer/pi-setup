# bracket-harbor: self-authored Go repository with a cross-package regression.
#
# Builds a 5000+ LOC Go 1.22 module named "bh" with a 14+ commit git history.
# The repository is generated by files/gen/generate_repo.py (deterministic,
# stage-based) and assembled commit-by-commit by files/gen/assemble.sh.
# At HEAD the suite is RED in exactly one place: internal/query's
# TestConditionGrouping, broken by a precedence-tier refactor in
# internal/token made two commits back. The agent must repair the tree.
FROM bench-base:ubuntu-24.04

ENV DEBIAN_FRONTEND=noninteractive

# Go 1.22 toolchain plus git (for the build-time repository construction).
RUN apt-get update -qq && \
    apt-get install -y -qq golang-go git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Any trial uid (root or 1000) may operate on the git repositories built here.
RUN git config --system --add safe.directory '*' && \
    git config --system user.email "build@localhost" && \
    git config --system user.name "build"

# Go caches live under /tmp so both root and uid-1000 trials can build; the
# module has no external dependencies, so networking can stay disabled.
ENV GOTOOLCHAIN=local \
    GOPROXY=off \
    GOCACHE=/tmp/gocache \
    GOPATH=/tmp/gopath \
    GOMODCACHE=/tmp/gopath/pkg/mod

WORKDIR /app
COPY files/ /app/

# Generate the repository with full history, drop the generator, and let any
# uid rewrite the fixture tree (the trial agent must edit files in place).
# gen/ MUST NOT reach the trial image: pkgs/token.py embeds both the correct
# and the regression forms of op.go, so leaving it on disk would hand the
# agent the byte-exact answer and turn the git-archaeology task into a grep.
RUN bash /app/gen/assemble.sh && rm -rf /app/gen && chmod -R a+rwX /app/bh /app

CMD ["/bin/bash"]