#!/bin/bash
# Verifier for skill-tokenizers.
mkdir -p /logs/verifier
reward=0

if [ -f /app/tokens.json ]; then
  if python3 - <<'PY'
import json, re
text = open("/app/sample.txt", encoding="utf-8").read()
want = re.findall(r"[A-Za-z0-9]+|[^A-Za-z0-9]", text)
r = json.load(open("/app/tokens.json"))
assert r["tokens"] == want, (r["tokens"], want)
assert r["count"] == len(want)
PY && reward=1
fi

echo "$reward" > /logs/verifier/reward.txt
echo "reward=$reward"