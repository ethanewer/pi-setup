#!/usr/bin/env python3
"""sealctl — the appliance sealing tool (root-owned; the ONLY binary the ops
account may run through sudo)."""
import grp
import hashlib
import os
import pwd
import re
import sys

VAULT = "/var/lib/sealvault"
OPS_GROUP = "opscrew"


def fail(msg, code=2):
    print("sealctl: %s" % msg, file=sys.stderr)
    sys.exit(code)


def journal(line):
    path = os.path.join(VAULT, ".journal")
    sudo_user = os.environ.get("SUDO_USER", "-")
    with open(path, "a") as fh:
        fh.write("%s sudo_user=%s\n" % (line, sudo_user))
    os.chmod(path, 0o600)
    os.chown(path, 0, 0)


def ensure_vault():
    if not os.path.isdir(VAULT):
        os.makedirs(VAULT)
        os.chmod(VAULT, 0o700)
        os.chown(VAULT, 0, 0)


def main():
    if len(sys.argv) < 2:
        fail("usage: sealctl <seal|prune|list|verify> ...")
    cmd = sys.argv[1]
    ensure_vault()

    if cmd == "seal":
        if len(sys.argv) != 4:
            fail("seal takes exactly <name> <value>")
        name, value = sys.argv[2], sys.argv[3]
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,31}", name):
            fail("bad seal name %r" % name)
        if not re.fullmatch(r"[0-9a-f]{4}", value):
            fail("bad seal value %r" % value)
        body = (
            "sealctl v3\n"
            "name=%s\n"
            "value=%s\n"
            "checksum=%s\n"
            % (name, value, hashlib.sha256(("%s=%s" % (name, value)).encode()).hexdigest()[:16])
        )
        path = os.path.join(VAULT, name + ".seal")
        with open(path, "w") as fh:
            fh.write(body)
        os.chmod(path, 0o640)
        os.chown(path, 0, grp.getgrnam(OPS_GROUP).gr_gid)
        journal("sealed %s value=%s" % (name, value))
        print("sealed %s" % name)

    elif cmd == "prune":
        keep = set(sys.argv[2:])
        removed = []
        for fn in sorted(os.listdir(VAULT)):
            if fn.endswith(".seal") and fn[: -len(".seal")] not in keep:
                os.remove(os.path.join(VAULT, fn))
                removed.append(fn[: -len(".seal")])
        journal("pruned kept=%s removed=%s" % (",".join(sorted(keep)) or "-", ",".join(sorted(removed)) or "-"))
        print("pruned (kept: %s)" % (", ".join(sorted(keep)) or "none"))

    elif cmd == "list":
        names = sorted(fn[: -len(".seal")] for fn in os.listdir(VAULT) if fn.endswith(".seal"))
        for n in names:
            print(n)
        journal("listed")

    elif cmd == "verify":
        if len(sys.argv) != 3:
            fail("verify takes exactly <name>")
        name = sys.argv[2]
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,31}", name):
            fail("bad seal name %r" % name)
        path = os.path.join(VAULT, name + ".seal")
        try:
            with open(path) as fh:
                body = fh.read()
        except OSError:
            print("BAD")
            sys.exit(3)
        m = dict(
            line.split("=", 1)
            for line in body.splitlines()
            if "=" in line
        )
        want = hashlib.sha256(("%s=%s" % (name, m.get("value", ""))).encode()).hexdigest()[:16]
        if m.get("name") == name and m.get("checksum") == want:
            print("OK")
        else:
            print("BAD")
            sys.exit(3)

    else:
        fail("unknown subcommand %r" % cmd)


if __name__ == "__main__":
    main()
