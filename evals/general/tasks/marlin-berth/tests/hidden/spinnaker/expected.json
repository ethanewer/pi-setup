{
  "map_path": "/etc/postfix/virtual_lists",
  "map": {
    "bosun-notes@lists.tidehead.net": "storekeeper",
    "chandlery@lists.tidehead.net": "supply@chandlery.example",
    "quartermaster@lists.tidehead.net": "storekeeper"
  },
  "aliases": {
    "bosun-notes": "storekeeper",
    "quartermaster": "storekeeper"
  },
  "accounts": ["storekeeper"],
  "report": {
    "map_path": "/etc/postfix/virtual_lists",
    "lists": [
      {"address": "bosun-notes@lists.tidehead.net", "target": "storekeeper", "kind": "local"},
      {"address": "chandlery@lists.tidehead.net", "target": "supply@chandlery.example", "kind": "external"},
      {"address": "quartermaster@lists.tidehead.net", "target": "storekeeper", "kind": "local"}
    ]
  }
}
