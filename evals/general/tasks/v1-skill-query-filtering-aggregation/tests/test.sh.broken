#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/report.json ]; then
  if python3 - <<'PY'
import json, collections, sys
tot=collections.defaultdict(int)
with open('/app/transactions.tsv') as f:
    lines=f.read().splitlines()
    for line in lines[1:]:
        p=line.split('\t')
        if p[3]=='active':
            tot[p[1]]+=int(p[2])
expected={k:tot[k] for k in sorted(tot)}
try:
    got=json.load(open('/app/report.json'))
except Exception as e:
    print("invalid json", e); sys.exit(1)
if got==expected:
    print("PASS"); sys.exit(0)
print("FAIL got=%r exp=%r"%(got,expected)); sys.exit(1)
PY
  then
    reward=1
  fi
  then reward=1; fi
fi
echo "$reward" > /logs/verifier/reward.txt
