cmake_minimum_required(VERSION 3.16)
project(ring_math C)

set(SOURCES src/alpha.c src/beta.c src/gamma.c)

file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/bc")

# Emit LLVM IR (bitcode) for EVERY translation unit, then link them all into a
# single byte-artifact unified.bc exposing the whole project's symbols.
set(BC_FILES "")
foreach(_src IN LISTS SOURCES)
  get_filename_component(_base "${_src}" NAME_WE)
  set(_bcf "${CMAKE_CURRENT_BINARY_DIR}/bc/${_base}.bc")
  add_custom_command(
    OUTPUT "${_bcf}"
    COMMAND clang -std=c11 -emit-llvm -c "${CMAKE_CURRENT_SOURCE_DIR}/${_src}"
            -o "${_bcf}"
    DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${_src}")
  list(APPEND BC_FILES "${_bcf}")
endforeach()

set(UNIFIED "${CMAKE_CURRENT_BINARY_DIR}/bc/unified.bc")
add_custom_command(
  OUTPUT "${UNIFIED}"
  COMMAND llvm-link ${BC_FILES} -o "${UNIFIED}"
  DEPENDS ${BC_FILES})

add_custom_target(ring_ir ALL DEPENDS "${UNIFIED}")