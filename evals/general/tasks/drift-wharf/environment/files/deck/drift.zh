/* drift.zh - Zephyr drift stream decoder.
 * Reads a drift stream on stdin, writes decoded payload bytes to stdout.
 * Frame grammar (identical semantics for encoder and verifier):
 *   each frame begins with control byte h:
 *     h & 0x80 == 0 : LITERAL - n=(h&0x7F)+1, next n bytes copied verbatim.
 *     h & 0x80 != 0 : RLE      - rep=(h&0x7F)+1, next single byte emitted rep times.
 */
byte ZBUF[200000];

int main(){
    int len = read_all(ZBUF);
    int i = 0;
    if (len < 0) { len = 0; }
    while (i < len)
    {
        int h = ZBUF[i];
        i = i + 1;
        if ((h & 0x80) == 0)
        {
            int n = (h & 0x7F) + 1;
            int j = 0;
            while (j < n)
            {
                out(ZBUF[i]);
                i = i + 1;
                j = j + 1;
            }
        }
        else
        {
            int rep = (h & 0x7F) + 1;
            int v = ZBUF[i];
            i = i + 1;
            int k = 0;
            while (k < rep)
            {
                out(v);
                k = k + 1;
            }
        }
    }
    return 0;
}