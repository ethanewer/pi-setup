#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/eig.json ]; then
  if python3 - <<'PYEOF'
import json, sys
import numpy as np

def load(path):
    data = json.load(open(path))
    return np.array([[complex(r['re'], r['im']) for r in row] for row in data])

A = load('/app/matrix.json')
eref, Vref = np.linalg.eig(A)
Vref = Vref / np.linalg.norm(Vref, axis=0, keepdims=True)
ref_sorted = sorted(eref, key=lambda z: (z.real, abs(z.imag), z.imag))

try:
    got = json.load(open('/app/eig.json'))
except Exception:
    sys.exit('bad json')
ev = [complex(e['re'], e['im']) for e in got.get('eigenvalues', [])]
vecs = [[complex(c['re'], c['im']) for c in row] for row in got.get('eigenvectors', [])]
if len(ev) != 6 or len(vecs) != 6:
    sys.exit('shape mismatch')
for i in range(6):
    if len(vecs[i]) != 6:
        sys.exit('vec shape mismatch')
V = np.array(vecs, dtype=complex).T  # columns
# unit norm
for j in range(6):
    n = np.linalg.norm(V[:, j])
    if abs(n - 1.0) > 1e-4:
        sys.exit('not unit norm col '+str(j))
# residual
for j in range(6):
    r = np.linalg.norm(A @ V[:, j] - ev[j] * V[:, j])
    if r > 1e-6:
        sys.exit('residual fail col '+str(j))
# eigenvalue multiset match
got_sorted = sorted(ev, key=lambda z: (z.real, abs(z.imag), z.imag))
for a, b in zip(got_sorted, ref_sorted):
    if abs(a - b) > 1e-7:
        sys.exit('eigenvalue mismatch')
sys.exit(0)
PYEOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt