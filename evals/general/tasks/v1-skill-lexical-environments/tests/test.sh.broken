#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/answer.json ]; then
  if python3 - <<'EOF'
import json, sys
exp={"output":[11,16,19]}
got=json.load(open('/app/answer.json'))
o=got.get("output")
if not isinstance(o,list) or [float(x) for x in o] != exp["output"]:
    sys.exit("bad output")
sys.exit(0)
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt