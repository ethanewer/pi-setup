#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/cannot_reach.json ]; then
  if python3 - <<'EOF'
import json,sys
g=json.load(open('/app/graph.json'))
nodes=g['nodes']; edges=g['edges']; target=g['target']
def reaches(n):
    seen=set(); stack=[n]
    while stack:
        cur=stack.pop()
        if cur==target: return True
        if cur in seen: continue
        seen.add(cur)
        for nxt in edges.get(cur,[]): stack.append(nxt)
    return False
cannot=[n for n in nodes if n!=target and not reaches(n)]
got=json.load(open('/app/cannot_reach.json'))
if got.get('cannot_reach_target') != cannot: sys.exit("mismatch")
sys.exit(0)
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt