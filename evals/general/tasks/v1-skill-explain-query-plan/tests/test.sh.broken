#!/bin/bash
reward=0
if [ -f /app/plan.json ]; then
  if python3 - <<'PYEOF'
import sqlite3, json, re, sys
con = sqlite3.connect('/app/sales.db')
cur = con.cursor()
cur.execute("EXPLAIN QUERY PLAN SELECT * FROM sales WHERE region = 'East'")
plan = [r[3] for r in cur.fetchall()]
uses_index = any('USING INDEX' in d for d in plan)
idx = None
for d in plan:
    m = re.search(r'USING INDEX\s+(\S+)', d)
    if m:
        idx = m.group(1).rstrip('(')
        break
expected = {'uses_index': uses_index, 'index_name': idx, 'plan': plan}
got = json.load(open('/app/plan.json'))
assert got == expected, (got, expected)
assert got['uses_index'] is True or got['uses_index'] == True
PYEOF
  then
    reward=1
  fi

  then reward=1; else reward=0; fi
else reward=0; fi
echo "$reward" > /logs/verifier/reward.txt