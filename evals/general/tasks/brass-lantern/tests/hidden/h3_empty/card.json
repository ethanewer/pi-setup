{
  "model_name": "pipistrelle-nano",
  "arch": "causal_decoder",
  "modules": [
    {
      "name": "tok_embeddings",
      "type": "Embedding"
    },
    {
      "name": "blocks.0.attn.conv",
      "type": "Conv1D",
      "trainable": false
    },
    {
      "name": "blocks.0.norm",
      "type": "LayerNorm"
    },
    {
      "name": "norm",
      "type": "LayerNorm"
    },
    {
      "name": "output",
      "type": "Linear",
      "head": true
    }
  ],
  "lora": {
    "r": 2,
    "lora_alpha": 4,
    "lora_dropout": 0.03
  }
}
