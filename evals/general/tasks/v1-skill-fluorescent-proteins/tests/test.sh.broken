#!/bin/bash
mkdir -p /logs/verifier

reward=0
if [ -f /app/result.json ]; then
  if python3 - <<'EOF'
import json, csv
target = int(open('/app/query.txt').read().strip())
with open('/app/proteins.csv') as f:
    rows = list(csv.DictReader(f))

best_name = None; best = None
for r in rows:
    pe = int(r['peak_emission']); d = abs(pe - target)
    if best is None or d < best:
        best = d; best_name = r['name']

expected = {"name": best_name, "peak_emission": int(next(x['peak_emission'] for x in rows if x['name']==best_name))}

with open('/app/result.json') as f:
    got = json.load(f)
assert got == expected, (got, expected)
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt