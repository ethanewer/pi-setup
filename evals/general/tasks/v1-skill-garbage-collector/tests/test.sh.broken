#!/bin/bash
mkdir -p /logs/verifier

reward=0
if [ -f /app/collected.json ]; then
  if python3 - <<'EOF'
import json
heap = json.load(open('/app/heap.json'))
roots = heap['roots']; objects = heap['objects']

marked = set(roots); stack = list(roots)
while stack:
    cur = stack.pop()
    for nxt in objects.get(cur, []):
        if nxt not in marked:
            marked.add(nxt); stack.append(nxt)

expected = sorted(o for o in objects if o not in marked)
out = json.load(open('/app/collected.json'))
assert out == expected, (out, expected)
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt