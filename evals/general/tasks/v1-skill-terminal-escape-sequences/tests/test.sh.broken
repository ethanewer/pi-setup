#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/clean.json ]; then
  if python3 - <<'PYEOF'
import json, re, sys

strip = re.compile(r'\x1b\[[0-9;]*[A-Za-z]')
with open('/app/log.txt', 'r', encoding='utf-8') as f:
    raw = f.read().splitlines()
lines = []
counts = {}
for ln in raw:
    clean = strip.sub('', ln).strip('\r')
    if ':' not in clean:
        continue
    level, _, message = clean.partition(':')
    lines.append({'level': level, 'message': message})
    counts[level] = counts.get(level, 0) + 1

try:
    got = json.load(open('/app/clean.json'))
except Exception:
    sys.exit('bad json')

gl = got.get('lines', [])
gc = got.get('level_counts', {})
if gl != lines:
    sys.exit('lines mismatch')
if gc != counts:
    sys.exit('counts mismatch')
sys.exit(0)
PYEOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt