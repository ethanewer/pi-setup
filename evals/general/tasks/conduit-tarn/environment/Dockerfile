FROM bench-base:python-3.12

# Thread pools pinned to the single declared CPU (no numeric libs used, but the
# standard block costs nothing and keeps the environment uniform).
ENV OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1

RUN pip install --no-cache-dir pytest==9.1.1

# The repository below is generated by gen_repo.py during this build, so it is
# root-owned; make it usable by whichever user the harness picks at trial time,
# and give the build-time (and later agent-time) commits a committer identity.
RUN git config --system --add safe.directory '*' \
 && git config --system user.email build@localhost \
 && git config --system user.name build

WORKDIR /app

COPY files/ /app/

RUN python3 /app/gen_repo.py && rm -f /app/gen_repo.py