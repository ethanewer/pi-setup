#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/queue.json ]; then
  if python3 - <<'PY'
import json, sys
jobs=[]
for line in open('/app/jobs.txt'):
    line=line.strip()
    if not line or line.startswith('#'): continue
    jid,arr,bur=line.split('\t')
    jobs.append((jid,int(arr),int(bur)))
order=sorted(enumerate(jobs), key=lambda t:(t[1][1], t[0]))
time=0; waits=[]
for idx,(jid,arr,bur) in order:
    start=max(time,arr)
    comp=start+bur
    waits.append(start-arr)
    time=comp
exp={"jobs": len(jobs), "avg_wait": round(sum(waits)/len(waits),12), "completion_time": time}
try:
    got=json.load(open('/app/queue.json'))
    ok = (got.get('jobs')==exp['jobs'] and abs(got.get('avg_wait',-1)-exp['avg_wait'])<1e-6 and got.get('completion_time')==exp['completion_time'])
except Exception as e:
    print("err",e); sys.exit(1)
if ok:
    print("PASS"); sys.exit(0)
print("FAIL got=%r exp=%r"%(got,exp)); sys.exit(1)
PY
  then
    reward=1
  fi
  then reward=1; fi
fi
echo "$reward" > /logs/verifier/reward.txt
