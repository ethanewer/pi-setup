#!/bin/bash

reward=0
if [ -f /app/review_summary.json ]; then
  if python3 - <<'EOF'
import json

with open("/app/review_summary.json") as f:
    r = json.load(f)

expected = {
    "Cafe A": 4.0,
    "Cafe B": 3.0,
    "Cafe C": 5.0,
}
per = r.get("per_business", {})
for biz, val in expected.items():
    assert abs(per.get(biz, -1) - val) < 1e-9, (biz, per)
assert r.get("total_reviews") == 5, r
assert abs(r.get("overall_average", -1) - 3.8) < 1e-9, r
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt