{
  "busybox_source": "/bin/busybox",
  "busybox_dest": "/bin/busybox",
  "applet_links": ["/bin/sh", "/bin/echo", "/bin/cat", "/bin/ls", "/bin/mount", "/bin/sleep", "/bin/ps", "/bin/true"],
  "device_nodes": [
    {"path": "/dev/null", "type": "c", "major": 1, "minor": 3},
    {"path": "/dev/zero", "type": "c", "major": 1, "minor": 5},
    {"path": "/dev/console", "type": "c", "major": 5, "minor": 1},
    {"path": "/dev/ttyS0", "type": "c", "major": 4, "minor": 64},
    {"path": "/dev/fb0", "type": "c", "major": 29, "minor": 0}
  ],
  "directory_roots": ["/proc", "/sys", "/dev", "/tmp", "/kiosk/spool"],
  "init": {
    "mount_steps": ["mount -t proc proc /proc", "mount -t sysfs sysfs /sys"],
    "banner": "FERRITE-KIOSK-LIVE",
    "exec_shell": "/bin/sh"
  }
}
