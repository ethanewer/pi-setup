#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/shard.json ]; then
  if python3 - <<'EOF'
import json,sys
data=json.load(open('/app/layers.json'))
got=json.load(open('/app/shard.json'))
for L in data['layers']:
    w=L['weights']; tiles=L['num_tiles']; t=L['tile_id']
    if L['kind']=='column-parallel':
        per=L['out_features']//tiles
        shard=[row[t*per:(t+1)*per] for row in w]
    else:
        per=L['in_features']//tiles
        shard=w[t*per:(t+1)*per]
    e=got.get(L['name'])
    if not e or e.get('shard')!=shard: sys.exit("mismatch %s"%L['name'])
sys.exit(0)
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt