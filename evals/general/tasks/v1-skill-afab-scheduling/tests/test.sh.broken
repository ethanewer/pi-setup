#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/fab_jobs.json ] && [ -f /app/schedule.json ]; then
  if python3 - <<'EOF'
import json, sys
jobs=json.load(open('/app/fab_jobs.json'))
sched=json.load(open('/app/schedule.json'))
def feasible(jobs, sched):
    machine_intervals={}
    for job in jobs:
        steps=jobs[job]
        entry=sched.get(job)
        if not isinstance(entry, list): return False
        starts={int(s['step']): (s['start'], steps[int(s['step'])]) for s in entry if isinstance(s,dict) and 'step' in s and 'start' in s}
        prev_end=0
        for i,op in enumerate(steps):
            m=op['machine']; dur=float(op['duration'])
            if i not in starts: return False
            st=float(starts[i][0])
            if st < 0 or st < prev_end: return False
            end=st+dur
            prev_end=end
            iv=machine_intervals.setdefault(m,[])
            for (a,b) in iv:
                if not (end <= a or b <= st): return False
            iv.append((st,end))
    return True
if feasible(jobs, sched):
    sys.exit(0)
sys.exit('schedule not feasible')
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt