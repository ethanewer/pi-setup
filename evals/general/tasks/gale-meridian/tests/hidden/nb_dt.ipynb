   "source": "library(data.table)\ndt <- data.table(k = c(\"x\", \"y\", \"x\", \"y\", \"x\", \"z\"),\n                 v = c(10L, -4L, 6L, 0L, 2L, 7L))\nagg <- dt[, .(s = sum(v), n = .N), by = k][order(k)]\ncat(\"RCW_DT_OK\\n\")\nfor (i in seq_len(nrow(agg))) cat(sprintf(\"ROW %s %d %d\\n\", agg$k[i], agg$s[i], agg$n[i]))\n"
  }
