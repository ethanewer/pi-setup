#!/bin/bash
reward=0
if [ -f /app/carved.png ] && [ -f /app/carved.json ]; then
  if python3 - <<'PYEOF'
import json
blob = open('/app/blob.bin', 'rb').read()
sig = b'\x89PNG\r\n\x1a\n'
start = blob.index(sig)
iend = blob.index(b'IEND')
end = iend + 8
expected = blob[start:end]
got = open('/app/carved.png', 'rb').read()
assert got == expected, (len(got), len(expected))
assert got[:8] == sig
# carved PNG must end right after the IEND chunk CRC (i.e. ends with the 4-byte CRC following "IEND")
assert got[-8:-4] == b'IEND'
# and the chunk immediately before "IEND" is the 4-byte length 0
assert got[-12:-8] == b'\x00\x00\x00\x00'
# trailing bytes must NOT be part of the carved file
assert got != blob[:end + 1], 'carved file must end at the PNG boundary'
j = json.load(open('/app/carved.json'))
assert j['offset'] == start, (j, start)
assert j['length'] == len(expected), (j, len(expected))
assert j['valid_ending'] is True
PYEOF
  then
    reward=1
  fi
  then reward=1; else reward=0; fi
else reward=0; fi
echo "$reward" > /logs/verifier/reward.txt