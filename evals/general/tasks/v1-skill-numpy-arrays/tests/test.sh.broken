#!/bin/bash
# Verifier for skill-numpy-arrays.
mkdir -p /logs/verifier
reward=0

if [ -f /app/stats.json ]; then
  if python3 - <<'PYEOF'
import json
import numpy as np

arr = np.loadtxt('/app/scores.txt', dtype=int)
exp = {
    'count_gt15': int((arr > 15).sum()),
    'idx_div3': np.where(arr % 3 == 0)[0].tolist(),
    'mean_gt10': round(float(arr[arr > 10].mean()), 2),
    'max_val': int(arr.max()),
}
got = json.load(open('/app/stats.json'))
assert set(got.keys()) == set(exp.keys()), (got.keys(), exp.keys())
assert got['count_gt15'] == exp['count_gt15'], (got, exp)
assert got['idx_div3'] == exp['idx_div3'], (got, exp)
assert abs(got['mean_gt10'] - exp['mean_gt10']) < 0.005, (got, exp)
assert got['max_val'] == exp['max_val'], (got, exp)
PYEOF
  then
    reward=1
  fi

echo "$reward" > /logs/verifier/reward.txt
exit 0