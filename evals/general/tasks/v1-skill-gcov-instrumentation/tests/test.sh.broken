#!/bin/bash
mkdir -p /logs/verifier

reward=0
# Re-derive the deterministically-computed coverage from a fresh build.
rm -rf /tmp/gcovtest && mkdir -p /tmp/gcovtest
cp /app/program.c /tmp/gcovtest/
(
  cd /tmp/gcovtest
  gcc -fprofile-arcs program.c -o prog.bin 2>/dev/null
  ./prog.bin >/dev/null 2>&1
  gcov program.c >/dev/null 2>&1
)

if [ -f /app/coverage.json ] && [ -f /tmp/gcovtest/program.c.gcov ]; then
  if python3 - <<'EOF'
import re, json
text = open('/tmp/gcovtest/program.c.gcov').read()
m = re.search(r'Lines executed:([0-9.]+)% of ([0-9]+)', text)
assert m, 'no coverage summary in fresh gcov'
expected = round(float(m.group(1)), 1)

out = json.load(open('/app/coverage.json'))
assert isinstance(out['coverage_percent'], (int, float))
assert abs(out['coverage_percent'] - expected) < 0.06, (out, expected)
assert out['coverage_percent'] < 100.0 - 1e-9, out
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt