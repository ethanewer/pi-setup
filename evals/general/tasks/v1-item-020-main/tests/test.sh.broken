#!/bin/bash
# Verifier for item-020-main: recompute expected KLs from /app/input.json and
# compare to the agent's /app/result.json.
mkdir -p /logs/verifier
reward=0

if [ -f /app/result.json ]; then
  if python3 - <<'PY'
import json
import numpy as np

d = json.load(open("/app/input.json"))
res = json.load(open("/app/result.json"))
D = int(d["D"])
eps = 1e-9
counts = np.array(d["counts"], dtype=np.float64)
target_q = np.array(d["target_q"], dtype=np.float64)
p = (counts + eps) / (counts.sum() + D * eps)
q = (target_q + eps) / (target_q.sum() + D * eps)
exp_fwd = float(np.sum(p * (np.log(p) - np.log(q))))
exp_rev = float(np.sum(q * (np.log(q) - np.log(p))))

assert abs(res["p_sum"] - 1.0) <= 1e-6, res["p_sum"]
assert abs(res["q_sum"] - 1.0) <= 1e-6, res["q_sum"]
assert abs(res["forward_kl"] - exp_fwd) <= 1e-3, (res["forward_kl"], exp_fwd)
assert abs(res["reverse_kl"] - exp_rev) <= 1e-3, (res["reverse_kl"], exp_rev)
PY && reward=1
fi

echo "$reward" > /logs/verifier/reward.txt
echo "reward=$reward"