# tl-crown-pareto — multi-objective evolutionary optimization (NSGA-II).
#
# Ships two deterministic problem families (bounded knapsack, continuous
# two- and three-objective problems with closed-form Pareto fronts) plus a
# visible params file. The agent authors the NSGA-II CLI /app/nsga.py with
# only the Python standard library.

FROM bench-base:python-3.12

COPY files/ /app/

WORKDIR /app