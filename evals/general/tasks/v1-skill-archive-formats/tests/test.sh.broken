#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/arc_a.tar ] && [ -f /app/formats.json ]; then
  if python3 - <<'EOF'
import json, sys
def detect(p):
    b=open(p,'rb').read(600)
    if len(b)>=4 and b[0:4]==b'PK\x03\x04':
        return 'zip'
    if len(b)>=2 and b[0]==0x1f and b[1]==0x8b:
        return 'gz'
    if len(b)>=263 and b[257:262]==b'ustar':
        return 'tar'
    raise SystemExit("unknown magic %r"%b[:8])
files=["/app/arc_a.tar","/app/arc_b.zip","/app/arc_c.gz"]
exp={p:detect(p) for p in files}
got=json.load(open('/app/formats.json'))
if set(got.keys())!=set(files):
    sys.exit("wrong file set %r" % (sorted(got.keys()),))
for p in files:
    if str(got.get(p,'')).strip()!=exp[p]:
        sys.exit("mismatch %s: got %r want %r" % (p,got.get(p),exp[p]))
sys.exit(0)
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt