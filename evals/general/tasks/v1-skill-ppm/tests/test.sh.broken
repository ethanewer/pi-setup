#!/bin/bash
mkdir -p /logs/verifier
APP="${TASK_APP:-/app}"
reward=0
if [ -f "$APP/img.ppm" ]; then
  if /usr/bin/env python3 - "$APP/img.ppm" <<'PY'
import sys
path = sys.argv[1]
def load(path):
    toks = []
    for line in open(path):
        line = line.split('#', 1)[0].strip()
        if line:
            toks += line.split()
    return toks
try:
    toks = load(path)
    if len(toks) < 4:
        sys.exit(1)
    if toks[0] != 'P3':
        sys.exit(1)
    w, h, mx = int(toks[1]), int(toks[2]), int(toks[3])
    vals = [int(x) for x in toks[4:4+w*h*3]]
except Exception:
    sys.exit(1)
if not (w == 6 and h == 4 and mx == 255):
    sys.exit(1)
EXPECTED = [[(255,0,0)]*6, [(255,0,0)]*6, [(0,0,255)]*6, [(0,0,255)]*6]
idx = 0
for y in range(4):
    for x in range(6):
        r, g, b = vals[idx], vals[idx+1], vals[idx+2]
        idx += 3
        if (r, g, b) != EXPECTED[y][x]:
            sys.exit(1)
sys.exit(0)
PY && reward=1
fi
fi
printf '%s' "$reward" > /logs/verifier/reward.txt