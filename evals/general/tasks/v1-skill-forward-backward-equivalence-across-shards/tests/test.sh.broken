#!/bin/bash
mkdir -p /logs/verifier

reward=0
if [ -f /app/forward_check.json ]; then
  if python3 - <<'EOF'
import json
import math
import numpy as np

x = np.array(json.load(open('/app/input.json'))['x'])
sa = json.load(open('/app/shard_a.json'))
sb = json.load(open('/app/shard_b.json'))
W1 = np.array(sa['W1']); b1 = np.array(sa['b1'])
W2 = np.array(sb['W2']); b2 = np.array(sb['b2'])

h = W1 @ x + b1
y_layer = W2 @ h + b2
Wc = W2 @ W1
bc = b2 + W2 @ b1
y_composed = Wc @ x + bc
md = float(np.max(np.abs(y_layer - y_composed)))

out = json.load(open('/app/forward_check.json'))
assert out == {
    "y_layer": [round(float(v), 4) for v in y_layer],
    "y_composed": [round(float(v), 4) for v in y_composed],
    "max_diff": round(md, 6),
}, (out, y_layer, y_composed, md)
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt