{
  "schema": "meridian-cleanup-policy/v1",
  "host": "relay-farm",
  "budget_bytes": 5242880,
  "retention_manifest": "RESTORE.manifest",
  "junk": {
    "suffixes": [
      ".log",
      ".tmp",
      ".pid",
      ".sqlite-journal"
    ],
    "dir_names": [
      "junk",
      ".cache"
    ],
    "prefixes": [
      "core.",
      ".nfs",
      "~$"
    ],
    "min_size_bytes": 0
  }
}
