#!/bin/bash
reward=0
if [ -f /app/tree.json ]; then
  if python3 - <<'PYEOF'
import os, json
root = '/app/tree'
dirs = files = total = lf = lb = 0
for base, dirnames, filenames in os.walk(root):
    dirs += len(dirnames)
    for fn in filenames:
        files += 1
        sz = os.path.getsize(os.path.join(base, fn))
        total += sz
        if fn.endswith('.log'):
            lf += 1
            lb += sz
expected = {'dirs': dirs, 'files': files, 'total_bytes': total,
            'log_files': lf, 'log_bytes': lb}
got = json.load(open('/app/tree.json'))
assert got == expected, (got, expected)
PYEOF
  then
    reward=1
  fi
  then reward=1; else reward=0; fi
else reward=0; fi
echo "$reward" > /logs/verifier/reward.txt