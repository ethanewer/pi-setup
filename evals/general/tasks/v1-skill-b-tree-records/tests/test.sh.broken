#!/bin/bash
reward=0
if [ -f /app/sorted_keys.txt ]; then
  if python3 - <<'PYEOF'
import json
with open('/app/btree.json') as f:
    tree = json.load(f)
def inorder(node, out):
    if node.get('children'):
        m = len(node['keys'])
        for i in range(m):
            inorder(node['children'][i], out)
            out.append(node['keys'][i])
        inorder(node['children'][m], out)
    else:
        out.extend(node['keys'])
exp = []
inorder(tree['root'], exp)
got = [int(x) for x in open('/app/sorted_keys.txt').read().split()]
assert got == exp, ('mismatch', got, exp)
PYEOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt
