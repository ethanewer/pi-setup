<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  Sorrel Quay single-node cluster: core site configuration.

  UNCONFIGURED: fill in the designated values before the cluster can come up.
    - fs.defaultFS     the cluster's default filesystem URI (namenode RPC)
    - hadoop.tmp.dir   the cluster's scratch directory
-->
<configuration>
  <property>
    <name>fs.defaultFS</name>
    <value></value>
  </property>
  <property>
    <name>hadoop.tmp.dir</name>
    <value></value>
  </property>
</configuration>
