<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  Sorrel Quay single-node cluster: HDFS site configuration.

  UNCONFIGURED: fill in the designated values before the cluster can come up.
    - dfs.replication             single-node cluster replication factor
    - dfs.namenode.http-address   namenode web UI endpoint
    - dfs.datanode.address        datanode RPC endpoint
    - dfs.namenode.name.dir       namenode storage directory
    - dfs.datanode.data.dir       datanode storage directory
-->
<configuration>
  <property>
    <name>dfs.replication</name>
    <value></value>
  </property>
  <property>
    <name>dfs.namenode.http-address</name>
    <value></value>
  </property>
  <property>
    <name>dfs.datanode.address</name>
    <value></value>
  </property>
  <property>
    <name>dfs.namenode.name.dir</name>
    <value></value>
  </property>
  <property>
    <name>dfs.datanode.data.dir</name>
    <value></value>
  </property>
</configuration>
