#!/bin/bash
reward=0
if [ -f /app/bench.json ]; then
  if python3 - <<'PYEOF'
import json, time, sys
sys.path.insert(0, '/app')
from candidates import impl_a, impl_b
n = 5000000
reps = 10
def bench(fn):
    best = float('inf')
    for _ in range(reps):
        t0 = time.perf_counter(); fn(n); best = min(best, time.perf_counter()-t0)
    return best
ta = bench(impl_a); tb = bench(impl_b)
expected = 'A' if ta > tb else 'B'
try:
    got = json.load(open('/app/bench.json'))
    assert isinstance(got, dict)
    assert got['winner_slower'] == expected, (got['winner_slower'], expected)
    _ = float(got['time_a_sec'])
    _ = float(got['time_b_sec'])
    _ = int(got['reps'])
except Exception as e:
    raise SystemExit('check failed: %s' % e)
PYEOF
  then
    reward=1
  fi
  then reward=1; fi
else
  reward=0
fi
echo "$reward" > /logs/verifier/reward.txt
