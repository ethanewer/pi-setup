#!/bin/bash

mkdir -p /logs/verifier

reward=0

behav_ok=0
if [ -f /app/dispatcher.py ] && python3 - <<'PYEOF'
import asyncio, sys
sys.path.insert(0, "/app")
from dispatcher import Dispatcher

def run(coro):
    return asyncio.run(coro)

def job(state, n, delay=0.02, fail=False):
    async def _do():
        state["cur"] += 1
        state["peak"] = max(state["peak"], state["cur"])
        try:
            await asyncio.sleep(delay)
            if fail:
                raise RuntimeError(f"job {n} failed")
            return n * 10
        finally:
            state["cur"] -= 1
    return _do()

# Cap, ordering, lease exactness, never negative -- repeated (race-sensitive).
for limit in (1, 2, 3, 4, 8):
    for _ in range(6):
        d = Dispatcher(limit)
        st = {"cur": 0, "peak": 0}
        n = limit * 3
        res = run(d.dispatch([job(st, i) for i in range(n)]))
        assert res == [i * 10 for i in range(n)]
        assert st["peak"] <= limit, (limit, st["peak"])
        assert d.leases.live == 0, (limit, d.leases.live)
        assert st["cur"] == 0

# failure path: exact accounting, never negative
for limit in (1, 2, 4):
    for _ in range(6):
        d = Dispatcher(limit)
        st = {"cur": 0, "peak": 0}
        n = limit * 3
        jobs = [job(st, i, fail=(i == 2 * limit)) for i in range(n)]
        try:
            run(d.dispatch(jobs))
            raise AssertionError("expected failure")
        except RuntimeError:
            pass
        assert d.leases.live == 0, (limit, d.leases.live)
        assert d.leases.live >= 0
        assert st["cur"] == 0

# cancellation path: repeated, exact, non-negative
for limit in (1, 2, 4):
    for _ in range(8):
        async def scenario():
            d = Dispatcher(limit)
            st = {"cur": 0, "peak": 0}
            n = limit * 3
            jobs = [job(st, i, delay=0.5) for i in range(n)]
            runner = asyncio.create_task(d.dispatch(jobs))
            await asyncio.sleep(0.02)
            runner.cancel()
            try:
                await runner
                raise AssertionError("should have been cancelled")
            except asyncio.CancelledError:
                pass
            return d.leases.live, st["cur"]
        live, cur = run(scenario())
        assert (live, cur) == (0, 0), (limit, live, cur)
        assert live >= 0

behav_ok = 1
PYEOF
then
  reward=1
fi
then
  behav_ok=1
fi

agent_ok=0
if [ -f /app/tests/test_behavior.py ] && [ -f /app/tests/test_contract.py ]; then
  if pytest -q /app/tests/ >/tmp/pytest_hard_out.txt 2>&1; then
    agent_ok=1
  fi
fi

if [ "$behav_ok" = "1" ] && [ "$agent_ok" = "1" ]; then
  reward=1
elif [ "$behav_ok" = "1" ]; then
  reward=0.5
else
  reward=0
fi

echo "$reward" > /logs/verifier/reward.txt