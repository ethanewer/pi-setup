<configuration>
  <!--
    MDS single-node site configuration.

    The bootstrap must set these to the cluster's designated values:
      - mds.address         the node listens on this IP
      - mds.rpc.port        the designated RPC port (primary role binds it)
      - mds.binding.primary/mds.binding.data/mds.binding.secondary
                            complementary role bindings (each must be non-empty)

    Placeholders below are UNCONFIGURED and must be filled in before the
    cluster can come up. Demonstrating daemons bind :port, :port+1, :port+2
    and the dependent gateway on :port+10.
  -->
  <property>
    <name>mds.address</name>
    <value></value>
  </property>
  <property>
    <name>mds.rpc.port</name>
    <value></value>
  </property>
  <property>
    <name>mds.binding.primary</name>
    <value></value>
  </property>
  <property>
    <name>mds.binding.data</name>
    <value></value>
  </property>
  <property>
    <name>mds.binding.secondary</name>
    <value></value>
  </property>
</configuration>