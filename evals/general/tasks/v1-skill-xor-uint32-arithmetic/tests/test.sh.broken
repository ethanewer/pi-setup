#!/bin/bash

reward=0
if [ -f /app/result.json ]; then
  if python3 - <<'EOF'
import json
with open("/app/data.json") as f:
    d = json.load(f)
with open("/app/result.json") as f:
    r = json.load(f)
a, b = d["a"], d["b"]
assert r.get("a") == a, r
assert r.get("b") == b, r
assert r.get("sum_wrapped") == (a + b) & 0xFFFFFFFF, r
assert r.get("xor") == (a ^ b), r
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt