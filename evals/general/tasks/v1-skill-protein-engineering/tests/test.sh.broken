#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/molecule.json ]; then
  if python3 - <<'PYEOF'
import json

residue_mass = {
    'A': 71.03711,
    'C': 103.00919,
    'E': 129.04259,
}
water_mass = 18.01056
peptide = 'ACE'
expected = sum(residue_mass[ch] for ch in peptide) + water_mass

with open('/app/molecule.json') as f:
    data = json.load(f)
assert data.get('peptide') == 'ACE', data
got = float(data['mass_da'])
assert abs(got - expected) < 1e-3, (got, expected)
PYEOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt