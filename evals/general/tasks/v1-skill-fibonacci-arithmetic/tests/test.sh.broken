#!/bin/bash
reward=0
if [ -f /app/fib.json ]; then
  if python3 - <<'PYEOF'
import json
from functools import lru_cache
MOD = 1_000_000_007
n = int(open('/app/n.txt').read().strip())
@lru_cache(maxsize=None)
def fib(k):
    if k == 0:
        return (0, 1)
    a, b = fib(k >> 1)
    c = (a * ((2 * b - a) % MOD)) % MOD
    d = (a * a + b * b) % MOD
    if k & 1:
        return (d, (c + d) % MOD)
    return (c, d)
exp = {'n': n, 'MOD': MOD, 'F_n': fib(n)[0], 'S_n': (fib(n + 2)[0] - 1) % MOD}
got = json.load(open('/app/fib.json'))
assert len(got) == 4, got
assert got['n'] == exp['n']
assert got['F_n'] == exp['F_n'], (got['F_n'], exp['F_n'])
assert got['S_n'] == exp['S_n'], (got['S_n'], exp['S_n'])
assert got['MOD'] == MOD
PYEOF
  then
    reward=1
  fi
  then reward=1; else reward=0; fi
else reward=0; fi
echo "$reward" > /logs/verifier/reward.txt