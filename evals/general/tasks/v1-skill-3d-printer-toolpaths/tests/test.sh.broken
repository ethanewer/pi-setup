#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/moves.gcode ] && [ -f /app/answer.json ]; then
  if python3 - <<'EOF'
import json, math, re, sys
src=open('/app/moves.gcode').read()
pt_moves=[]
cur=None
for line in src.splitlines():
    line=line.split(';')[0].strip()
    if not line: continue
    m=re.match(r'^G([01])\s+X([-\d.]+)?\s+Y([-\d.]+)?\s', line)
    if not m:
        m=re.match(r'^G([01])\s+([-\d.]+)?\s+Y([-\d.]+)', line)
        if not m: continue
    code=m.group(1)
    try:
        x=float(m.group(2)); y=float(m.group(3))
    except (ValueError, TypeError):
        continue
    pt_moves.append((code,x,y))
# sum G1 segments; track position
prev=(0.0,0.0)
total=0.0
for code,x,y in pt_moves:
    if code=='1':
        d=math.hypot(x-prev[0], y-prev[1])
        total+=d
    prev=(x,y)
if abs(total-round(total))>1e-6:
    raise SystemExit("non-integer total: %r"%total)
exp=int(round(total))
got=json.load(open('/app/answer.json'))
if int(got.get('total_extruded_length')) != exp:
    raise SystemExit("mismatch: got %r expected %r"%(got.get('total_extruded_length'), exp))
sys.exit(0)
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt