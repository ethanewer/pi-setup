#!/bin/bash
reward=0
if [ -f /app/edges.json ]; then
  if python3 - <<'PYEOF'
import json, math
names = ['A','B','C','D']
raw = [ln.strip() for ln in open('/app/data.csv') if ln.strip()]
data = [[int(x) for x in ln.split(',')] for ln in raw[1:]]
N = len(data)
maxv = [0,0,0,0]
for r in data:
    for i in range(4):
        maxv[i]=max(maxv[i], r[i])
marg=[]
for i in range(4):
    cnt=[0]*(maxv[i]+1)
    for r in data: cnt[r[i]]+=1
    marg.append([x/float(N) for x in cnt])
def mutual(u,v):
    I=0.0
    for a in range(maxv[u]+1):
        for b in range(maxv[v]+1):
            n=sum(1 for r in data if r[u]==a and r[v]==b)
            pab=n/float(N)
            if pab>0:
                I+=pab*math.log2(pab/(marg[u][a]*marg[v][b]))
    return I
edges=[]
for u in range(4):
    for v in range(u+1,4):
        edges.append((names[u],names[v],mutual(u,v)))
edges=sorted(edges, key=lambda e:(-e[2],e[0],e[1]))
par={n:n for n in names}
def find(x):
    while par[x]!=x:
        par[x]=par[par[x]]; x=par[x]
    return x
tree=[]
for u,v,w in edges:
    ru,rv=find(u),find(v)
    if ru!=rv:
        par[ru]=rv; tree.append([u,v])
    if len(tree)==3: break
tree=sorted(tree, key=lambda e:(e[0],e[1]))
got=json.load(open('/app/edges.json'))
assert got==tree, (got, tree)
PYEOF
  then
    reward=1
  fi
  then reward=1; fi
fi
echo "$reward" > /logs/verifier/reward.txt
