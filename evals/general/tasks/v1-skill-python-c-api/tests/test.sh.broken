#!/bin/bash
mkdir -p /logs/verifier
reward=0

if [ -f /app/capi_result.txt ]; then
  if python3 - <<'PYEOF'
import sys
sys.path.insert(0, '/app')

# find the built .so in /app
import glob
so_files = glob.glob('/app/spam*.so')
assert len(so_files) >= 1, so_files

import spam
assert spam.add(30, 12) == 42, spam.add(30, 12)

got = open('/app/capi_result.txt').read().strip()
assert got == '42', got
PYEOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt