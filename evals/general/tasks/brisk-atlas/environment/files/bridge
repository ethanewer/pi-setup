#!/usr/bin/env bash
# brisk object-service bridge.
#
#   bridge scan <path>        -- print metadata for an object (safe, read-only)
#   bridge token <name>       -- mint a read-capability token (privileged)
#
# The sudo policy grants the *whole* bridge is aliased; the safe subcommand is
# "scan". Everything else, including "token", must only ever run elevated.
set -uo pipefail

cmd="${1:-scan}"
shift || true

case "$cmd" in
  scan)
    target="${1:-.}"
    stat -c 'scan %n size=%s' "$target" 2>/dev/null \
      || printf 'scan %s MISSING\n' "$target"
    ;;
  token)
    name="${1:-app}"
    gate=/var/lib/brk/rootgate
    mkdir -p "$gate" || exit 1
    printf 'token %s bxB9kQ' "$name" > "$gate/${name}.token"
    chmod 0600 "$gate/${name}.token"
    echo "minted ${name}"
    ;;
  *)
    echo "bridge: unknown subcommand '$cmd'" >&2
    exit 2
    ;;
esac