#!/bin/bash

reward=0
if [ -f /app/attention.json ]; then
  if python3 - <<'EOF'
import json
import math
import sys

sys.path.insert(0, "/app")
from attn_input import Q, K, V

with open("/app/attention.json") as f:
    got = json.load(f)

def softmax(seq):
    ex = [math.exp(x) for x in seq]
    s = sum(ex)
    return [x / s for x in ex]

dk = len(K[0])
eye = math.sqrt(dk)
scores = []
for qi in Q:
    row = [sum(qi[m] * kj[m] for m in range(dk)) / eye for kj in K]
    scores.append(softmax(row))

expected = []
for i in range(len(Q)):
    row = [0.0, 0.0, 0.0]
    for j in range(len(V)):
        for m in range(3):
            row[m] += scores[i][j] * V[j][m]
    expected.append(row)

assert len(got) == 3, "want 3 rows"
for i in range(3):
    for m in range(3):
        assert abs(got[i][m] - expected[i][m]) < 1e-5, (i, m, got[i][m], expected[i][m])
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt