{
  "expect": {
    "shell": {
      "display": "grid",
      "grid-template-columns": "repeat(12, 1fr)",
      "gap": "16px",
      "container-type": "inline-size"
    },
    "topbar": {
      "grid-column": "1 / -1"
    },
    "sidebar": {
      "grid-column": "span 4",
      "background": "#1e293b",
      "container-type": "inline-size"
    },
    "main": {
      "grid-column": "span 8"
    },
    "card-grid": {
      "container-type": "inline-size"
    },
    "card": {
      "grid-column": "span 3",
      "background": "#ffffff"
    },
    "stat": {
      "grid-column": "span 2",
      "background": "#e2e8f0"
    }
  }
}