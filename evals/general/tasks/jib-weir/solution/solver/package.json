{
  "name": "jib-weir-catalogue",
  "version": "1.0.0",
  "private": true,
  "description": "Catalogue REST API (Express 4 + zod, OpenAPI generated from zod schemas)",
  "scripts": {
    "build": "node_modules/.bin/tsc -p tsconfig.json",
    "generate:openapi": "node dist/scripts/generate-openapi.js",
    "start": "node dist/src/server.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "3.4.0",
    "express": "4.22.1",
    "zod": "3.25.75"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}