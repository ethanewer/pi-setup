#!/bin/bash
reward=0
if [ -f /app/parsed.json ]; then
  if python3 - <<'PYEOF'
import struct, json
data = open('/app/data.bin','rb').read()
N = struct.unpack('<I', data[4:8])[0]
s0=0; s1=0; x=0; off=8
for i in range(N):
    typ,val = struct.unpack_from('<Hi', data, off); off+=6
    if typ==0: s0+=val
    elif typ==1: s1+=val
    x^=val
got=json.load(open('/app/parsed.json'))
exp={'count':N,'sum_type0':s0,'sum_type1':s1,'xor_all':x}
assert got==exp, (got, exp)
PYEOF
  then
    reward=1
  fi
  then reward=1; fi
else reward=0; fi
echo "$reward" > /logs/verifier/reward.txt
