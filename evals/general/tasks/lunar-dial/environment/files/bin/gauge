#!/usr/bin/env python3
"""Tide-gauge instrument fixture.

Exposes a read-only 'sediment column' of unknown depth L via two endpoints:
    gauge <ctx> wet <k>    -> prints 1 if 0 <= k < L, else 0
    gauge <ctx> core <k>   -> prints "core-<k>-<L>" if 0 <= k < L, else BEDROCK

The depth L is derived from the station context file, NOT from its size: an
agent that counts lines or bytes of the ctx file gets the wrong answer. All
probing must go through this program.
"""
import json
import sys


def depth_of(ctx_path):
    with open(ctx_path, "rb") as fh:
        data = json.loads(fh.read())
    station = int(data["station"])
    datum = int(data["datum"])
    return (station * 2654435761 + datum * 40503) % 2999 + 1


def main() -> int:
    if len(sys.argv) < 3:
        print("USAGE gauge <ctx> wet|core <k>")
        return 2
    ctx = sys.argv[1]
    cmd = sys.argv[2]
    try:
        k = int(sys.argv[3])
    except (IndexError, ValueError):
        print("USAGE gauge <ctx> wet|core <k>")
        return 2
    try:
        L = depth_of(ctx)
    except (OSError, ValueError, KeyError):
        print("ERR bad context")
        return 2
    if cmd == "wet":
        print(1 if 0 <= k < L else 0)
        return 0
    if cmd == "core":
        print("core-%d-%d" % (k, L) if 0 <= k < L else "BEDROCK")
        return 0
    print("ERR unknown endpoint")
    return 2


if __name__ == "__main__":
    sys.exit(main())
