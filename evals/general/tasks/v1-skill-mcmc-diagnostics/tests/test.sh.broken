#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/answer.json ]; then
  if python3 - <<'EOF'
import json, sys, math
exp=math.sqrt(21/20)
got=json.load(open('/app/answer.json'))
v=float(got.get("rhat",-1))
if abs(v-exp) > 0.01: sys.exit("bad rhat")
sys.exit(0)
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt