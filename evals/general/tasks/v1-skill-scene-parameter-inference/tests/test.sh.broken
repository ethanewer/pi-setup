#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/scene_params.json ]; then
  if python3 - <<'EOF'
import math, json, sys

data = open('/app/render.ppm').read().split()
W, H = int(data[1]), int(data[2])
vals = list(map(int, data[4:]))
pts = []
for y in range(H):
    for x in range(W):
        pts.append((x, y, vals[y * W + x]))
disc = [p for p in pts if p[2] > 20]
xs = [p[0] for p in disc]; ys = [p[1] for p in disc]
cx = round((min(xs)+max(xs))/2)
cy = round((min(ys)+max(ys))/2)
radius = round((max(xs)-min(xs))/2)
mv = max(p[2] for p in pts)
bx, by = next((x,y) for x,y,v in pts if v == mv)
az = round(math.degrees(math.atan2(by-cy, bx-cx)) % 360, 1)

got = json.load(open('/app/scene_params.json'))
if got.get('cx') != cx or got.get('cy') != cy or got.get('radius') != radius:
    sys.exit('geometry mismatch')
got_az = got.get('azimuth_deg')
if got_az is None or abs(got_az - az) > 2.0:
    sys.exit('azimuth mismatch')
sys.exit(0)
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt