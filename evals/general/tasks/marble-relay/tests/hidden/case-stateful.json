{
  "queries": [
    {
      "send": {
        "op": "delay",
        "ms": 120
      },
      "expect": {
        "type": "result",
        "value": 120
      }
    },
    {
      "send": {
        "op": "sum",
        "values": [
          100,
          200
        ]
      },
      "expect": {
        "type": "result",
        "value": 300
      }
    },
    {
      "send": {
        "op": "delay",
        "ms": 200
      },
      "expect": {
        "type": "result",
        "value": 200
      }
    },
    {
      "send": {
        "op": "rev",
        "values": [
          9,
          8,
          7
        ]
      },
      "expect": {
        "type": "result",
        "values": [
          7,
          8,
          9
        ]
      }
    },
    {
      "send": {
        "op": "uniq",
        "values": [
          2,
          -2,
          2,
          0,
          0,
          -2
        ]
      },
      "expect": {
        "type": "result",
        "values": [
          -2,
          0,
          2
        ]
      }
    },
    {
      "send": {
        "op": "minmax",
        "values": [
          -7
        ]
      },
      "expect": {
        "type": "result",
        "min": -7,
        "max": -7
      }
    }
  ]
