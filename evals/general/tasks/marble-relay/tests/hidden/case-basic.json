{
  "queries": [
    {
      "send": {
        "op": "sum",
        "values": [
          5,
          10,
          15,
          -3
        ]
      },
      "expect": {
        "type": "result",
        "value": 27
      }
    },
    {
      "send": {
        "op": "minmax",
        "values": [
          4,
          1,
          7,
          1
        ]
      },
      "expect": {
        "type": "result",
        "min": 1,
        "max": 7
      }
    },
    {
      "send": {
        "op": "rev",
        "values": [
          1,
          2,
          3,
          4
        ]
      },
      "expect": {
        "type": "result",
        "values": [
          4,
          3,
          2,
          1
        ]
      }
    },
    {
      "send": {
        "op": "uniq",
        "values": [
          5,
          3,
          3,
          9,
          1,
          9
        ]
      },
      "expect": {
        "type": "result",
        "values": [
          1,
          3,
          5,
          9
        ]
      }
    },
    {
      "send": {
        "op": "fnv1a",
        "text": "marble"
      },
      "expect": {
        "type": "result",
        "value": 1683914112
      }
    }
  ]
}