#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/answer.json ]; then
  if python3 - <<'EOF'
import json, sys
got=json.load(open('/app/answer.json'))
checks = {
  "dot": (15.0, 1e-9),
  "angle_deg": (53.1301, 0.01),
  "distance": (2.23607, 0.01),
}
for k,(exp,tol) in checks.items():
    v=got.get(k)
    if not isinstance(v,(int,float)):
        sys.exit("bad type %s" % k)
    if abs(float(v)-exp) > tol:
        sys.exit("bad value %s" % k)
sys.exit(0)
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt