# large fixture binaries (>20MB) — fetch from HF dataset v2/assets/ per specs/large_assets.json
tasks/prism-bridge/environment/hadoop-3.3.6.tar.gz
tasks/harbor-gasket/environment/files/releases/node-v20.19.3-linux-x64.tar.xz
tasks/zephyr-orchid/environment/files/model/vosk_model.zip
tasks/raven-orchid/environment/files/vosk-model/graph/Gr.fst
tasks/raven-orchid/environment/files/vosk-model/graph/HCLr.fst

# The repository-root .gitignore ignores `*.log` and `evals/**/results/` to keep
# eval run artifacts out. Both patterns also match task fixture files, which are
# benchmark inputs, not artifacts: 65 .log fixtures and 74 files inside
# directories named results/. A fresh clone was missing all 139, which left
# kiln-anchor and larch-vane with empty tests/hidden (every hidden case is a
# series.log) and 145 provenance entries pointing at files that did not exist.
# Re-include the task tree. The five large assets above stay ignored and are
# listed first, so these negations cannot pull them back in.
!tasks/**/results/
!tasks/**/*.log
# audit artifacts (generated, not source)
specs/independence_report.json
specs/similarity_report.json
specs/oracle_report.json
specs/oracle_times.json
# private audit records
private-audit/
__pycache__/

# Harbor and agent scratch, regenerated on every run and never part of a task.
# Anchored with a leading slash on purpose: an unanchored `reward.txt` or
# `workspace` would also hide a future task fixture of the same name from git
# status, and tools/check_task_files_tracked.py exists precisely to catch a task
# that depends on a file a fresh clone will not have. Anchoring keeps these
# patterns matching this directory only.
/jobs/
/reward.txt
/try.json
/workspace
/zzctx/

# Generated runset symlinks, rebuilt by tools/build_runsets.py on demand.
/runsets/
/specs/.campaign-registration.lock
