#define VERSION_MINOR @VERSION_MINOR@

// Project identifier
#define PROJECT_ID "@PROJECT_ID@"

// Build timestamp
#define BUILD_TIMESTAMP "@BUILD_TIMESTAMP@"

// Build type
#define BUILD_TYPE "@BUILD_TYPE@"

#endif // PROJECT_CONFIG_H