{
  "transformations": [
    {
      "name": "convert_temperature",
      "condition": "unit == 'temperature'",
      "operation": "multiply",
      "factor": 1.8,
      "add": 32,
      "new_unit": "fahrenheit"
    },
    {
      "name": "filter_valid",
      "condition": "status == 'ok'",
      "operation": "filter"
    },
    {
      "name": "aggregate_by_sensor",
      "group_by": "sensor_id",
      "aggregations": {
        "value": ["mean", "min", "max", "std"],
        "count": "size"
      }
    }
  ],
  "output_format": {
    "timestamp_format": "iso",
    "numeric_precision": 2,
    "include_metadata": true
  }
}