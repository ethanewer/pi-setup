#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/product.json ]; then
  if python3 - <<'PYEOF'
import json
import numpy as np

A = np.array([[1, 2], [3, 4]])
B = np.array([[5, 6], [7, 8]])
expected = np.asarray(A @ B, dtype=int).tolist()

with open('/app/product.json') as f:
    data = json.load(f)
got = data['C']
assert got == expected, (got, expected)
PYEOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt