#!/bin/bash

mkdir -p /logs/verifier
reward=0
if [ -f /app/report.txt ]; then
  if python3 - <<'EOF'
import subprocess

subprocess.run(
    "ffmpeg -y -i /app/video.mp4 -ss 2.5 -frames:v 1 -f rawvideo -pix_fmt rgb24 -s 16x16 /tmp/expected.rgb".split(),
    check=True)

with open('/tmp/expected.rgb', 'rb') as f:
    raw = f.read()

n = 16 * 16
er = round(sum(raw[i*3+0] for i in range(n)) / n)
eg = round(sum(raw[i*3+1] for i in range(n)) / n)
eb = round(sum(raw[i*3+2] for i in range(n)) / n)

with open('/app/report.txt') as f:
    parts = f.read().strip().split()
got = tuple(int(x) for x in parts)
assert len(parts) == 3

# Account for the same ffmpeg-decode result; allow small tolerance.
assert abs(got[0] - er) <= 3, (got, (er, eg, eb))
assert abs(got[1] - eg) <= 3, (got, (er, eg, eb))
assert abs(got[2] - eb) <= 3, (got, (er, eg, eb))
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt