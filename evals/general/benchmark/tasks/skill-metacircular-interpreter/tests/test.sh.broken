#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/result.json ]; then
  if python3 - <<'EOF'
import json, sys, math
exp=[5,-17,3.5]
got=json.load(open('/app/result.json'))
if not isinstance(got,list) or len(got)!=3: sys.exit("len")
for g,e in zip(got,exp):
    if abs(float(g)-float(e))>1e-6: sys.exit("value")
sys.exit(0)
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt