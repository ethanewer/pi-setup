#!/bin/bash

mkdir -p /logs/verifier
reward=0

if [ -f /app/out.json ]; then
  if python3 - <<'EOF'
import json
records = json.load(open('/app/input.json'))
indexed = [(r['name'], r['score'], i) for i, r in enumerate(records)]
indexed.sort(key=lambda x: (-x[1], x[2]))
expected = [name for name, _, _ in indexed]

got = json.load(open('/app/out.json'))
assert isinstance(got, list) and all(isinstance(n, str) for n in got)
assert got == expected, (got, expected)
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt