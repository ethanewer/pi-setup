@prefix ex: <http://example.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:alice a foaf:Person ;
    foaf:name "Alice" ;
    ex:age 30 ;
    foaf:knows ex:bob .
ex:bob a foaf:Person ;
    foaf:name "Bob" ;
    ex:age 25 ;
    foaf:knows ex:carol .
ex:carol a foaf:Person ;
    foaf:name "Carol" ;
    ex:age 35 ;
    foaf:knows ex:dave .
ex:dave a foaf:Person ;
    foaf:name "Dave" ;
    ex:age 20 ;
    foaf:knows ex:alice .
