#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/answer.json ]; then
  if python3 - <<'EOF'
import sys, json
got=json.load(open('/app/answer.json'))
exp={"func1":"cdecl","func2":"stdcall","stack_cleaner_func1":"caller","stack_cleaner_func2":"callee"}
for k,v in exp.items():
    if str(got.get(k,'')).strip().lower()!=v:
        sys.exit("mismatch %s"%k)
sys.exit(0)
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt