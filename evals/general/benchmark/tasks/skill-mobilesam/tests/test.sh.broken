#!/bin/bash

mkdir -p /logs/verifier
reward=0
if [ -f /app/output/mask.npy ] && [ -f /app/output/mask_count.txt ]; then
  if python3 - <<'EOF'
import numpy as np

img = np.load('/app/input/image.npy')
flat = img.reshape(32 * 32).astype(np.float32)
with open('/app/input/prompt.txt') as f:
    px, py = map(int, f.read().strip().split())
prompt = np.array([px / 32.0, py / 32.0], dtype=np.float32)
feat = np.concatenate([flat, prompt])

d = np.load('/app/model/mobilesam.npz')
hidden = np.tanh(feat @ d['W_img'] + d['b_img'])
logits = hidden @ d['W_mask'] + d['b_mask']
expected_mask = (1.0 / (1.0 + np.exp(-logits))).reshape(32, 32).astype(np.float32)
expected_count = int(np.count_nonzero(expected_mask > 0.5))

got_mask = np.load('/app/output/mask.npy')
got_count = int(open('/app/output/mask_count.txt').read().strip())

assert got_mask.shape == (32, 32)
assert np.allclose(got_mask, expected_mask, atol=1e-4), (
    np.abs(got_mask - expected_mask).max())
assert got_count == expected_count, (got_count, expected_count)
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt