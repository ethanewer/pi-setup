#!/bin/bash
# Verifier: independently decode fields from /app/data.bin and compare with
# /app/answer.txt, then check /app/out.bin.
reward=0
mkdir -p /logs/verifier

if [ -f /app/answer.txt ] && [ -f /app/out.bin ]; then
  if python3 - <<'PYEOF'
import struct

data = open('/app/data.bin', 'rb').read()
expected = [
    struct.unpack_from('<I', data, 0x00)[0],
    struct.unpack_from('>H', data, 0x04)[0],
    struct.unpack_from('<Q', data, 0x06)[0],
]

lines = open('/app/answer.txt').read().strip().splitlines()
assert len(lines) == 3, lines
got = [int(x) for x in lines]
assert got == expected, (got, expected)

out = open('/app/out.bin', 'rb').read()
assert out == b'\xef\xbe\xad\xde', out.hex()
print('endianness OK')
PYEOF
  then
    reward=1
  fi

echo "$reward" > /logs/verifier/reward.txt