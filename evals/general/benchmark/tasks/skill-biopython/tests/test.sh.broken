#!/bin/bash
reward=0
if [ -f /app/summary.json ]; then
  if python3 - <<'PYEOF'
import json
from Bio import SeqIO
exp=[]
for rec in SeqIO.parse('/app/sequences.fasta','fasta'):
    s=str(rec.seq); total=len(s)
    c={ch:s.count(ch) for ch in 'ACGT'}
    gc=c['G']+c['C']
    pct=round(100.0*gc/total,2) if total else 0.0
    exp.append({'id':rec.id,'length':total,'counts':c,'gc_pct':pct})
got=json.load(open('/app/summary.json'))
assert got==exp, (got, exp)
PYEOF
  then
    reward=1
  fi
  then reward=1; fi
else reward=0; fi
echo "$reward" > /logs/verifier/reward.txt
