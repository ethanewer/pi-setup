#!/bin/bash
reward=0
mkdir -p /logs/verifier
if [ -f /app/unpacked.txt ]; then
  if python3 - <<'PYEOF'
out = bytearray()
with open('/app/packed.dat') as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        count, hx = line.split()
        out.extend(bytes([int(hx, 16)]) * int(count))
expected = bytes(out).decode('ascii').rstrip()
got = open('/app/unpacked.txt', 'r', errors='replace').read().rstrip()
assert got == expected, (got, expected)
PYEOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt