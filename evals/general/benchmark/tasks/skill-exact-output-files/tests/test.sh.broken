#!/bin/bash
reward=0
if [ -f /app/exact.bin ]; then
  if python3 - <<'PYEOF'
expected = bytes.fromhex("65786163742d6f757470757400ff01ff0a4142")
got = open('/app/exact.bin', 'rb').read()
assert got == expected, (got.hex(), expected.hex())
PYEOF
  then
    reward=1
  fi
  then reward=1; else reward=0; fi
else reward=0; fi
echo "$reward" > /logs/verifier/reward.txt