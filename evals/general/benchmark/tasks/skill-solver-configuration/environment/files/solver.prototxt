# Caffe 1.0 solver configuration — a partial solver.prototxt.
# Fill in the TBD fields according to the task description in instruction.md.
# Do not change the field *names* (only the `TBD` values).

train_net: "train.net.cpp"
test_net: "test.prototxt"
test_iter: TBD              # number of test batches per test phase
test_interval: TBD          # test every this many training iterations
base_lr: TBD                # starting learning rate
display: 20
max_iter: TBD               # total training iterations
lr_policy: TBD              # learning-rate schedule
gamma: TBD                  # lr multiplier per step
stepsize: TBD               # stepsize (iterations between lr steps)
momentum: TBD
weight_decay: TBD
snapshot: TBD
snapshot_prefix: "snap"
solver_mode: TBD
type: "SGD"