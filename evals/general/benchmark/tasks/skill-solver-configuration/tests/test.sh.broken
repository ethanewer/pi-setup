#!/bin/bash
# Verifier for skill-solver-configuration: parse /app/solver.prototxt.
mkdir -p /logs/verifier
reward=0

if [ -f /app/solver.prototxt ]; then
  if python3 - <<'PY'
required = {
    "test_iter": "100",
    "test_interval": "500",
    "base_lr": "0.01",
    "max_iter": "20000",
    "lr_policy": '"step"',
    "gamma": "0.1",
    "stepsize": "8000",
    "momentum": "0.9",
    "weight_decay": "0.0005",
    "snapshot": "2000",
    "solver_mode": '"GPU"',
}
import re
txt = open("/app/solver.prototxt").read()
def gval(key):
    m = re.search(r'^\s*' + re.escape(key) + r'\s*:\s*(.*?)\s*(#.*)?$', txt, re.M)
    return m.group(1).strip() if m else None
for key, want in required.items():
    got = gval(key)
    assert got == want, (key, got, want)
PY && reward=1
fi

echo "$reward" > /logs/verifier/reward.txt
echo "reward=$reward"