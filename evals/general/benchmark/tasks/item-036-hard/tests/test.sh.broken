#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/data.csv ] && [ -f /app/report.txt ]; then
  if python3 - <<'PY'
W = 1_000_000
# Regenerate the expected edited file from the deterministic scheme used at build.
expected = ['id,code']
for i in range(1, W + 1):
    code = chr(ord('A') + (i // 26) % 26) + chr(ord('A') + i % 26)
    expected.append(code + '-' + str(i))

got = open('/app/data.csv').read().splitlines()
# tolerate a trailing blank line from final newline only
if got and got[-1] == '':
    got = got[:-1]
assert got == expected, ('row count mismatch', len(got), len(expected))

report = open('/app/report.txt').read().strip()
assert report == '1000000', report
PY
  then
    reward=1
  fi
  then reward=1; fi
fi
echo "$reward" > /logs/verifier/reward.txt