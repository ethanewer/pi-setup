#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/results.txt ] && [ -f /app/mypkg/__init__.py ]; then
  if python3 - <<'PY'
import sys
sys.path.insert(0,'/app')
try:
    import mypkg
    fn=mypkg.classify
except Exception as e:
    print("import fail", repr(e)); sys.exit(1)
# validate classify on known values
assert fn(-7)=='negative' and fn(0)=='zero' and fn(9)=='positive', "classify logic wrong"
nums=[int(l.strip()) for l in open('/app/input.txt') if l.strip()]
expected=''.join(fn(n)+'\n' for n in nums)
got=open('/app/results.txt').read()
if got==expected:
    print("PASS"); sys.exit(0)
print("FAIL got=%r exp=%r"%(got,expected)); sys.exit(1)
PY
  then
    reward=1
  fi
  then reward=1; fi
fi
echo "$reward" > /logs/verifier/reward.txt
