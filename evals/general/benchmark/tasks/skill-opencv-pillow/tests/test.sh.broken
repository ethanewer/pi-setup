#!/bin/bash
# Verifier for skill-opencv-pillow.
# Recompute the pure-green pixel count from the image (with PIL) and compare.
mkdir -p /logs/verifier
reward=0

if [ -f /app/green_count.txt ]; then
  if python3 - <<'PYEOF'
import numpy as np
from PIL import Image

img = Image.open('/app/circle.png').convert('RGB')
arr = np.asarray(img)
mask = (arr[:, :, 1] > 200) & (arr[:, :, 0] < 50) & (arr[:, :, 2] < 50)
expected = int(mask.sum())
assert expected > 0

got = open('/app/green_count.txt').read().strip()
assert got == str(expected), (got, expected)
PYEOF
  then
    reward=1
  fi

echo "$reward" > /logs/verifier/reward.txt
exit 0