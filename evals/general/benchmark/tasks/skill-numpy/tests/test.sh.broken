#!/bin/bash
# Verifier for skill-numpy: recompute A@B and A+B and compare with /app/result.txt.
mkdir -p /logs/verifier
reward=0

if [ -f /app/result.txt ]; then
  if python3 - <<'PYEOF'
import numpy as np

A = np.loadtxt('/app/A.txt', dtype=int)
B = np.loadtxt('/app/B.txt', dtype=int)
expC = np.rint(A @ B).astype(int)
expD = (A + B).astype(int)

lines = open('/app/result.txt').read().splitlines()
assert len(lines) >= 8, 'result.txt too short'
assert lines[0].strip() == 'C:'
assert lines[4].strip() == 'D:'
gotC = np.array([[int(x) for x in lines[i].split()] for i in range(1, 4)])
gotD = np.array([[int(x) for x in lines[i].split()] for i in range(5, 8)])
assert gotC.shape == expC.shape and gotD.shape == expD.shape, 'wrong shape'
assert (gotC == expC).all(), ('C mismatch', gotC, expC)
assert (gotD == expD).all(), ('D mismatch', gotD, expD)
PYEOF
  then
    reward=1
  fi

echo "$reward" > /logs/verifier/reward.txt
exit 0