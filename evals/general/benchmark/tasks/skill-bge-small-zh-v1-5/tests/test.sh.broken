#!/bin/bash
reward=0
if [ -f /app/similarity.json ]; then
  if python3 - <<'PYEOF'
import json, math
data = json.load(open('/app/embed.json'))
sents = data['sentences']; vecs = data['embeddings']
def coss(x,y):
    n=sum(a*b for a,b in zip(x,y))
    nx=math.sqrt(sum(a*a for a in x)); ny=math.sqrt(sum(a*a for a in y))
    return 0.0 if nx==0 or ny==0 else n/(nx*ny)
exp=[]
for i in range(len(sents)):
    bi=-1; bs=-1.0
    for j in range(len(sents)):
        if i==j: continue
        s=coss(vecs[i],vecs[j])
        if bi==-1 or s>bs or (abs(s-bs)<1e-12 and j<bi):
            bs=s; bi=j
    exp.append({'sentence':sents[i], 'closest':sents[bi], 'score':round(bs,4)})
got=json.load(open('/app/similarity.json'))
assert got==exp, (got, exp)
PYEOF
  then
    reward=1
  fi
  then reward=1; fi
else reward=0; fi
echo "$reward" > /logs/verifier/reward.txt
