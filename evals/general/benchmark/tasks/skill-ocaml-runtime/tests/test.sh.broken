#!/bin/bash
# Verifier for skill-ocaml-runtime.
# Reward 1: answer correct AND a compiled OCaml binary + source exist.
# Reward 0.5: answer correct even if compilation artifact missing.
mkdir -p /logs/verifier
reward=0

if [ -f /app/answer.txt ]; then
  ok=0
  if python3 - <<'PYEOF'
vals = [int(x) for x in open('/app/input.txt').read().split()]
exp = sum(vals)
got_line = open('/app/answer.txt').read().strip()
assert got_line == str(exp), (got_line, exp)
PYEOF
  then
    reward=1
  fi
  then
    ok=1
  fi
  if [ "$ok" -eq 1 ] && [ -f /app/sum.ml ] && [ -f /app/sum ]; then
    reward=1
  elif [ "$ok" -eq 1 ]; then
    reward=0.5
  fi
fi

echo "$reward" > /logs/verifier/reward.txt
exit 0