#!/bin/bash
# Verifier for item-070-main.
# Objective checks (all re-run here, never trusted from the agent alone):
#  1. sqlite3 on PATH, version 3.46.1, from a neutral cwd.
#  2. four behavior probes against the installed binary.
#  3. coverage artifacts: re-run gcov -n, parse % , require >= 5% and within
#     +/-3pp of the agent's recorded value (also parsed from coverage-summary).
#  4. vendor tarball SHA-256 matches the recorded value.
#  5. report.json well-formed.
mkdir -p /logs/verifier

reward=0
pct=0
agent_pct=-1

run_behavior() {
  # Returns 0 if the four probes pass from a neutral directory.
  local v json fts math
  v=$(sqlite3 :memory: "select sqlite_version();" 2>/dev/null) || return 1
  [ "$v" = "3.46.1" ] || return 1
  json=$(sqlite3 :memory: "select json_extract('{\"a\":7}','\$.a');" 2>/dev/null) || return 1
  [ "$json" = "7" ] || return 1
  fts=$(sqlite3 :memory: "CREATE VIRTUAL TABLE t USING fts5(c); INSERT INTO t VALUES ('one'),('two'); SELECT count(*) FROM t WHERE t MATCH 'one OR two';" 2>/dev/null) || return 1
  [ "$fts" = "2" ] || return 1
  math=$(sqlite3 :memory: "select round(sin(0.0),4), round(cos(0.0),4);" 2>/dev/null) || return 1
  [ "$math" = "0.0|1.0" ] || return 1
  return 0
}

# --- 1+2. PATH + behavior (from a neutral dir so PATH resolution is exercised)
cd /tmp
PATH_OK=0
BEHAVIOR_OK=0
if command -v sqlite3 >/dev/null 2>&1; then
  PATH_OK=1
  if run_behavior; then
    BEHAVIOR_OK=1
  fi
fi

# --- 3. coverage: re-run gcov in the build dir and parse the summary
BUILD=/app/src/sqlite-autoconf-3460100
GCOV_OK=0
if [ -d "$BUILD" ] && [ -f "$BUILD/sqlite3-sqlite3.gcda" ] && command -v gcov >/dev/null 2>&1; then
  if (cd "$BUILD" && gcov -n -o sqlite3-sqlite3.o sqlite3.c > /tmp/gcov_verify.txt 2>&1); then
    LINE=$(grep -oE "Lines executed:[0-9.]+% of [0-9]+" /tmp/gcov_verify.txt | head -1)
    if [ -n "$LINE" ]; then
      pct=$(echo "$LINE" | sed -E 's/Lines executed:([0-9.]+)% of ([0-9]+)/\1/')
      # shellcheck disable=SC2004
      if python3 - "$pct" <<'PY'
import sys
pct = float(sys.argv[1])
sys.exit(0 if pct >= 5.0 else 1)
PY
      then
        reward=1
      fi
      then
        GCOV_OK=1
      fi
    fi
  fi
fi

# --- agent-recorded coverage value (from report.json, cross-checked vs summary file)
RECORDED_OK=0
if [ -f /app/artifacts/report.json ]; then
  if python3 - "$pct" "$GCOV_OK" <<'PY'
import json, re, sys

pct = float(sys.argv[1])
gcov_ok = sys.argv[2] == "1"

rep = json.load(open("/app/artifacts/report.json"))
assert rep.get("sqlite_version") == "3.46.1", "version"
assert rep.get("build_dir") == "/app/src/sqlite-autoconf-3460100", "build_dir"
assert rep.get("configure_command") == "./configure --prefix=/usr/local --disable-shared --enable-static", "configure"
cflags = rep.get("cflags", "")
assert "--coverage" in cflags and "SQLITE_ENABLE_FTS5" in cflags, "cflags"
beh = rep.get("behavior_checks", {})
assert all(beh.get(k) is True for k in ("version_matches","json_ok","fts5_ok","math_ok")), "behavior flags"
assert rep.get("path_install_ok") is True, "path flag"

agent_pct = float(rep["gcov_lines_executed_pct"])
agent_tot = int(rep["gcov_total_lines"])

# summary file must contain the same summary line
summ = open("/app/artifacts/coverage-summary.txt").read()
m = re.search(r"Lines executed:([0-9.]+)% of ([0-9]+)", summ)
assert m, "summary line missing"
s_pct, s_tot = float(m.group(1)), int(m.group(2))
assert abs(s_pct - agent_pct) < 0.05, "summary/report mismatch"
assert s_tot == agent_tot, "summary total mismatch"

if gcov_ok:
    assert abs(pct - agent_pct) <= 3.0, ("coverage drift", pct, agent_pct)

print("ok")
PY
  then
    reward=1
  fi
  then
    RECORDED_OK=1
  fi
fi

# --- vendor tarball integrity vs recorded sha
SHA_OK=0
if [ -f /app/src/sqlite-autoconf-3460100.tar.gz ] && [ -f /app/artifacts/report.json ]; then
  if python3 - <<'PY'
import hashlib, json
h = hashlib.sha256(open("/app/src/sqlite-autoconf-3460100.tar.gz","rb").read()).hexdigest()
rep = json.load(open("/app/artifacts/report.json"))
assert rep.get("vendor_sha256") == h, "vendor sha mismatch"
print("ok")
PY
  then
    reward=1
  fi
  then
    SHA_OK=1
  fi
fi

# --- reward
if [ "$PATH_OK" = "1" ] && [ "$BEHAVIOR_OK" = "1" ] && [ "$GCOV_OK" = "1" ] \
   && [ "$RECORDED_OK" = "1" ] && [ "$SHA_OK" = "1" ]; then
  reward=1
fi

echo "$reward" > /logs/verifier/reward.txt
