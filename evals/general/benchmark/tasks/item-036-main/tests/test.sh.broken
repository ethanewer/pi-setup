#!/bin/bash
mkdir -p /logs/verifier
reward=0

if [ -f /app/out.csv ] && [ -f /app/data.csv ] && [ -f /app/macro_recipe.txt ]; then
  if python3 - >/dev/null 2>&1 <<'PYEOF'
import re
src = open('/app/data.csv', 'rb').read().splitlines()
got = open('/app/out.csv', 'rb').read().splitlines()
assert len(got) == len(src) > 0, 'line count mismatch'
rx = re.compile(rb'^(\d+),(\d{4})(\d{2})(\d{2}),(-?[\d.]+)$')
for i, ln in enumerate(src):
    m = rx.match(ln)
    assert m, 'bad source line %d' % i
    exp = b'%s,%s-%s-%s,%s' % (m.group(1), m.group(2), m.group(3), m.group(4), m.group(5))
    assert got[i] == exp, 'line %d mismatch' % i
# recipe must contain a vim command token (a ':' command or a 'q' macro marker or 'normal')
recipe = open('/app/macro_recipe.txt').read()
assert len(recipe.strip()) > 0
assert ('normal' in recipe) or (':' in recipe) or ('q' in recipe)
PYEOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt