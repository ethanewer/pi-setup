#!/bin/bash
mkdir -p /logs/verifier

reward=0
if [ -f /app/payload.gz ] && [ -f /app/recovered.txt ]; then
  python3 - <<'PYEOF'
import gzip

original = open('/app/plain.txt', 'rb').read()
compressed = open('/app/payload.gz', 'rb').read()

# gzip must be a valid stream and round-trip to the original
assert gzip.decompress(compressed) == original, (gzip.decompress(compressed), original)

# recovered file must equal original
assert open('/app/recovered.txt', 'rb').read() == original
PYEOF
echo "$reward" > /logs/verifier/reward.txt