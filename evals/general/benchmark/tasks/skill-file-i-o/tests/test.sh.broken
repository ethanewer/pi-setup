#!/bin/bash
reward=0
if [ -f /app/output.txt ]; then
  if python3 - <<'PYEOF'
vals = []
for line in open('/app/input.txt'):
    s = line.strip()
    if s:
        vals.append(int(s))
total = sum(vals); count = len(vals); mean = total / count
exp = f"sum={total}\ncount={count}\nmean={mean}\n"
got = open('/app/output.txt').read()
assert got == exp, (got, exp)
PYEOF
  then
    reward=1
  fi
  then reward=1; else reward=0; fi
else reward=0; fi
echo "$reward" > /logs/verifier/reward.txt