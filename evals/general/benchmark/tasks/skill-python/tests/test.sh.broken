#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/stats.json ]; then
  if python3 - <<'PYEOF'
import csv, json

rows = list(csv.DictReader(open('/app/sales.csv', newline='')))
amounts = [int(r['amount']) for r in rows]
count = len(amounts)
total = sum(amounts)
avg = total / count

with open('/app/stats.json') as f:
    got = json.load(f)

assert got['count'] == count, got
assert got['total'] == total, got
assert abs(got['avg'] - avg) < 1e-9, got
PYEOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt