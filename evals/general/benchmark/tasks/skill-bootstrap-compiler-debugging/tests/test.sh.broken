#!/bin/bash
reward=0
if [ -f /app/src_output.txt ]; then
  if python3 - <<'PYEOF'
import re
def tokenize(s):
    toks=[]; i=0
    while i<len(s):
        c=s[i]
        if c.isspace(): i+=1; continue
        if c.isdigit():
            j=i
            while j<len(s) and s[j].isdigit(): j+=1
            toks.append(int(s[i:j])); i=j; continue
        if c in '()+-*': toks.append(c); i+=1; continue
        i+=1
    return toks
def parse(toks):
    pos=[0]
    def expr():
        v=term()
        while pos[0]<len(toks) and toks[pos[0]] in ('+','-'):
            op=toks[pos[0]]; pos[0]+=1; r=term()
            v = v+r if op=='+' else v-r
        return v
    def term():
        v=factor()
        while pos[0]<len(toks) and toks[pos[0]]=='*':
            pos[0]+=1; v=v*factor()
        return v
    def factor():
        t=toks[pos[0]]
        if t=='(':
            pos[0]+=1; v=expr(); pos[0]+=1; return v
        pos[0]+=1; return t
    return expr()
lines=[ln.strip() for ln in open('/app/src.txt') if ln.strip()]
exp=[parse(tokenize(ln)) for ln in lines]
got=[int(x) for x in open('/app/src_output.txt').read().split()]
assert got==exp, (got, exp)
PYEOF
  then
    reward=1
  fi
  then reward=1; fi
else reward=0; fi
echo "$reward" > /logs/verifier/reward.txt
