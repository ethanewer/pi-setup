#!/bin/bash
mkdir -p /logs/verifier

reward=0
if [ -f /app/testresult.txt ]; then
  python3 - <<'PYEOF'
import sys
sys.path.insert(0, '/app')
import codegtool

cases = [
    ({"multiplier": 3, "offset": 1}, 5, 16),
    ({"multiplier": 2, "offset": 5}, 10, 24),
    ({"multiplier": -1, "offset": 100}, 42, 42),
    ({"multiplier": 4, "offset": 0}, 25, 100),
]
for cfg, value, expected in cases:
    assert codegtool.scaled_value(value, cfg) == expected
marker = open('/app/testresult.txt').read().strip()
assert marker == "ALL_CONFIG_TESTS_PASS"
PYEOF
echo "$reward" > /logs/verifier/reward.txt