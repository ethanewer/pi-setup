#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/names.txt ]; then
  if python3 - <<'PY'
import struct, sys
data=open('/app/records.bin','rb').read()
names=[]
for off in range(0,len(data),34):
    rid, raw=struct.unpack_from('<I30s', data, off)
    names.append(raw.decode('ascii').rstrip('\x00'))
expected=''.join(n+'\n' for n in names)
got=open('/app/names.txt').read()
if got==expected:
    print("PASS"); sys.exit(0)
print("FAIL\nGOT:\n%r\nEXP:\n%r"%(got,expected)); sys.exit(1)
PY
  then
    reward=1
  fi
  then reward=1; fi
fi
echo "$reward" > /logs/verifier/reward.txt
