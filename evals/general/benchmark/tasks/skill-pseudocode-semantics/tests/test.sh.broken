#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/pseudocode.py ] && [ -f /app/result.txt ]; then
  if python3 - <<'PYEOF'
total = 0
for i in range(1, 101):
    if (i % 3 == 0) or (i % 5 == 0):
        total += i
expected = str(total)
got = open('/app/result.txt').read().strip()
assert got == expected, (got, expected)
PYEOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt