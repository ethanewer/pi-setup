#!/bin/bash
# configure -- autoconf-style probe for the compcert-src staged build.
set -e

mkdir -p build
ARCH="$(uname -m)"
case "$ARCH" in
  x86_64 | amd64 | x86-64 | aarch64 | arm64) WORDSIZE=64 ;;
  i386 | i486 | i586 | i686 | x86)            WORDSIZE=32 ;;
  *)
    echo "configure: unsupported host ABI '$ARCH' (see README)" >&2
    exit 1
    ;;
esac
echo "configure: detected arch=$ARCH -> intended wordsize=$WORDSIZE"

CC="$(command -v gcc)"
OCAMLC="$(command -v ocamlc)"
COQC="$(command -v coqc)"
if [ -z "$OCAMLC" ]; then OCAMLC="$(find /usr /opt -name ocamlc 2>/dev/null | head -1)"; fi
if [ -z "$COQC" ]; then COQC="$(find /usr /opt -name coqc 2>/dev/null | head -1)"; fi

missing=""
[ -z "$CC" ]     && missing="$missing gcc"
[ -z "$OCAMLC" ] && missing="$missing ocamlc"
[ -z "$COQC" ]   && missing="$missing coqc"
if [ -n "$missing" ]; then
  echo "configure: ERROR this host is missing required toolchain component(s):$missing" >&2
  echo "configure: install them (e.g. apt-get install -y ocaml coq) then run ./configure again" >&2
  exit 1
fi

echo "/* generated by configure */" > build/deploy.h
echo "#define C0_WORDSIZE $WORDSIZE" >> build/deploy.h

cat > build/cfg.mk <<EOF
WORDSIZE=$WORDSIZE
CC=$CC
OCAMLC=$OCAMLC
COQC=$COQC
EOF

echo "configure: ok; wrote build/deploy.h (C0_WORDSIZE=$WORDSIZE) and build/cfg.mk"