#!/bin/bash
mkdir -p /logs/verifier
APP="${TASK_APP:-/app}"
reward=0
if [ -f "$APP/primers.txt" ] && [ -f "$APP/sequence.txt" ]; then
  if /usr/bin/env python3 - "$APP" <<'PY'
import sys
app = sys.argv[1]
seq = open(app + '/sequence.txt').read().strip()
def rc(s):
    return s.translate(str.maketrans('ACGT','TGCA'))[::-1]
def gc(s):
    return 100.0 * (s.count('G') + s.count('C')) / len(s)
try:
    fwd = None; rev = None
    for line in open(app + '/primers.txt'):
        line = line.strip()
        if line.startswith('F:'):
            fwd = line.split(':', 1)[1].strip()
        elif line.startswith('R:'):
            rev = line.split(':', 1)[1].strip()
    if not fwd or not rev:
        sys.exit(1)
    def valid(s):
        return (18 <= len(s) <= 25) and (40.0 <= gc(s) <= 60.0)
    fi = seq.find(fwd)
    ri = seq.find(rc(rev))
    ok = (valid(fwd) and valid(rev)
          and fi >= 0 and ri >= 0
          and not (ri < fi + len(fwd) and fi < ri + len(rev)))
    sys.exit(0 if ok else 1)
except Exception:
    sys.exit(1)
PY && reward=1
fi
fi
printf '%s' "$reward" > /logs/verifier/reward.txt