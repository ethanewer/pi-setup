#!/bin/bash
reward=0
if [ -f /app/predictions.txt ]; then
  if python3 - <<'PYEOF'
import sys
sys.path.insert(0, '/app')
m = __import__('model', fromlist=['model'])
model = m.model
import subprocess
ins = [int(x) for x in open('/app/test_inputs.txt').read().split()]
exp = []
for n in ins:
    exp.append(int(subprocess.check_output(['python3', '/app/oracle.py', str(n)]).decode().strip()))
got = [int(x) for x in open('/app/predictions.txt').read().split()]
assert got == exp, (got, exp)
PYEOF
  then
    reward=1
  fi
  then reward=1; fi
else reward=0; fi
echo "$reward" > /logs/verifier/reward.txt
