#!/bin/bash
mkdir -p /logs/verifier
APP="${TASK_APP:-/app}"
reward=0
if [ -f "$APP/warrior.red" ]; then
  if /usr/bin/env python3 - "$APP/warrior.red" <<'PY'
import sys, re
path = sys.argv[1]
valid = {'DAT','MOV','ADD','SUB','MUL','DIV','MOD','JMP','JMZ','JMN','DJN','CMP','SLT','SPL','SEQ','SNE','STP','NOP'}
ctrl  = {'JMP','JMZ','JMN','DJN','SPL','SLT','CMP','SEQ','SNE'}
try:
    instr = []
    ok = True
    for raw in open(path):
        code = raw.split(';')[0].strip()
        if not code:
            continue
        # strip optional leading label "name:"
        code = re.sub(r'^\s*[A-Za-z][A-Za-z0-9_]*\s*:', '', code).strip()
        if not code:
            continue
        parts = code.split()
        tok = parts[0]
        opc = tok.split('.',1)[0].upper()
        if opc not in {'DAT','MOV','ADD','SUB','MUL','DIV','MOD','JMP','JMZ','JMN','DJN','CMP','SLT','SPL','SEQ','SNE','STP','NOP'}:
            ok = False
            break
        rest = ' '.join(parts[1:])
        operands = [x.strip() for x in rest.split(',') if x.strip()]
        for o in operands:
            if not re.match(r'^[-#$@<>*{}+]?[A-Za-z0-9_]+$', o):
                ok = False
                break
        instr.append(opc)
    good = ok and len(instr) >= 3 and 'DAT' in instr and any(o in ctrl for o in instr)
    sys.exit(0 if good else 1)
except Exception:
    sys.exit(1)
PY && reward=1
fi
fi
printf '%s' "$reward" > /logs/verifier/reward.txt