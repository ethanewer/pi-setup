#!/bin/bash
# Verifier for skill-opencv.
# Recompute the red-pixel count with OpenCV and compare. Also sanity-check that the
# image actually contains 3600 red pixels (protects against a mis-generated file).
mkdir -p /logs/verifier
reward=0

if [ -f /app/red_count.txt ]; then
  if python3 - <<'PYEOF'
import cv2

img = cv2.imread('/app/shapes.png')
mask = cv2.inRange(img, (0, 0, 200), (100, 100, 255))
expected = int(cv2.countNonZero(mask))
assert expected == 3600, ('unexpected image', expected)

got = open('/app/red_count.txt').read().strip()
assert got == str(expected), (got, expected)
PYEOF
  then
    reward=1
  fi

echo "$reward" > /logs/verifier/reward.txt
exit 0