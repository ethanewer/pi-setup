FROM bench-base:python-3.12

WORKDIR /app

# Build a binary blob: junk bytes, then a printable token, then junk bytes.
RUN python3 - <<'PYEOF'
data = bytes([0x00,0xFF,0x01,0x02,0xFE,0x7f,0x00,0x03]) \
    + b"POKE-TOKEN-7B2" \
    + bytes([0x00, 0x01, 0xFF, 0xE5, 0x00, 0x7F, 0x0A, 0x0D, 0xFE])
open('/app/blob.bin','wb').write(data)
PYEOF