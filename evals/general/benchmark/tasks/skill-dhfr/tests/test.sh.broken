#!/bin/bash
mkdir -p /logs/verifier
reward=0

if [ -f /app/formula.txt ]; then
  if python3 - <<'PY'
import re
expected = {"C":4,"N":0,"O":1,"S":0,"P":0,"F":0,"Cl":0,"Br":0}
got = {}
for line in open('/app/formula.txt'):
    line=line.strip()
    if not line:
        continue
    m = re.match(r'^([A-Z][a-z]?)\s+(\d+)$', line)
    if not m:
        raise SystemExit("bad line: %r" % line)
    got[m.group(1)] = int(m.group(2))
assert got == expected, (got, expected)
PY && reward=1
fi

fi
echo "$reward" > /logs/verifier/reward.txt