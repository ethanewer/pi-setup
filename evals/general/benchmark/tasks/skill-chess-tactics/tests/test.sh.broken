#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/mating.txt ]; then
  if python3 - <<'EOF'
import chess,sys
fen=open('/app/position.txt').read().strip()
raw=open('/app/mating.txt').read().strip()
parts=raw.split()
if len(parts)!=1: sys.exit("must be exactly one move")
try:
    mv=chess.Move.from_uci(parts[0])
except Exception:
    sys.exit("not a valid UCI move")
b=chess.Board(fen)
if mv not in b.legal_moves: sys.exit("not legal in position")
bb=b.copy(); bb.push(mv)
if not bb.is_checkmate(): sys.exit("not checkmate")
sys.exit(0)
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt