#!/usr/bin/env bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/repo/.gitignore ] && [ -d /app/repo/.git ]; then
  if python3 - <<'PY'
import subprocess, sys
def run(args, cwd="/app/repo"):
    return subprocess.run(args, cwd=cwd, text=True, capture_output=True).stdout
status = run(["git", "status", "--porcelain"]).strip()
files = sorted(run(["git", "ls-files"]).split())
msg = run(["git", "log", "--format=%s", "-1"]).strip()
gi = open("/app/repo/.gitignore").read()
patterns = ["*.log", "*.tmp", "cache/", "__pycache__/"]
ok = (
    status == ""
    and msg == "hygiene"
    and files == sorted([".gitignore", "main.py", "README.md"])
    and all(p in gi for p in patterns)
)
sys.exit(0 if ok else 1)
PY && reward=1
fi
fi
echo "$reward" > /logs/verifier/reward.txt