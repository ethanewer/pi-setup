#!/bin/bash
mkdir -p /logs/verifier
reward=0

if [ -f /app/designed.txt ]; then
  if python3 - <<'PY'
s = open('/app/designed.txt').read().strip().upper()
assert len(s) == 10
assert all(c in "ACGT" for c in s)
assert all(s.count(c) >= 1 for c in "ACGT")
assert all(s[i] != s[i+1] for i in range(len(s)-1))
assert s[0] == 'A', s
assert s[-1] == 'G', s
assert s.count('T') == 2, s
PY && reward=1
fi

fi
echo "$reward" > /logs/verifier/reward.txt