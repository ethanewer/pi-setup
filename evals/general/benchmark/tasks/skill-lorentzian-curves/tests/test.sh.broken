#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/answer.json ]; then
  if python3 - <<'EOF'
import json, sys, math
got=json.load(open('/app/answer.json'))
exp_fwhm=1.6
exp_peak=2.0/(math.pi*0.8)
if abs(float(got.get("fwhm",-1))-exp_fwhm)>1e-6: sys.exit("fwhm")
if abs(float(got.get("peak_height",-1))-exp_peak)>0.001: sys.exit("peak")
sys.exit(0)
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt