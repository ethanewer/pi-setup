#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/transform.py ]; then
  HERE="$(dirname "$0")"
  python3 /app/transform.py < "$HERE/test_input.txt" > /tmp/transform_out.txt 2>/dev/null
  if python3 - <<'PY' && [ -s /tmp/transform_out.txt ]; then
rows = []
for line in open('/tmp/transform_out.txt'):
    line = line.strip()
    if not line:
        continue
    name, score = line.rsplit(' ', 1)
    rows.append((name, int(score)))

expected = [
    ("BOB", 30), ("ERIN", 30), ("ALICE", 25),
    ("DAVE", 25), ("GINA", 25), ("CAROL", 10), ("FRANK", 5),
]
assert rows == expected, (rows, expected)
PY
  then
    reward=1
  fi
fi
echo "$reward" > /logs/verifier/reward.txt