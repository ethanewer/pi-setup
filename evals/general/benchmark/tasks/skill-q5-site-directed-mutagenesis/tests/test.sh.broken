#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/mutated.txt ]; then
  if python3 - <<'PY'
import sys
dna=open('/app/dna.txt').read().strip()
mut=[]
for line in open('/app/mutations.txt'):
    line=line.strip()
    if not line: continue
    i,old,new=line.split(); mut.append((int(i),old,new))
arr=list(dna)
for i,old,new in mut:
    if arr[i]!=old:
        print("SOURCE MISMATCH"); sys.exit(0)
    arr[i]=new
expected=''.join(arr)
got=open('/app/mutated.txt').read()
if got==expected:
    print("PASS"); sys.exit(0)
print("FAIL\nGOT: %r\nEXP: %r"%(got,expected)); sys.exit(1)
PY
  then
    reward=1
  fi
  then reward=1; fi
fi
echo "$reward" > /logs/verifier/reward.txt
