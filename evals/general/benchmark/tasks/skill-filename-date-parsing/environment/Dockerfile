FROM bench-base:python-3.12
WORKDIR /app
RUN mkdir -p /app/logs && \
    printf 'x' > /app/logs/app-2024-11-02.log && \
    printf 'y' > /app/logs/app-2023-01-15.log && \
    printf 'z' > /app/logs/app-2024-07-30.log && \
    printf 'w' > /app/logs/app-2024-12-31.log && \
    printf 'v' > /app/logs/app-2024-02-29.log