#!/bin/bash
mkdir -p /logs/verifier
APP="${TASK_APP:-/app}"
reward=0
if [ -f "$APP/polygon.txt" ] && [ -f "$APP/area.txt" ] && [ -f "$APP/perimeter.txt" ]; then
  if /usr/bin/env python3 - "$APP" <<'PY'
import re, math, sys
app = sys.argv[1]
svg = open(app + '/shape.svg').read()
m = re.search(r'points="([^"]+)"', svg)
if not m:
    sys.exit(1)
pts = [tuple(map(int, p.split(','))) for p in m.group(1).split()]
n = len(pts)
exp_pts = set(pts)
area = 0.5 * abs(sum(pts[i][0]*pts[(i+1) % n][1] - pts[(i+1) % n][0]*pts[i][1] for i in range(n)))
per  = sum(math.hypot(pts[(i+1) % n][0]-pts[i][0], pts[(i+1) % n][1]-pts[i][1]) for i in range(n))
got = set()
for l in open(app + '/polygon.txt'):
    l = l.strip()
    if not l:
        continue
    try:
        x, y = l.split(',')
        got.add((int(x), int(y)))
    except Exception:
        sys.exit(1)
try:
    area_g = float(open(app + '/area.txt').read().strip())
    per_g  = float(open(app + '/perimeter.txt').read().strip())
except Exception:
    sys.exit(1)
ok = (got == exp_pts) and abs(area_g - area) < 0.0006 and abs(per_g - per) < 0.0006
sys.exit(0 if ok else 1)
PY && reward=1
fi
fi
printf '%s' "$reward" > /logs/verifier/reward.txt