#!/bin/bash
mkdir -p /logs/verifier

reward=0
if [ -f /app/sim.txt ]; then
  python3 - <<'PYEOF'
import json, math
a = json.load(open('/app/a.json'))
b = json.load(open('/app/b.json'))
def norm(v): return math.sqrt(sum(x*x for x in v))
na, nb = norm(a), norm(b)
expected = (sum(x*y for x,y in zip(a,b))/(na*nb)) if na and nb else 0.0
expected = round(expected, 6)
got = round(float(open('/app/sim.txt').read().strip()), 6)
assert abs(got - expected) < 1e-6, (got, expected)
PYEOF
echo "$reward" > /logs/verifier/reward.txt