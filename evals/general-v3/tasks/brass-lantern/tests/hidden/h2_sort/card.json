{
  "model_name": "lantern-fable-2",
  "arch": "causal_decoder",
  "modules": [
    {
      "name": "backbone.h.2.attn.q_proj",
      "type": "Linear"
    },
    {
      "name": "backbone.h.10.attn.q_proj",
      "type": "Linear"
    },
    {
      "name": "backbone.h.2.mlp.conv",
      "type": "Conv1D"
    },
    {
      "name": "backbone.h.10.mlp.conv",
      "type": "Conv1D"
    },
    {
      "name": "backbone.wte",
      "type": "Embedding"
    },
    {
      "name": "score_head",
      "type": "Linear",
      "head": true,
      "trainable": false
    },
    {
      "name": "lm_head",
      "type": "Linear",
      "head": true
    }
  ],
  "lora": {
    "r": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.0
  }
}
