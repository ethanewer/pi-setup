{
  "model_name": "brass-lantern-story-causal",
  "arch": "causal_decoder",
  "modules": [
    {
      "name": "transformer.wte",
      "type": "Embedding"
    },
    {
      "name": "transformer.wpe",
      "type": "Embedding"
    },
    {
      "name": "transformer.h.0.ln_1",
      "type": "LayerNorm"
    },
    {
      "name": "transformer.h.0.attn.q_attn",
      "type": "Linear"
    },
    {
      "name": "transformer.h.0.attn.kv_attn",
      "type": "Linear"
    },
    {
      "name": "transformer.h.0.attn.c_proj",
      "type": "Conv1D"
    },
    {
      "name": "transformer.h.0.ln_2",
      "type": "LayerNorm"
    },
    {
      "name": "transformer.h.0.mlp.c_fc",
      "type": "Conv1D"
    },
    {
      "name": "transformer.h.0.mlp.c_proj",
      "type": "Conv1D"
    },
    {
      "name": "transformer.ln_f",
      "type": "LayerNorm"
    },
    {
      "name": "transformer.drop",
      "type": "Dropout"
    },
    {
      "name": "lm_head",
      "type": "Linear",
      "head": true
    }
  ],
  "lora": {
    "r": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.05
  }
}
