{
  "map_path": "/etc/postfix/virtual_lists",
  "map": {
    "flare@lists.jettyward.org": "ops@flarepoint.example",
    "jetty-log@lists.jettyward.org": "jettyward",
    "notices@lists.jettyward.org": "watchdesk"
  },
  "aliases": {
    "jetty-log": "jettyward",
    "notices": "watchdesk"
  },
  "accounts": ["jettyward", "watchdesk"],
  "report": {
    "map_path": "/etc/postfix/virtual_lists",
    "lists": [
      {"address": "flare@lists.jettyward.org", "target": "ops@flarepoint.example", "kind": "external"},
      {"address": "jetty-log@lists.jettyward.org", "target": "jettyward", "kind": "local"},
      {"address": "notices@lists.jettyward.org", "target": "watchdesk", "kind": "local"}
    ]
  }
}
