@prefix ex: <http://keystone.sage.example/seed/> .
@prefix kbs: <http://keystone.sage.example/schema#> .


# recruit roster with decoys a recruiter without a name, a non002recruit
# seconded entity, and a studio that has no name.
ex:r-ori  a kbs:Recruit ; kbs:name "Nadia Havel" ; kbs:secondedTo ex:st-order .
ex:r-lin  a kbs:Recruit ; kbs:name "Tobias Linn" ; kbs:secondedTo ex:st-clay , ex:st-order .
ex:r-ven  a kbs:Recruit ; kbs:name "Nosy Pende" ; kbs:secondedTo ex:st-anvil .
ex:r-moss a kbs:Recruit ;                            kbs:secondedTo ex:st-order .
ex:desc-a kbs:name "Varua Outreach" ;                kbs:secondedTo ex:st-clay .
ex:st-order a kbs:Studio ; kbs:name "Order Workshop" .
ex:st-clay  a kbs:Studio ; kbs:name "Clay Bureau" .
ex:st-anvil a kbs:Studio ; kbs:name "Anvil Hall" .
ex:st-bare  a kbs:Studio .

