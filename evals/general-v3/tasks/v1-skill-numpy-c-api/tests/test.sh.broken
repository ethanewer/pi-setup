#!/bin/bash
# Verifier for skill-numpy-c-api.
# Reward 1 iff /app/result.json contains the correct elementwise squares and the
# sqmod extension was actually built from C source (the .so exists next to sqmod.c).
mkdir -p /logs/verifier
reward=0

if [ -f /app/result.json ]; then
  if python3 - <<'PYEOF'
import json
import numpy

exp_in = [1, 2, 3, 4, 5, 6, 7, 8]
exp_out = [i * i for i in exp_in]

got = json.load(open('/app/result.json'))
assert got['in'] == exp_in, (got, exp_in)
assert got['out'] == exp_out, (got, exp_out)
assert all(isinstance(v, int) for v in got['out']), 'out entries must be ints'
PYEOF
  then
    reward=1
  fi
  then
    if [ -f /app/src/sqmod.c ] && ls /app/src/sqmod*.so >/dev/null 2>&1; then
      reward=1
    fi
  fi
fi

echo "$reward" > /logs/verifier/reward.txt
exit 0