#!/bin/bash

reward=0
if [ -f /app/render.py ]; then
  if python3 - <<'EOF'
import importlib.util

spec = importlib.util.spec_from_file_location("render_mod", "/app/render.py")
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
render = mod.render_html

cases = [
    "<script>alert(1)</script>",
    '"><img src=x onerror=alert(1)>',
    "<b>bold</b>",
    "a & b",
    "<svg onload=alert(1)>",
]
for inp in cases:
    out = render(inp)
    # must not reflect raw HTML tag characters from user input
    if "<" in out or ">" in out:
        raise AssertionError(("raw tag char", inp, out))
    assert "<div>" in out, out

# ampersand must be escaped to an entity
out = render("a & b")
assert "&amp;" in out, out
# quote handling should also escape double quotes when requested
out = render('"hello"')
assert "&quot;" in out, out
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt