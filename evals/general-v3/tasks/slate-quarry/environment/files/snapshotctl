#!/usr/bin/env python3
"""snapshotctl - privileged snapshot sealing tool.

Only the `seal` and `verify` subcommands are supported. Both operate inside
the root-only runtime gate /var/lib/snapshotd/gate, so they are only useful
through privilege escalation.
"""
import hashlib
import os
import sys

GATE = "/var/lib/snapshotd/gate"


def seal_body(name):
    digest = hashlib.sha256(("snapshotd-seal:v1:" + name).encode()).hexdigest()
    return "snapshotd-seal:v1:%s:%s\n" % (name, digest)


def ensure_gate():
    os.makedirs(GATE, exist_ok=True)
    os.chmod(GATE, 0o700)
    os.chown(GATE, 0, 0)


def cmd_seal(name):
    if not name or "/" in name or name.startswith("."):
        sys.stderr.write("seal: bad name\n")
        return 2
    ensure_gate()
    path = os.path.join(GATE, name + ".seal")
    with open(path, "w") as fh:
        fh.write(seal_body(name))
    os.chmod(path, 0o644)
    os.chown(path, 0, 0)
    sys.stdout.write("sealed %s\n" % name)
    return 0


def cmd_verify(name):
    path = os.path.join(GATE, name + ".seal")
    if not os.path.isfile(path):
        sys.stderr.write("verify: no seal for %s\n" % name)
        return 1
    with open(path) as fh:
        if fh.read() != seal_body(name):
            sys.stderr.write("verify: stale seal for %s\n" % name)
            return 1
    sys.stdout.write("ok %s\n" % name)
    return 0


def main(argv):
    if len(argv) != 3:
        sys.stderr.write("usage: snapshotctl <seal|verify> <name>\n")
        return 2
    cmd, name = argv[1], argv[2]
    if cmd == "seal":
        return cmd_seal(name)
    if cmd == "verify":
        return cmd_verify(name)
    sys.stderr.write("snapshotctl: unknown subcommand %r\n" % cmd)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
