{
  "comment": "hidden behavioural probe: top-k selection order",
  "cases": [
    {"func": "top_k", "args": [[9, 1, 8, 2, 7], 3], "expect": [9, 8, 7]},
    {"func": "top_k", "args": [[5], 0], "expect": []},
    {"func": "top_k", "args": [[5], -2], "expect": []},
    {"func": "top_k", "args": [[2, 3, 1], 10], "expect": [3, 2, 1]},
    {"func": "top_k", "args": [[4, 4, 4, 1], 2], "expect": [4, 4]},
    {"func": "top_k", "args": [[-1, -5, -3], 2], "expect": [-1, -3]},
    {"func": "top_k", "args": [[0.5, 0.25, 0.9], 2], "expect": [0.9, 0.5]}
  ]
}
