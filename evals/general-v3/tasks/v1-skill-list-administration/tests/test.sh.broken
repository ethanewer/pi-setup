#!/bin/bash
mkdir -p /logs/verifier
reward=0
if [ -f /app/result.json ]; then
  if python3 - <<'EOF'
import json, sys
exp=[45,54,66]
got=json.load(open('/app/result.json'))
if not isinstance(got,list) or len(got)!=len(exp) or [int(x) for x in got]!=exp:
    sys.exit("bad result")
sys.exit(0)
EOF
  then
    reward=1
  fi
echo "$reward" > /logs/verifier/reward.txt