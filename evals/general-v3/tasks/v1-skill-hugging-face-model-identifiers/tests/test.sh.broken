#!/bin/bash
reward=0
mkdir -p /logs/verifier
if [ -f /app/ids.txt ]; then
  if python3 - <<'PYEOF'
import json, re
models = json.load(open('/app/models.json'))
pattern = re.compile(r'^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$')
exp = []
ok = True
for m in models:
    ident = m['org'] + '/' + m['name']
    if not pattern.match(ident):
        ok = False
    exp.append(ident)
got = open('/app/ids.txt').read().strip().split('\n')
assert ok and got == exp, (got, exp)
PYEOF
  then
    reward=1
  fi
  then reward=1; fi
fi
echo "$reward" > /logs/verifier/reward.txt