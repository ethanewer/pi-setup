#!/usr/bin/env bun
/**
 * Report what this terminal actually sends for a keypress, and what Pi makes of it.
 *
 *   bin/pi-setup-keyprobe              press keys, see the bytes; ctrl+q to quit
 *   bin/pi-setup-keyprobe --decode 1b0d    decode hex bytes without a terminal
 *
 * Run it inside tmux and outside it. A binding only works where the two agree, and only
 * if the "pi sees" column is the key id you meant to bind.
 *
 * Like Pi, it asks for the Kitty keyboard protocol first and reports whether the terminal
 * agreed, because the answer changes every encoding below: Ghostty sends Option+Tab as
 * `ESC [ 9;3u` (`alt+tab`) with the protocol on, and as `ESC TAB` (`ctrl+alt+i`) without
 * it. tmux does not forward the protocol unless `extended-keys` is set, so the same
 * terminal reports differently inside and outside tmux.
 */

import { homedir } from "node:os";
import { join } from "node:path";

const tuiEntry = join(
	process.env.BUN_INSTALL ?? join(homedir(), ".bun"),
	"install/global/node_modules/@earendil-works/pi-tui/dist/index.js",
);

let parseKey: (data: string) => string | null;
let setKittyProtocolActive: (active: boolean) => void;
try {
	({ parseKey, setKittyProtocolActive } = await import(tuiEntry));
} catch (error) {
	console.error(`pi-setup-keyprobe: could not load pi-tui from ${tuiEntry}`);
	console.error(String(error));
	process.exit(2);
}

const hex = (text: string): string =>
	[...Buffer.from(text, "utf8")].map((byte) => byte.toString(16).padStart(2, "0")).join(" ");

const printable = (text: string): string =>
	JSON.stringify(text).slice(1, -1).replace(/\\u001b/g, "\\e");

function report(data: string): void {
	const key = parseKey(data) ?? "(unrecognized)";
	console.log(`  bytes ${hex(data).padEnd(24)} raw "${printable(data)}"`.padEnd(56) + `pi sees: ${key}`);
}

const decodeIndex = process.argv.indexOf("--decode");
if (decodeIndex !== -1) {
	const raw = (process.argv[decodeIndex + 1] ?? "").replace(/[^0-9a-fA-F]/g, "");
	if (raw.length === 0 || raw.length % 2 !== 0) {
		console.error("usage: pi-setup-keyprobe --decode <hex bytes, e.g. 1b0d>");
		process.exit(2);
	}
	report(Buffer.from(raw, "hex").toString("utf8"));
	process.exit(0);
}

if (!process.stdin.isTTY) {
	console.error("pi-setup-keyprobe: needs a terminal. Use --decode <hex> otherwise.");
	process.exit(2);
}

process.stdin.setRawMode(true);
process.stdin.resume();
process.stdin.setEncoding("utf8");

// Ask for the Kitty keyboard protocol exactly as Pi does, then wait briefly for the
// terminal's reply. Without this the probe reports legacy encodings for a terminal that
// will send Pi something else entirely.
const KITTY_PUSH = "\x1b[>1u";
const KITTY_QUERY = "\x1b[?u";
const KITTY_POP = "\x1b[<u";
const kittyReply = /\x1b\[\?\d+u/;

let negotiating = true;
let kittyActive = false;
process.stdout.write(KITTY_PUSH + KITTY_QUERY);

const restore = () => {
	if (kittyActive) process.stdout.write(KITTY_POP);
	process.stdin.setRawMode(false);
};

process.stdin.on("data", (chunk: string) => {
	if (negotiating) {
		if (kittyReply.test(chunk)) {
			kittyActive = true;
			setKittyProtocolActive(true);
			return;
		}
		// Anything else during the negotiation window is a real keypress; fall through.
	}
	if (chunk === "\x11") {
		console.log("\nbye");
		restore();
		process.exit(0);
	}
	report(chunk);
});

setTimeout(() => {
	negotiating = false;
	console.log(`
Kitty keyboard protocol: ${kittyActive ? "ACTIVE — Pi sees CSI-u sequences" : "not active — legacy encodings"}
${process.env.TMUX ? "Inside tmux." : "NOT inside tmux — run it again inside tmux and compare."}

Press the keys you want to bind. Each line shows the bytes your terminal sent and the key
id Pi would match against. Ctrl+Q quits.

Worth testing: enter, option+enter, option+tab, shift+enter, option+p, tab, shift+tab.
`);
}, 250);
