#!/usr/bin/env bash
# Check that the installed Pi setup still matches this repository.
#
#   bin/pi-setup-doctor            full report
#   bin/pi-setup-doctor --quiet    only problems
#   bin/pi-setup-doctor --offline  skip the npm registry check for upstream releases
#   bin/pi-setup-doctor --fix      repair what can be repaired mechanically, then re-check
#
# Exits non-zero when anything is wrong, so it can gate CI or a shell prompt.
#
# --fix handles exactly the problems whose repair is deterministic: an installed copy that
# no longer matches forks/, settings that do not load a fork or still load the npm package
# that would shadow it, a version that drifted from the pin, and an stt.json that is not
# owner-only. The first three are all one thing — re-running the installer — so that is what it
# does. It never deletes anything, never edits a fork, and never touches trust.json or the
# compaction settings, because those need a judgement it cannot make.
set -uo pipefail

is_windows() {
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) return 0 ;;
  esac
  return 1
}

QUIET=0
OFFLINE=0
FIX=0
FIXED=0
for arg in "$@"; do
  case "$arg" in
    --quiet) QUIET=1 ;;
    --offline) OFFLINE=1 ;;
    --fix) FIX=1 ;;
    -h|--help) awk 'NR==1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;;
    *) printf 'pi-setup-doctor: unknown argument %s\n' "$arg" >&2; exit 2 ;;
  esac
done

# Repairs are recorded rather than performed inline: a fix that reinstalls would invalidate
# every check after it, so they run once at the end and the whole report is re-run.
NEEDS_INSTALL=0
FIXABLE_STT=""
fixable() { # fixable <what> <message>
  case "$1" in
    install) NEEDS_INSTALL=1 ;;
    stt) FIXABLE_STT="$2" ;;
  esac
}

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MAIN_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
WF_DIR="$HOME/.pi/agent-wf"
LOCAL_PKG_DIR="$MAIN_DIR/local"

PROBLEMS=0
NOTES=0
say() { [[ "$QUIET" == "1" ]] || printf '%s\n' "$*"; }
ok() { [[ "$QUIET" == "1" ]] || printf '  ok       %s\n' "$*"; }
note() { NOTES=$((NOTES + 1)); printf '  note     %s\n' "$*"; }
bad() { PROBLEMS=$((PROBLEMS + 1)); printf '  PROBLEM  %s\n' "$*"; }

# The installer guarantees bun, not node: a clean machine that never had Node.js still has
# to be able to run this. bun -e takes the same code-then-argv shape as node -e, so either
# works for the small scripts below — but bun must be preferred: node <20 cannot execute
# bin/verify-pi-ai-reasoning-fix (top-level ESM import in a .js file), so a machine that
# has both would otherwise fail the behavior check it actually passes.
if command -v bun >/dev/null 2>&1; then
  JS="$(command -v bun)"
elif [[ -x "${BUN_INSTALL:-$HOME/.bun}/bin/bun" ]]; then
  JS="${BUN_INSTALL:-$HOME/.bun}/bin/bun"
elif [[ -x "${BUN_INSTALL:-$HOME/.bun}/bin/bun.exe" ]]; then
  JS="${BUN_INSTALL:-$HOME/.bun}/bin/bun.exe"
elif command -v node >/dev/null 2>&1; then
  JS="node"
else
  printf '%s: needs node or bun on PATH\n' "$(basename "$0")" >&2
  exit 2
fi

FORK_NAMES="$("$JS" -e '
const v = require(process.argv[1] + "/vendor.json");
console.log(Object.keys(v.forks).join(" "));
' "$REPO_DIR")" || { printf 'pi-setup-doctor: could not read vendor.json\n' >&2; exit 2; }

say ""
say "Forks: repository vs installed"
for fork in $FORK_NAMES; do
  SRC="$REPO_DIR/forks/$fork"
  DST="$LOCAL_PKG_DIR/$fork"
  if [[ ! -d "$SRC" ]]; then
    bad "$fork is listed in vendor.json but missing from forks/"
    continue
  fi
  if [[ ! -d "$DST" ]]; then
    bad "$fork is not installed at $DST (bin/pi-setup-doctor --fix)"
    fixable install
    continue
  fi
  # .git is present when a fork was installed from its own checkout; node_modules and
  # bun.lock are produced by the dependency install. None is part of the fork's content.
  # TypeScript live entries are compiled to a sibling .js at install time. Ignore that
  # extra file in the tree diff, but still require it to exist and still compare every
  # other index.js (including audited dist/ entries).
  COMPILED="$(
    REPO_DIR="$REPO_DIR" FORK="$fork" "$JS" -e '
const live = require(process.env.REPO_DIR + "/vendor.json").forks[process.env.FORK]?.live;
if (typeof live === "string" && /\.ts$/i.test(live)) process.stdout.write(live.replace(/\.ts$/i, ".js"));
'
  )"
  if [[ -n "$COMPILED" && ! -f "$DST/$COMPILED" ]]; then
    bad "$fork is missing the install-time compiled $COMPILED (bin/pi-setup-doctor --fix)"
    fixable install
  fi
  DIFF="$(diff -rq --exclude=node_modules --exclude=.git --exclude=bun.lock "$SRC" "$DST" 2>&1 || true)"
  if [[ -n "$COMPILED" && -n "$DIFF" ]]; then
    compiled_dir="${COMPILED%/*}"
    compiled_base="${COMPILED##*/}"
    DIFF="$(printf '%s\n' "$DIFF" | grep -v -F "${compiled_dir}: ${compiled_base}" || true)"
  fi
  if [[ -z "${DIFF:-}" ]]; then
    if [[ -z "$COMPILED" || -f "$DST/$COMPILED" ]]; then
      ok "$fork matches the installed copy"
    fi
  else
    bad "$fork differs from the installed copy (bin/pi-setup-doctor --fix reinstalls from forks/):"
    fixable install
    printf '%s\n' "$DIFF" | sed 's/^/             /' | head -20
  fi
done

say ""
say "First-party skills: repository vs installed"
# skills/ is installed into the agent directories' own skills/, not as a package; see
# skills/README.md. Both full profiles get copies (piwf has its own agent directory);
# the lean p runs --no-skills and gets none.
for skill in agent-browser-cli unslop update-pi-setup; do
  SRC="$REPO_DIR/skills/$skill/SKILL.md"
  if [[ ! -f "$SRC" ]]; then
    bad "skill $skill is missing from skills/"
    continue
  fi
  for dest in "$MAIN_DIR/skills" "$WF_DIR/skills"; do
    if diff -q "$SRC" "$dest/$skill/SKILL.md" >/dev/null 2>&1; then
      ok "skill $skill matches the copy in $dest"
    else
      bad "skill $skill differs from the copy in $dest (bin/pi-setup-doctor --fix)"
      fixable install
    fi
  done
done

say ""
say "Pi settings"
# pi (MAIN_DIR) deliberately excludes the workflows fork, which now lives behind the
# piwf profile (~/.pi/agent-wf). piwf must load every fork, including workflows.
SETTINGS="$MAIN_DIR/settings.json"
WF_SETTINGS="$HOME/.pi/agent-wf/settings.json"
if [[ ! -f "$SETTINGS" ]]; then
  bad "missing $SETTINGS (install.sh writes it; run bin/pi-setup-doctor --fix)"
  fixable install
else
  SETTINGS_REPORT="$("$JS" -e '
const { readFileSync, existsSync } = require("node:fs");
const [settingsPath, wfSettingsPath, repoDir] = process.argv.slice(1);
const vendor = require(repoDir + "/vendor.json");
const identity = (entry) => {
  const source = typeof entry === "string" ? entry : entry?.source;
  if (typeof source !== "string") return "";
  let spec = source.replace(/^npm:/, "");
  if (spec.startsWith("local/")) return spec.slice("local/".length);
  if (spec.startsWith("@")) return spec.split("@").slice(0, 2).join("@");
  return spec.split("@")[0];
};
// The workflows fork is intentionally excluded from the plain pi profile; it must be
// present in the piwf profile and absent from pi. `forbidden` lists forks that must NOT
// be loaded, so the whole check (parsing included) lives in one guarded path.
const WF_ONLY = "pi-dynamic-workflows-safe";
const allForks = Object.keys(vendor.forks);
const shadowForks = Object.entries(vendor.forks).filter(([, m]) => m.upstream);
const check = (path, label, required, forbidden = []) => {
  const out = [];
  if (!existsSync(path)) return ["bad\tmissing " + path + " (bin/pi-setup-doctor --fix)"];
  let settings;
  try { settings = JSON.parse(readFileSync(path, "utf8")); }
  catch (error) { return ["bad\t" + path + " is not valid JSON (" + error.message + "; bin/pi-setup-doctor --fix)"]; }
  const ids = (settings.packages ?? []).map(identity);
  for (const fork of required) {
    if (ids.includes(fork)) out.push("ok\t" + label + " settings load local/" + fork);
    else out.push("bad\t" + label + " settings do not load local/" + fork + " (bin/pi-setup-doctor --fix)");
  }
  for (const fork of forbidden) {
    if (ids.includes(fork)) {
      out.push("bad\t" + label + " settings load local/" + fork + ", which must remain behind the piwf profile (bin/pi-setup-doctor --fix)");
    }
  }
  for (const [fork, meta] of shadowForks) {
    if (ids.includes(meta.upstream)) {
      out.push("bad\t" + label + " settings still load the unpatched npm package " + meta.upstream + " (it can shadow the fork; bin/pi-setup-doctor --fix)");
    }
  }
  return out;
};
const out = check(settingsPath, "pi", allForks.filter((f) => f !== WF_ONLY), [WF_ONLY]);
out.push(...check(wfSettingsPath, "piwf", allForks));
console.log(out.join("\n"));
' "$SETTINGS" "$WF_SETTINGS" "$REPO_DIR")"
  while IFS=$'\t' read -r kind message; do
    [[ -z "${kind:-}" ]] && continue
    if [[ "$kind" == "ok" ]]; then
      ok "$message"
    else
      bad "$message"
      # install.sh owns settings.json's packages list, so reinstalling is the repair.
      fixable install
    fi
  done <<< "$SETTINGS_REPORT"
fi

say ""
say "Configuration hygiene"
STT="$MAIN_DIR/stt.json"
if [[ -f "$STT" ]]; then
  if is_windows; then
    ok "stt.json is present (Unix file modes are not used on Windows)"
  else
    # GNU stat -f means --file-system and *succeeds* with unrelated output, so trying BSD
    # first silently produced a non-mode on Linux and reported a false problem on every
    # install there. Try GNU, then fall back only if the result is not an octal mode.
    MODE="$(stat -c '%a' "$STT" 2>/dev/null)"
    case "$MODE" in ''|*[!0-7]*) MODE="$(stat -f '%Lp' "$STT" 2>/dev/null)" ;; esac
    if [[ "$MODE" == "600" ]]; then
      ok "stt.json is owner-only (600)"
    else
      bad "stt.json is mode $MODE; it selects the transcription host and capture binary, so it should be 600 (chmod 600 $STT)"
      fixable stt "$STT"
    fi
  fi
fi

TRUST="$MAIN_DIR/trust.json"
if [[ -f "$TRUST" ]]; then
  TRUST_REPORT="$("$JS" -e '
const { readFileSync } = require("node:fs");
const { homedir } = require("node:os");
const trust = JSON.parse(readFileSync(process.argv[1], "utf8"));
const home = homedir();
const broad = Object.entries(trust)
  .filter(([path, decision]) => decision === true && (path === home || path === "/" || home.startsWith(path + "/")))
  .map(([path]) => path);
console.log(broad.join("\n"));
' "$TRUST" 2>/dev/null)"
  if [[ -z "$TRUST_REPORT" ]]; then
    ok "no home-wide project-trust entries"
  else
    while read -r entry; do
      [[ -z "$entry" ]] && continue
      bad "trust.json trusts $entry, and Pi inherits trust down the directory tree, so every repository under it is trusted without a prompt. Remove that key from $TRUST and re-approve the repositories you actually work in (this is a judgement call, so --fix will not touch it)."
    done <<< "$TRUST_REPORT"
  fi
fi

say ""
say "Compiled mirrors"
# dynamic-workflows ships src/ (what Pi loads) and dist/ (reachable through the package
# exports field). They must agree: a previous divergence left seven dist files byte-identical
# to vulnerable upstream while the audited src was fine, so the exported code was not the
# code anyone had reviewed. Comparing every file needs a compiler; comparing the shape and
# spot-checking the fork's own constants catches the failure that actually happened.
MIRROR_DIR="$REPO_DIR/forks/pi-dynamic-workflows-safe"
if [[ -d "$MIRROR_DIR/src" && -d "$MIRROR_DIR/dist" ]]; then
  MIRROR_REPORT="$("$JS" -e '
const { readdirSync, readFileSync, existsSync } = require("node:fs");
const root = process.argv[1];
const srcNames = readdirSync(root + "/src").filter((f) => f.endsWith(".ts")).map((f) => f.slice(0, -3));
const missing = srcNames.filter((n) => !existsSync(root + "/dist/" + n + ".js"));
if (missing.length > 0) {
  console.log("bad\t" + missing.length + " src module(s) have no dist counterpart: " + missing.slice(0, 5).join(", "));
  process.exit(0);
}
// Spot-check the constants this fork changed away from upstream. A dist that lost them is
// a dist rebuilt from upstream rather than from this src.
const probes = [
  ["config", /DEFAULT_AGENT_RETRIES\s*=\s*2/],
  ["config", /DEFAULT_AGENT_TIMEOUT_MS\s*=\s*60\s*\*\s*60\s*\*\s*1000/],
  ["workflow-manager", /defaultAgentRetries !== undefined/],
];
const drifted = [];
for (const [name, pattern] of probes) {
  const inSrc = pattern.test(readFileSync(root + "/src/" + name + ".ts", "utf8"));
  const inDist = pattern.test(readFileSync(root + "/dist/" + name + ".js", "utf8"));
  if (inSrc !== inDist) drifted.push(name + " (" + pattern.source.slice(0, 30) + ")");
}
if (drifted.length > 0) console.log("bad\tdist has drifted from src: " + drifted.join("; ") + ". Rebuild with npm run build in that fork.");
else console.log("ok\t" + srcNames.length + " src modules mirrored in dist, fork constants present in both");
' "$MIRROR_DIR" 2>/dev/null)"
  if [[ -z "$MIRROR_REPORT" ]]; then
    note "could not compare src and dist for pi-dynamic-workflows-safe"
  else
    IFS=$'\t' read -r MIRROR_KIND MIRROR_MSG <<< "$MIRROR_REPORT"
    [[ "${MIRROR_KIND:-bad}" == "ok" ]] && ok "$MIRROR_MSG" || bad "$MIRROR_MSG"
  fi
fi

say ""
say "Keybindings and the p profile"
# config/keybindings.json is merged into all three agent directories by install.sh.
# Nothing checked that it arrived, so a remap could silently apply to none of them.
KEYBINDS_SRC="$REPO_DIR/config/keybindings.json"
P_DIR="$HOME/.pi/agent-p"
if [[ ! -f "$KEYBINDS_SRC" ]]; then
  bad "missing $KEYBINDS_SRC; install.sh has nothing to merge into the agent directories"
else
  for target in "$MAIN_DIR/keybindings.json" "$P_DIR/keybindings.json" "$WF_DIR/keybindings.json"; do
    if [[ ! -f "$target" ]]; then
      bad "$target is missing; the remapped keys are not in effect there (bin/pi-setup-doctor --fix)"
      fixable install
      continue
    fi
    MISSING="$("$JS" -e '
const { readFileSync } = require("node:fs");
const [srcPath, dstPath] = process.argv.slice(1);
const want = JSON.parse(readFileSync(srcPath, "utf8"));
const have = JSON.parse(readFileSync(dstPath, "utf8"));
const out = [];
for (const [id, keys] of Object.entries(want)) {
  const mine = JSON.stringify(keys);
  if (JSON.stringify(have[id]) !== mine) out.push(id);
}
process.stdout.write(out.join(", "));
' "$KEYBINDS_SRC" "$target" 2>/dev/null)"
    if [[ -z "$MISSING" ]]; then
      ok "$(basename "$(dirname "$target")")/keybindings.json carries every managed binding"
    else
      bad "$target does not match config/keybindings.json for: $MISSING (bin/pi-setup-doctor --fix)"
      fixable install
    fi
  done
fi

# The lean profile is a full second installation surface. Its CLI allowlist is what keeps
# browser, monitor, workflows, and every skill out, so checking only that the wrapper exists
# would miss both accidental additions and missing lightweight extensions.
#
# The expected allowlist is read out of lib/wrappers/p.sh rather than restated here.
# Restating it would make this check assert a second, independent opinion about what p
# should load. Derived from the wrapper template, a mismatch can only mean the installed
# wrapper is stale, which is exactly what reinstalling fixes.
P_WRAPPER="$HOME/.local/bin/p"
P_WRAPPER_OK=0
if [[ -f "$P_WRAPPER" ]]; then
  if is_windows || [[ -x "$P_WRAPPER" ]]; then P_WRAPPER_OK=1; fi
fi
if [[ "$P_WRAPPER_OK" != "1" ]]; then
  bad "$P_WRAPPER is missing or not executable (bin/pi-setup-doctor --fix)"
  fixable install
elif is_windows && [[ ! -f "$HOME/.local/bin/p.cmd" ]]; then
  bad "$HOME/.local/bin/p.cmd is missing, so PowerShell/cmd cannot launch the lean profile (bin/pi-setup-doctor --fix)"
  fixable install
elif [[ ! -f "$P_DIR/settings.json" ]]; then
  bad "$P_DIR/settings.json is missing, so the lean profile has no configuration (bin/pi-setup-doctor --fix)"
  fixable install
else
  if ! P_PROFILE_REPORT="$("$JS" -e '
const { readFileSync } = require("node:fs");
const [wrapper, template] = process.argv.slice(1);

const parse = (text) => {
  const lines = text.split(/\r?\n/).map((line) => line.trim());
  return {
    noExtensions: lines.filter((line) => line === "--no-extensions \\").length,
    noSkills: lines.filter((line) => line === "--no-skills \\").length,
    extensions: lines.flatMap((line) => {
      const match = line.match(/^--extension\s+"([^"]+)"(?:\s+\\)?$/);
      return match ? [match[1]] : [];
    }),
  };
};

const want = parse(readFileSync(template, "utf8"));
const got = parse(readFileSync(wrapper, "utf8"));
const problems = [];
if (want.extensions.length === 0) problems.push("lib/wrappers/p.sh declares no --extension for p; the contract cannot be checked");
if (want.noExtensions !== 1 || want.noSkills !== 1) problems.push("lib/wrappers/p.sh does not pass --no-extensions and --no-skills exactly once for p");
if (problems.length === 0) {
  if (got.noExtensions !== want.noExtensions) problems.push("--no-extensions appears " + got.noExtensions + " time(s), expected " + want.noExtensions);
  if (got.noSkills !== want.noSkills) problems.push("--no-skills appears " + got.noSkills + " time(s), expected " + want.noSkills);
  if (JSON.stringify(got.extensions) !== JSON.stringify(want.extensions)) {
    problems.push("extension allowlist is [" + got.extensions.join(", ") + "]; lib/wrappers/p.sh declares [" + want.extensions.join(", ") + "]");
  }
}
process.stdout.write(problems.join("; "));
' "$P_WRAPPER" "$REPO_DIR/lib/wrappers/p.sh" 2>/dev/null)"; then
    bad "could not inspect $P_WRAPPER's lean profile contract (bin/pi-setup-doctor --fix)"
    fixable install
  elif [[ -z "$P_PROFILE_REPORT" ]]; then
    P_EXT_NAMES="$("$JS" -e '
const { readFileSync } = require("node:fs");
const names = readFileSync(process.argv[1], "utf8").split(/\r?\n/)
  .flatMap((line) => {
    const value = line.trim();
    const local = value.match(/^--extension\s+"[^"]*\/local\/([^/]+)\//);
    if (local) return [local[1].replace(/^pi-/, "").replace(/-safe$/, "")];
    const direct = value.match(/^--extension\s+"[^"]*\/extensions\/([^/]+)\/index\.(ts|js)"/);
    return direct ? [direct[1]] : [];
  });
process.stdout.write(names.join(", "));
' "$P_WRAPPER" 2>/dev/null)"
    ok "the p profile matches lib/wrappers/p.sh: ${P_EXT_NAMES:-no local extensions}, no skills"
  else
    bad "$P_WRAPPER does not match the lean profile lib/wrappers/p.sh declares: $P_PROFILE_REPORT (bin/pi-setup-doctor --fix)"
    fixable install
  fi
fi

# piwf is the third entrypoint: full environment incl. dynamic workflows. It must exist
# and point at its own agent directory, where the settings check above requires it to
# load every fork including the workflows one.
WF_WRAPPER="$HOME/.local/bin/piwf"
WF_WRAPPER_OK=0
if [[ -f "$WF_WRAPPER" ]]; then
  if is_windows || [[ -x "$WF_WRAPPER" ]]; then WF_WRAPPER_OK=1; fi
fi
if [[ "$WF_WRAPPER_OK" != "1" ]]; then
  bad "$WF_WRAPPER is missing or not executable (bin/pi-setup-doctor --fix)"
  fixable install
elif is_windows && [[ ! -f "$HOME/.local/bin/piwf.cmd" ]]; then
  bad "$HOME/.local/bin/piwf.cmd is missing, so cmd.exe/PowerShell cannot launch piwf (bin/pi-setup-doctor --fix)"
  fixable install
elif ! grep -q 'PI_CODING_AGENT_DIR="\$HOME/.pi/agent-wf"' "$WF_WRAPPER"; then
  bad "$WF_WRAPPER does not point at ~/.pi/agent-wf (bin/pi-setup-doctor --fix)"
  fixable install
else
  ok "the piwf wrapper points at ~/.pi/agent-wf"
fi

if is_windows; then
  for name in pi piwf agent-browser; do
    if [[ ! -f "$HOME/.local/bin/${name}.cmd" ]]; then
      bad "$HOME/.local/bin/${name}.cmd is missing, so cmd.exe/PowerShell cannot launch ${name} (bin/pi-setup-doctor --fix)"
      fixable install
    else
      ok "${name}.cmd shim is present"
    fi
  done
fi

# A keybind Pi cannot parse falls back to the upstream default without saying so.
if [[ -f "$STT" ]]; then
  STT_REPORT="$("$JS" -e '
const { readFileSync } = require("node:fs");
let config;
try { config = JSON.parse(readFileSync(process.argv[1], "utf8")); }
catch (error) { process.stdout.write("bad\tstt.json is not valid JSON (" + error.message + "); voice dictation falls back to its defaults"); process.exit(0); }
const keybind = config.keybind;
const list = Array.isArray(keybind) ? keybind : typeof keybind === "string" ? [keybind] : [];
if (list.length === 0) process.stdout.write("bad\tstt.json has no usable keybind; dictation falls back to ctrl+r");
else process.stdout.write("ok\tvoice keybind " + list.join(" / "));
' "$STT" 2>/dev/null)"
  IFS=$'\t' read -r STT_KIND STT_MSG <<< "$STT_REPORT"
  [[ "${STT_KIND:-bad}" == "ok" ]] && ok "$STT_MSG" || bad "${STT_MSG:-stt.json could not be read}"
fi

say ""
say "Retired and unknown local packages"
UNKNOWN=0
if [[ -d "$LOCAL_PKG_DIR" ]]; then
  for dir in "$LOCAL_PKG_DIR"/*; do
    [[ -d "$dir" ]] || continue
    name="$(basename "$dir")"
    if ! printf '%s\n' $FORK_NAMES | grep -Fqx "$name"; then
      UNKNOWN=1
      bad "$name is installed at $dir but is not in vendor.json; a retired package left on disk can still be loaded if it is re-added to settings (rm -rf '$dir')"
    fi
  done
fi
[[ "$UNKNOWN" == "0" ]] && ok "no retired or unrecognized local packages"

say ""
say "Pi and agent-browser"
# lib/versions.json is the single source of truth for both versions. An installation
# that has drifted from the pin means something bypassed the installer (`pi update`, a
# manual `bun add --global`), and the next install would silently move it back.
BUN_GLOBAL="${BUN_INSTALL:-$HOME/.bun}/install/global/node_modules"
PINNED_PI="$("$JS" -e 'process.stdout.write(String(require(process.argv[1] + "/lib/versions.json").pi ?? ""))' "$REPO_DIR")"
PINNED_PI_AI="$("$JS" -e 'process.stdout.write(String(require(process.argv[1] + "/lib/versions.json").piAi ?? ""))' "$REPO_DIR")"
PINNED_AB="$("$JS" -e 'process.stdout.write(String(require(process.argv[1] + "/lib/versions.json").agentBrowser ?? ""))' "$REPO_DIR")"
PINNED_PI_SERVER="$("$JS" -e 'process.stdout.write(String(require(process.argv[1] + "/lib/versions.json").piServer ?? ""))' "$REPO_DIR")"
pkg_version() { # pkg_version <package-dir>
  "$JS" -e '
const { existsSync, readFileSync } = require("node:fs");
const path = process.argv[1] + "/package.json";
if (!existsSync(path)) process.exit(0);
try { process.stdout.write(String(JSON.parse(readFileSync(path, "utf8")).version ?? "")); } catch {}
' "$1" 2>/dev/null
}
INSTALLED_PI="$(pkg_version "$BUN_GLOBAL/@earendil-works/pi-coding-agent")"
INSTALLED_PI_AI="$(pkg_version "$BUN_GLOBAL/@earendil-works/pi-ai")"
INSTALLED_AB="$(pkg_version "$BUN_GLOBAL/agent-browser")"
INSTALLED_PI_SERVER="$(pkg_version "$BUN_GLOBAL/@earendil-works/pi-server")"
# pi-server is not a declared dependency of pi-coding-agent; it is pinned here because
# pi 0.85.0 imports it from its Bun entrypoint graph (see lib/versions.json). An empty
# pin is allowed while pi does not need it, but a pin without an install breaks every pi run.
VERSION_ENTRIES=("Pi|$PINNED_PI|$INSTALLED_PI" "Pi AI|$PINNED_PI_AI|$INSTALLED_PI_AI" "agent-browser|$PINNED_AB|$INSTALLED_AB")
if [[ -n "$PINNED_PI_SERVER" ]]; then
  VERSION_ENTRIES+=("Pi Server|$PINNED_PI_SERVER|$INSTALLED_PI_SERVER")
fi
for entry in "${VERSION_ENTRIES[@]}"; do
  IFS='|' read -r NAME PINNED INSTALLED <<< "$entry"
  if [[ -z "$PINNED" ]]; then
    bad "could not read the $NAME version pinned in lib/versions.json"
  elif [[ -z "$INSTALLED" ]]; then
    bad "$NAME is pinned at $PINNED but is not installed under $BUN_GLOBAL (run the installer)"
    fixable install
  elif [[ "$INSTALLED" == "$PINNED" ]]; then
    ok "$NAME $INSTALLED matches the version lib/versions.json pins"
  else
    bad "$NAME $INSTALLED is installed but lib/versions.json pins $PINNED; the next install would change it. Update the pin or reinstall."
    fixable install
  fi
done

PI_AI_ROOT="$BUN_GLOBAL/@earendil-works/pi-ai"
PI_AI_VERIFIER="$REPO_DIR/bin/verify-pi-ai-reasoning-fix"
PI_AI_VERIFY_REPORT=""
# The verifier is an ESM script with top-level await and a bun shebang. $JS may have
# resolved to node (it is preferred above because a machine can have Node.js without
# this setup), and node cannot load it as .js without "type": "module", so it must
# run under bun. The installer guarantees bun, so look for it explicitly.
BUN_BIN=""
if command -v bun >/dev/null 2>&1; then
  BUN_BIN="$(command -v bun)"
elif [[ -x "${BUN_INSTALL:-$HOME/.bun}/bin/bun" ]]; then
  BUN_BIN="${BUN_INSTALL:-$HOME/.bun}/bin/bun"
elif [[ -x "${BUN_INSTALL:-$HOME/.bun}/bin/bun.exe" ]]; then
  BUN_BIN="${BUN_INSTALL:-$HOME/.bun}/bin/bun.exe"
fi
if [[ -n "$BUN_BIN" && -f "$PI_AI_VERIFIER" ]] \
  && PI_AI_VERIFY_REPORT="$("$BUN_BIN" "$PI_AI_VERIFIER" "$PI_AI_ROOT" 2>&1)"; then
  ok "Pi AI reasoning-details stream concatenation and historical replay normalization are installed"
else
  if [[ -z "$BUN_BIN" ]]; then
    PI_AI_VERIFY_REPORT="bun is not on PATH or under BUN_INSTALL, so the verifier could not run"
  fi
  bad "Pi AI $PINNED_PI_AI failed the reasoning-details behavior check${PI_AI_VERIFY_REPORT:+: $PI_AI_VERIFY_REPORT} (run ./install.sh)"
  fixable install
fi

# The npm entrypoint (dist/bundle/cli.js) loads pi-ai from the bundle chunk,
# not node_modules; it needs the same fix applied via bin/patch-pi-bundle.
PI_BUNDLE_CHUNK="$(ls "$BUN_GLOBAL/@earendil-works/pi-coding-agent/dist/bundle/chunks/"openai-completions-*.js 2>/dev/null | head -n 1)"
if [[ -n "$PI_BUNDLE_CHUNK" ]]; then
  if grep -q 'normalizeOpenAIReasoningDetails' "$PI_BUNDLE_CHUNK" \
    && ! grep -q 'preservedDetails.push(detail)' "$PI_BUNDLE_CHUNK"; then
    ok "Pi bundle entrypoint carries the reasoning-details fix"
  else
    bad "Pi dist/bundle entrypoint is missing the reasoning-details fix (run ./install.sh)"
    fixable install
  fi
fi

say ""
say "Compaction settings"
COMPACTION_REPORT="$("$JS" -e '
const { readFileSync, existsSync } = require("node:fs");
const [settingsPath, storePath, policyPath] = process.argv.slice(1);
const read = (p) => (existsSync(p) ? JSON.parse(readFileSync(p, "utf8")) : {});
const settings = read(settingsPath);
const compaction = settings.compaction ?? {};
const reserve = typeof compaction.reserveTokens === "number" ? compaction.reserveTokens : 16384;
if (compaction.enabled === false) {
  console.log("bad\tcompaction is disabled in " + settingsPath + "; a long run will hit the context limit and stop instead of compacting. Set compaction.enabled true, or drop the key to take the default.");
  process.exit(0);
}
const store = read(storePath);
const wanted = settings.defaultModel;
let win;
for (const provider of Object.values(store)) {
  for (const m of provider?.models ?? []) {
    if (m?.id === wanted && typeof m.contextWindow === "number") { win = m.contextWindow; break; }
  }
  if (win) break;
}
if (!win) { console.log("ok\treserveTokens " + reserve + " (context window for " + wanted + " unknown; not checked)"); process.exit(0); }
const threshold = win - reserve;
// Compaction fires at contextWindow - reserveTokens, so a reserve near the window leaves
// almost no usable context and produces a summarization request that stalls.
if (threshold <= 0) {
  console.log("bad\tcompaction.reserveTokens is " + reserve + " in " + settingsPath + ", at or above the " + win + "-token window for " + wanted + ", so compaction can never leave usable context. Delete the key and re-run ./install.sh.");
  process.exit(0);
}
if (reserve > win / 2) {
  console.log("bad\tcompaction.reserveTokens is " + reserve + " in " + settingsPath + ", over half the " + win + "-token window for " + wanted + ": compaction fires at " + threshold + " tokens and the summarization request can stall. Delete the key and re-run ./install.sh.");
  process.exit(0);
}
// The lower bound is the one that actually bit. Pi only tests the threshold between turns,
// so the reserve has to absorb a whole agentic turn; config/compaction.json carries the
// policy and the measurement behind it, and install.sh applies the same formula.
const policy = read(policyPath);
const floor = typeof policy.minReserveTokens === "number" ? policy.minReserveTokens : 16384;
let target = typeof policy.reserveTokens === "number" ? policy.reserveTokens : floor;
if (typeof policy.maxFractionOfWindow === "number") target = Math.min(target, Math.floor(win * policy.maxFractionOfWindow));
target = Math.max(floor, target);
if (reserve < target) {
  console.log("bad\tcompaction.reserveTokens is " + reserve + " in " + settingsPath + ", so compaction waits until " + threshold + " tokens. Pi only checks after an agent run finishes, and one run has been measured adding ~25000 tokens past the threshold, taking a " + win + "-token context to 290536. config/compaction.json wants at least " + target + " (bin/pi-setup-doctor --fix).");
  process.exit(0);
}
console.log("ok\treserveTokens " + reserve + " of a " + win + "-token window (compaction at ~" + threshold + " tokens; slack for one long run, not a bound - see docs/LONG_RUNS.md)");
' "$SETTINGS" "$MAIN_DIR/models-store.json" "$REPO_DIR/config/compaction.json" 2>/dev/null)"
if [[ -z "$COMPACTION_REPORT" ]]; then
  note "could not evaluate compaction settings"
else
  while IFS=$'\t' read -r kind message; do
    [[ -z "${kind:-}" ]] && continue
    if [[ "$kind" == "ok" ]]; then
      ok "$message"
    else
      bad "$message"
      # A reserve below the policy floor is what a reinstall writes; the other compaction
      # problems are hand-edited values that --fix would only raise, never lower.
      [[ "$message" == *"config/compaction.json wants at least"* ]] && fixable install
    fi
  done <<< "$COMPACTION_REPORT"
fi

if [[ "$OFFLINE" == "0" ]] && command -v npm >/dev/null 2>&1; then
  say ""
  say "Upstream releases"
  for entry in "@earendil-works/pi-coding-agent|$PINNED_PI" "agent-browser|$PINNED_AB"; do
    IFS='|' read -r PKG PINNED <<< "$entry"
    LATEST="$(npm view "$PKG" version 2>/dev/null | tail -1)"
    if [[ -z "$LATEST" ]]; then
      note "could not query $PKG from the registry"
    elif [[ "$LATEST" == "$PINNED" ]]; then
      ok "$PKG is current at $PINNED"
    else
      note "$PKG upstream is $LATEST, this repository pins $PINNED (see the update-pi-setup skill)"
    fi
  done
  for fork in $FORK_NAMES; do
    # A first-party entry has an empty upstream. The delimiter must be a
    # non-whitespace character: IFS collapses leading empty fields for whitespace
    # delimiters, which would shift the version into UPSTREAM and query the
    # registry for it.
    IFS='|' read -r UPSTREAM PINNED REVIEWED < <("$JS" -e '
const v = require(process.argv[1] + "/vendor.json").forks[process.argv[2]];
process.stdout.write((v.upstream ?? "") + "|" + (v.version ?? "") + "|" + (v.reviewedAgainst ?? "") + "\n");
' "$REPO_DIR" "$fork")
    # A first-party package (upstream: null) has no release to compare against.
    if [[ -z "$UPSTREAM" ]]; then
      ok "$fork is first-party (no upstream to track)"
      continue
    fi
    LATEST="$(npm view "$UPSTREAM" version 2>/dev/null | tail -1)"
    if [[ -z "$LATEST" ]]; then
      note "could not query $UPSTREAM from the registry"
    elif [[ "$LATEST" == "$PINNED" ]]; then
      ok "$UPSTREAM is current at $PINNED"
    elif [[ -n "$REVIEWED" && "$LATEST" == "$REVIEWED" ]]; then
      # "Based on" and "reviewed against" are different claims. A hand-maintained fork can
      # deliberately decline a release — 2.0.0 is built on persistence this fork does not
      # have — and saying so once beats a note that repeats forever and teaches the reader
      # to skip notes. The next release still reports, because reviewedAgainst will no
      # longer equal latest.
      ok "$UPSTREAM $LATEST reviewed and declined; fork stays on $PINNED (see vendor.json)"
    else
      # A fork with no patch file is hand-maintained; pi-setup-vendor refuses to re-vendor
      # it, so suggesting the command would send the reader down a path that always fails.
      PATCH_REL="$("$JS" -e '
const v = require(process.argv[1] + "/vendor.json").forks[process.argv[2]];
process.stdout.write(v.patch ?? "");
' "$REPO_DIR" "$fork")"
      if [[ -n "$PATCH_REL" ]]; then
        note "$UPSTREAM upstream is $LATEST, fork is based on $PINNED (bin/pi-setup-vendor $fork $LATEST)"
      else
        note "$UPSTREAM upstream is $LATEST, fork is based on $PINNED (hand-maintained: port changes by hand and record the review in vendor.json)"
      fi
    fi
  done
fi

say ""
if [[ "$PROBLEMS" -gt 0 && "$FIX" == "1" ]]; then
  printf '\nRepairing what can be repaired mechanically.\n'
  if [[ -n "$FIXABLE_STT" ]]; then
    if is_windows; then
      printf '  skipped  chmod 600 %s (Unix file modes are not used on Windows)\n' "$FIXABLE_STT"
    elif chmod 600 "$FIXABLE_STT" 2>/dev/null; then
      printf '  fixed    chmod 600 %s\n' "$FIXABLE_STT"
      FIXED=$((FIXED + 1))
    else
      printf '  failed   could not chmod 600 %s\n' "$FIXABLE_STT"
    fi
  fi
  if [[ "$NEEDS_INSTALL" == "1" ]]; then
    FIX_LOG="${TMPDIR:-${TMP:-${TEMP:-/tmp}}}/pi-setup-fix.log"
    if is_windows && [[ -f "$REPO_DIR/install.ps1" ]]; then
      printf '  running  %s/install.ps1 (Chrome check skipped)\n' "$REPO_DIR"
      PS1="$REPO_DIR/install.ps1"
      command -v cygpath >/dev/null 2>&1 && PS1="$(cygpath -w "$PS1")"
      if PI_SETUP_SKIP_BROWSER_INSTALL=1 powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$PS1" >"$FIX_LOG" 2>&1; then
        printf '  fixed    reinstalled from forks/\n'
        FIXED=$((FIXED + 1))
      else
        printf '  failed   install.ps1 exited non-zero; see %s\n' "$FIX_LOG"
      fi
    elif [[ -f "$REPO_DIR/install.sh" ]]; then
      printf '  running  %s/install.sh (Chrome check skipped)\n' "$REPO_DIR"
      if PI_SETUP_SKIP_BROWSER_INSTALL=1 bash "$REPO_DIR/install.sh" >"$FIX_LOG" 2>&1; then
        printf '  fixed    reinstalled from forks/\n'
        FIXED=$((FIXED + 1))
      else
        printf '  failed   install.sh exited non-zero; see %s\n' "$FIX_LOG"
      fi
    else
      printf '  failed   installer is missing in %s\n' "$REPO_DIR"
    fi
  fi
  if [[ "$FIXED" == "0" ]]; then
    printf '\nNothing was mechanically fixable. The problems above need a decision.\n'
    printf '%s problem(s), %s note(s).\n' "$PROBLEMS" "$NOTES"
    exit 1
  fi
  # Re-check from scratch: a repair invalidates every result gathered before it.
  printf '\nRe-checking.\n'
  exec "$0" $([[ "$QUIET" == "1" ]] && printf -- --quiet) $([[ "$OFFLINE" == "1" ]] && printf -- --offline)
fi
if [[ "$PROBLEMS" -gt 0 ]]; then
  if [[ "$FIX" == "0" ]]; then
    printf 'Some of these may be mechanically fixable: bin/pi-setup-doctor --fix\n'
  fi
  printf '%s problem(s), %s note(s).\n' "$PROBLEMS" "$NOTES"
  exit 1
fi
if [[ "$QUIET" == "1" ]]; then
  [[ "$NOTES" -gt 0 ]] && printf '%s note(s).\n' "$NOTES"
  exit 0
fi
printf 'No problems. %s note(s).\n' "$NOTES"
exit 0
