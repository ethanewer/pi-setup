#!/usr/bin/env bash
# Check that the installed Pi setup still matches this repository.
#
#   bin/pi-setup-doctor            full report
#   bin/pi-setup-doctor --quiet    only problems
#   bin/pi-setup-doctor --offline  skip the npm registry check for upstream releases
#
# Exits non-zero when anything is wrong, so it can gate CI or a shell prompt.
set -uo pipefail

QUIET=0
OFFLINE=0
for arg in "$@"; do
  case "$arg" in
    --quiet) QUIET=1 ;;
    --offline) OFFLINE=1 ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf 'pi-setup-doctor: unknown argument %s\n' "$arg" >&2; exit 2 ;;
  esac
done

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MAIN_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
LOCAL_PKG_DIR="$MAIN_DIR/local"

PROBLEMS=0
NOTES=0
say() { [[ "$QUIET" == "1" ]] || printf '%s\n' "$*"; }
ok() { [[ "$QUIET" == "1" ]] || printf '  ok       %s\n' "$*"; }
note() { NOTES=$((NOTES + 1)); printf '  note     %s\n' "$*"; }
bad() { PROBLEMS=$((PROBLEMS + 1)); printf '  PROBLEM  %s\n' "$*"; }

command -v node >/dev/null 2>&1 || { printf 'pi-setup-doctor: node is required\n' >&2; exit 2; }

FORK_NAMES="$(node -e '
const v = require(process.argv[1] + "/vendor.json");
console.log(Object.keys(v.forks).join(" "));
' "$REPO_DIR")" || { printf 'pi-setup-doctor: could not read vendor.json\n' >&2; exit 2; }

say ""
say "Forks: repository vs installed"
for fork in $FORK_NAMES; do
  SRC="$REPO_DIR/forks/$fork"
  DST="$LOCAL_PKG_DIR/$fork"
  if [[ ! -d "$SRC" ]]; then
    bad "$fork is listed in vendor.json but missing from forks/"
    continue
  fi
  if [[ ! -d "$DST" ]]; then
    bad "$fork is not installed at $DST (run install.sh)"
    continue
  fi
  # .git is present when a fork was installed from its own checkout; node_modules and
  # bun.lock are produced by the dependency install. None is part of the fork's content.
  DIFF="$(diff -rq --exclude=node_modules --exclude=.git --exclude=bun.lock "$SRC" "$DST" 2>&1)"
  if [[ -z "$DIFF" ]]; then
    ok "$fork matches the installed copy"
  else
    bad "$fork differs from the installed copy:"
    printf '%s\n' "$DIFF" | sed 's/^/             /' | head -20
  fi
done

say ""
say "Pi settings"
SETTINGS="$MAIN_DIR/settings.json"
if [[ ! -f "$SETTINGS" ]]; then
  bad "missing $SETTINGS"
else
  SETTINGS_REPORT="$(node -e '
const { readFileSync } = require("node:fs");
const [settingsPath, repoDir] = process.argv.slice(1);
const vendor = require(repoDir + "/vendor.json");
const settings = JSON.parse(readFileSync(settingsPath, "utf8"));
const identity = (entry) => {
  const source = typeof entry === "string" ? entry : entry?.source;
  if (typeof source !== "string") return "";
  let spec = source.replace(/^npm:/, "");
  if (spec.startsWith("local/")) return spec.slice("local/".length);
  if (spec.startsWith("@")) return spec.split("@").slice(0, 2).join("@");
  return spec.split("@")[0];
};
const entries = settings.packages ?? [];
const ids = entries.map(identity);
const out = [];
for (const fork of Object.keys(vendor.forks)) {
  if (ids.includes(fork)) out.push("ok\tsettings load local/" + fork);
  else out.push("bad\tsettings do not load local/" + fork);
}
for (const [fork, meta] of Object.entries(vendor.forks)) {
  if (ids.includes(meta.upstream)) {
    out.push("bad\tsettings still load the unpatched npm package " + meta.upstream + " (it can shadow the fork)");
  }
}
console.log(out.join("\n"));
' "$SETTINGS" "$REPO_DIR")"
  while IFS=$'\t' read -r kind message; do
    [[ -z "${kind:-}" ]] && continue
    [[ "$kind" == "ok" ]] && ok "$message" || bad "$message"
  done <<< "$SETTINGS_REPORT"
fi

say ""
say "Configuration hygiene"
STT="$MAIN_DIR/stt.json"
if [[ -f "$STT" ]]; then
  MODE="$(stat -f '%Lp' "$STT" 2>/dev/null || stat -c '%a' "$STT" 2>/dev/null)"
  if [[ "$MODE" == "600" ]]; then
    ok "stt.json is owner-only (600)"
  else
    bad "stt.json is mode $MODE; it selects the transcription host and capture binary, so it should be 600 (chmod 600 $STT)"
  fi
fi

TRUST="$MAIN_DIR/trust.json"
if [[ -f "$TRUST" ]]; then
  TRUST_REPORT="$(node -e '
const { readFileSync } = require("node:fs");
const { homedir } = require("node:os");
const trust = JSON.parse(readFileSync(process.argv[1], "utf8"));
const home = homedir();
const broad = Object.entries(trust)
  .filter(([path, decision]) => decision === true && (path === home || path === "/" || home.startsWith(path + "/")))
  .map(([path]) => path);
console.log(broad.join("\n"));
' "$TRUST" 2>/dev/null)"
  if [[ -z "$TRUST_REPORT" ]]; then
    ok "no home-wide project-trust entries"
  else
    while read -r entry; do
      [[ -z "$entry" ]] && continue
      bad "trust.json trusts $entry, and Pi inherits trust down the directory tree, so every repository under it is trusted without a prompt. Prefer per-repository entries."
    done <<< "$TRUST_REPORT"
  fi
fi

say ""
say "Retired and unknown local packages"
UNKNOWN=0
if [[ -d "$LOCAL_PKG_DIR" ]]; then
  for dir in "$LOCAL_PKG_DIR"/*; do
    [[ -d "$dir" ]] || continue
    name="$(basename "$dir")"
    if ! printf '%s\n' $FORK_NAMES | grep -Fqx "$name"; then
      UNKNOWN=1
      bad "$name is installed at $dir but is not in vendor.json; a retired package left on disk can still be loaded if it is re-added to settings (rm -rf '$dir')"
    fi
  done
fi
[[ "$UNKNOWN" == "0" ]] && ok "no retired or unrecognized local packages"

say ""
say "Compaction settings"
COMPACTION_REPORT="$(node -e '
const { readFileSync, existsSync } = require("node:fs");
const [settingsPath, storePath] = process.argv.slice(1);
const read = (p) => (existsSync(p) ? JSON.parse(readFileSync(p, "utf8")) : {});
const settings = read(settingsPath);
const compaction = settings.compaction ?? {};
const reserve = typeof compaction.reserveTokens === "number" ? compaction.reserveTokens : 16384;
if (compaction.enabled === false) {
  console.log("bad\tcompaction is disabled; a long run will hit the context limit and stop instead of compacting");
  process.exit(0);
}
// Compaction fires at contextWindow - reserveTokens, so a reserve near the window
// leaves almost no usable context and produces a summarization request that stalls.
const store = read(storePath);
const wanted = settings.defaultModel;
let win;
for (const provider of Object.values(store)) {
  for (const m of provider?.models ?? []) {
    if (m?.id === wanted && typeof m.contextWindow === "number") { win = m.contextWindow; break; }
  }
  if (win) break;
}
if (!win) { console.log("ok\treserveTokens " + reserve + " (context window for " + wanted + " unknown; not checked)"); process.exit(0); }
const threshold = win - reserve;
if (threshold <= 0) console.log("bad\treserveTokens " + reserve + " >= context window " + win + " for " + wanted + "; compaction can never leave usable context");
else if (reserve > win / 2) console.log("bad\treserveTokens " + reserve + " is over half the " + win + "-token window for " + wanted + "; compaction would fire at " + threshold + " tokens and the summarization request can stall");
else console.log("ok\treserveTokens " + reserve + " of a " + win + "-token window (compaction at ~" + threshold + " tokens)");
' "$SETTINGS" "$MAIN_DIR/models-store.json" 2>/dev/null)"
if [[ -z "$COMPACTION_REPORT" ]]; then
  note "could not evaluate compaction settings"
else
  while IFS=$'\t' read -r kind message; do
    [[ -z "${kind:-}" ]] && continue
    [[ "$kind" == "ok" ]] && ok "$message" || bad "$message"
  done <<< "$COMPACTION_REPORT"
fi

if [[ "$OFFLINE" == "0" ]] && command -v npm >/dev/null 2>&1; then
  say ""
  say "Upstream releases"
  for fork in $FORK_NAMES; do
    # A first-party entry has an empty upstream. The delimiter must be a
    # non-whitespace character: IFS collapses leading empty fields for whitespace
    # delimiters, which would shift the version into UPSTREAM and query the
    # registry for it.
    IFS='|' read -r UPSTREAM PINNED < <(node -e '
const v = require(process.argv[1] + "/vendor.json").forks[process.argv[2]];
process.stdout.write((v.upstream ?? "") + "|" + (v.version ?? "") + "\n");
' "$REPO_DIR" "$fork")
    # A first-party package (upstream: null) has no release to compare against.
    if [[ -z "$UPSTREAM" ]]; then
      ok "$fork is first-party (no upstream to track)"
      continue
    fi
    LATEST="$(npm view "$UPSTREAM" version 2>/dev/null | tail -1)"
    if [[ -z "$LATEST" ]]; then
      note "could not query $UPSTREAM from the registry"
    elif [[ "$LATEST" == "$PINNED" ]]; then
      ok "$UPSTREAM is current at $PINNED"
    else
      note "$UPSTREAM upstream is $LATEST, fork is based on $PINNED (bin/pi-setup-vendor $fork $LATEST)"
    fi
  done
fi

say ""
if [[ "$PROBLEMS" -gt 0 ]]; then
  printf '%s problem(s), %s note(s).\n' "$PROBLEMS" "$NOTES"
  exit 1
fi
if [[ "$QUIET" == "1" ]]; then
  [[ "$NOTES" -gt 0 ]] && printf '%s note(s).\n' "$NOTES"
  exit 0
fi
printf 'No problems. %s note(s).\n' "$NOTES"
exit 0
