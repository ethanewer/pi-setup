#!/usr/bin/env python3
"""
convert_pi_traces.py
====================

Convert every pi coding-agent trace on this machine into the row format used by
the private HuggingFace dataset `eewer/glm-5.2-multi-harness-agent` (default /
"pi" coding-agent config), then optionally upload the result -- compressed with
zstd to save space -- to the `eewer/pi-trace-cache` dataset, if a HuggingFace
access token with write access is present.

What counts as a "pi trace"
----------------------------
A pi session is a JSONL event stream whose first line is
`{"type":"session","version":3,"id":...,"timestamp":...,"cwd":...}` and whose
subsequent lines are events of `type` in {model_change, thinking_level_change,
message, custom_message, custom, compaction}. The script discovers these by
walking the configured roots and by extracting the session-archives tarballs.

Target row schema (matches glm-5.2-multi-harness-agent default config)
------------------------------------------------------------------------
One JSON object per converted trace. `messages` is rendered in OpenAI chat
format (system/user/assistant/tool), the same convention the reference dataset
uses for `harness == "pi"` rows:
  * user      -> {role:"user",      content:[{type:"text", text}]}
  * assistant -> {role:"assistant", content:str|null, reasoning_content:str,
                  tool_calls:[{id,type:"function",function:{name,arguments}}],
                  reasoning_tokens?, reasoning_status?}
  * tool      -> {role:"tool", content:str, tool_call_id:str}
System prompts are NOT persisted in pi session traces, so no system message is
emitted (the reference rows had one only because data-gen captured it).

Filtering
---------
Traces whose effective model is an OpenAI model are dropped (provider ==
"openai", or model id matches the OpenAI family: gpt-*, o1/o3/o4-*, chatgpt-*,
text-*, davinci/curie/babbage/ada, openai/*). The effective model is the last
`model_change` event (falling back to the last assistant turn); a trace whose
every assistant turn is OpenAI is also dropped.

A conservative detector quarantines the `pi-ai 0.84.3` newline-reasoning
regression. At the first severe token-fragment split in an assistant reasoning
block, the exported conversation is cut before that assistant turn. Its clean
prefix remains usable; the affected response and contaminated suffix do not.
If no clean assistant turn precedes the defect, the row is excluded. Raw session
files are never rewritten. A deterministic exclusion manifest records every
cut or exclusion, and the same policy is re-applied to existing remote rows
before a union shard replaces them.

Monitor-bench eval traces
-------------------------
In addition to pi session files, the tool ingests monitor-bench eval runs
(evals/monitor/results in ~/pi-setup* checkouts, with a fallback to the older
evals/results layout; headless runs leave only
transcript.jsonl, no session files). Policy: only runs that PERFECTLY pass
(every scorer check, clean fixture integrity, correct monitor adoption, zero
bash blocking) are converted; at most 5 traces per task (task == prompt);
when more qualify, version diversity across the monitor extension is
preferred and the shortest traces win. Same model invariants and redaction
apply. --no-eval disables this; --eval-cap changes the per-task cap.

Upload
------
If HF_TOKEN (or HUGGING_FACE_HUB_TOKEN) is set and the token has `write` access,
the compressed `.jsonl.zst` shard(s), dataset card, and current sanitization
manifest are uploaded to `eewer/pi-trace-cache` (repo_type=dataset). `*.zst` is
already LFS-tracked there. `--no-upload` skips.

Usage
-----
  python3 convert_pi_traces.py                 # convert + upload
  python3 convert_pi_traces.py --dry-run       # convert only, print summary
  python3 convert_pi_traces.py --no-upload     # convert, write local files, no upload
  python3 convert_pi_traces.py --scan-home     # also walk all of ~ (slower)
  python3 convert_pi_traces.py --max-files 20  # cap discovered traces (debug)
  python3 convert_pi_traces.py --no-eval       # skip monitor-bench eval traces
  python3 convert_pi_traces.py --eval-cap 3    # at most 3 eval traces per task
  python3 convert_pi_traces.py --keep-newline-reasoning  # unsafe forensic export only
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import string
import subprocess
import sys
import tarfile
import tempfile
from collections import Counter
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Iterable

try:
    import zstandard as zstd  # type: ignore
except Exception:  # pragma: no cover
    zstd = None

# --------------------------------------------------------------------------- #
# Constants
# --------------------------------------------------------------------------- #

HOME = Path.home()

DEFAULT_ROOTS = [
    HOME / ".pi" / "agent" / "sessions",
    # piwf (workflow profile) persists workflow subagent transcripts under its
    # own agent dir (PI_CODING_AGENT_DIR), not the shared sessions dir.
    HOME / ".pi" / "agent-wf" / "sessions",
    HOME / "mk-sessions",
    Path("/tmp"),
    Path("/private/tmp"),
]

# Always also pull the archived sessions out of the pi session-archives dir.
DEFAULT_ARCHIVE_GLOBS = [
    HOME / ".pi" / "agent" / "session-archives",
    HOME / ".pi" / "agent-wf" / "session-archives",
]

UPLOAD_REPO = "eewer/pi-trace-cache"
DEFAULT_OUT = HOME / "pi-trace-cache-tool" / "out"

ZSTD_LEVEL = 19  # high ratio; the reference dataset ships .jsonl.zst

NEWLINE_REASONING_POLICY = "pi-ai-0.84.3-newline-reasoning-v1"
NEWLINE_REASONING_MANIFEST_REPO_PATH = "manifests/newline-reasoning-v1.jsonl"
DATASET_CARD_REPO_PATH = "README.md"
DATASET_CARD = """---
pretty_name: Pi Trace Cache
---

# Pi Trace Cache

Private, redacted Pi coding-agent traces used as source material for dataset
construction. Raw session files remain outside this repository; uploaded files
are derived exports.

## Newline-reasoning quarantine

Rows are screened for the `pi-ai 0.84.3` fragmented-reasoning regression. At
the first severe token-fragment split, the exported conversation is truncated
before the affected assistant turn. The affected turn and every later turn are
excluded because they were conditioned on malformed replay context. A row with
no clean assistant turn before the defect is omitted entirely.

The pipeline does not delete or join newline characters. Some newlines are
valid prose, Markdown, or code, and the malformed newlines were model output
triggered by a bad replay structure rather than display-only corruption.

`manifests/newline-reasoning-v1.jsonl` records each truncated or excluded trace,
the first affected message index, and detector metrics. The original local
trace archive is immutable and is not uploaded by this pipeline.
"""

# Directories to never descend into while walking for traces.
SKIP_DIRS = {
    "node_modules", ".git", ".svn", ".hg", "Library", "Pictures", "Movies",
    "Music", ".Trash", ".cache", "site-packages", "dist", "build", ".next",
    "__pycache__", ".venv", "venv", ".tox", ".mypy_cache", ".pytest_cache",
}

# OpenAI model family detection.
OPENAI_MODEL_RE = re.compile(
    r"^(gpt-|o\d|-gpt|chatgpt-|text-embedding-|text-davinci-|davinci-|"
    r"curie-|babbage-|ada-|code-davinci-|openai/)",
    re.IGNORECASE,
)

# --------------------------------------------------------------------------- #
# Benchmark-rollout detection
# --------------------------------------------------------------------------- #
#
# A "benchmark rollout" is a session where pi is the agent-under-test in a
# benchmark harness (TerminalBench, tau-bench, SWE-bench, ...) rather than a
# real interactive dev session. We exclude these from the dataset.
#
# Detection is deliberately conservative: a dev session that merely *mentions*
# "terminalbench" (reading docs, writing eval code, discussing results) is NOT
# a rollout. A rollout is identified by *structural* signatures that only appear
# when a harness drives the agent:
#   1. The first user message IS a known harness prompt template.
#   2. Recurring per-turn harness feedback (>=2 turns).
#   3. Orchestrator env vars set as real `VAR=value` assignments (not string
#      mentions) in an env-dump tool result.
#   4. A container/sandbox cwd (/, /testbed, /root, /workspace) combined with
#      an impersonal task-like first user message.

# TerminalBench (terminus / justbash) harness prompt signatures.
TB_TEMPLATE_OPENERS = [
    "ai assistant tasked with solving command-line tasks in a linux environment",
    "your goal is to solve the task by providing batches of shell commands",
]
TB_TURN_MARKERS = [
    "current terminal state:",            # per-turn rendered prompt
    "are you sure you want to mark the task as complete",  # completion confirm
    "previous response had warnings:",   # warning feedback
]
TB_ENV_VARS = [
    "TB_TASK_ID", "TERMINALBENCH_TASK_ID", "TERMINAL_BENCH_TASK_ID",
]
# A terminal-bench task-name identifier, e.g. `terminal-bench/path-tracing`.
TB_TASKNAME_RE = re.compile(r"terminal-bench/[a-z0-9][a-z0-9_-]*", re.IGNORECASE)

# Other known agent-benchmark harness prompt signatures (first-user-message).
OTHER_HARNESS_OPENERS = [
    ("tau-bench", "you are a customer service agent"),
    ("tau-bench", "you are a customer service representative"),
    ("tau2-bench", "you are a customer service agent"),
    ("webshop", "you are shopping on the internet"),
    ("alfworld", "you are interacting with a household simulator"),
]

# Orchestrator env vars that indicate a benchmark harness launched the run.
OTHER_ORCHESTRATOR_ENV_VARS = [
    "HARNESS", "BENCHMARK", "AGENT_EVAL", "EVAL_TASK_ID",
]

# Sandbox / container cwd patterns typical of benchmark task containers.
SANDBOX_CWD_RE = re.compile(r"^(/|/testbed|/root|/workspace|/tmp/agent[^/]*)$")

# Personal-language openers that indicate a *human* dev request, not a bare
# task prompt. Used only to disambiguate weak signals (container cwd +
# task-name mention) so we don't drop real dev work on benchmark repos.
PERSONAL_OPENER_RE = re.compile(
    r"^(i want|i'd|i would|can you|could you|please|how|why|what|review|let'?s|"
    r"investigate|explain|compare|find|show|tell|write|run|add|fix|update|"
    r"make|build|set up|configure|deploy|debug|check|merge|explore)\b",
    re.IGNORECASE,
)

# Env-var assignment regex: VAR=... (used to detect real env values, not
# prose mentions of a variable name).
ENV_ASSIGN_RE = re.compile(
    r"(?:^|[\s\"'`])([A-Z][A-Z0-9_]*)=([A-Za-z0-9_./:+-]{8,})",
    re.MULTILINE,
)


def _collect_texts(events: list[dict]) -> tuple[str, list[str], list[str]]:
    """Return (first_user_text, all_user_texts, all_toolresult_texts)."""
    user_texts: list[str] = []
    tool_texts: list[str] = []
    first_user = ""
    for ev in events:
        if ev.get("type") != "message":
            continue
        m = ev.get("message") or {}
        role = m.get("role")
        content = m.get("content") or []
        if role == "user":
            parts = [
                str(b.get("text") or "")
                for b in content
                if isinstance(b, dict) and b.get("type") == "text"
            ]
            t = "\n".join(parts)
            if t.strip():
                if not first_user:
                    first_user = t
                user_texts.append(t)
        elif role == "toolResult":
            parts = [
                str(b.get("text") or "")
                for b in content
                if isinstance(b, dict) and b.get("type") == "text"
            ]
            tool_texts.append("\n".join(parts))
    return first_user, user_texts, tool_texts


def detect_benchmark_rollout(events: list[dict], cwd: str) -> str | None:
    """Return a rollout reason string if the session is a benchmark rollout,
    else None. Conservative: dev sessions discussing benchmarks are kept."""
    first_user, user_texts, tool_texts = _collect_texts(events)
    fu_lower = first_user.lower()
    all_blob = "\n".join(user_texts + tool_texts)

    # --- TerminalBench (terminus/justbash) ----------------------------- #
    # 1. First user message IS the TB harness prompt template.
    if any(sig in fu_lower for sig in TB_TEMPLATE_OPENERS):
        return "terminalbench"

    # 2. Recurring per-turn TB feedback (>=2 turns) — distinguishes a real
    #    rollout from a dev session that pasted one TB snippet.
    tb_turn_hits = sum(
        1 for t in user_texts
        if any(m in t.lower() for m in TB_TURN_MARKERS)
    )
    if tb_turn_hits >= 2:
        return "terminalbench"

    # 3. TB orchestrator env vars assigned as real VAR=value (in env dumps).
    env_set = {
        name for name, _ in ENV_ASSIGN_RE.findall(all_blob)
    }
    if any(v in env_set for v in TB_ENV_VARS):
        return "terminalbench"

    # --- Other known harness prompt signatures (first user message) ---- #
    for _name, opener in OTHER_HARNESS_OPENERS:
        if opener in fu_lower:
            return "benchmark_rollout"

    # --- General orchestrator-driven rollout --------------------------- #
    # Orchestrator env vars + an impersonal (non-human) first user message.
    has_orch = any(v in env_set for v in OTHER_ORCHESTRATOR_ENV_VARS)
    impersonal = bool(first_user.strip()) and not PERSONAL_OPENER_RE.match(first_user.strip())
    if has_orch and impersonal:
        return "benchmark_rollout"

    # --- Container/sandbox rollout ------------------------------------- #
    # A sandbox cwd + an impersonal, task-like first user message + a TB
    # task-name identifier in content. Requires the conjunction so dev work
    # inside benchmark repos (sandbox-ish cwd but human-phrased request) is
    # kept.
    if SANDBOX_CWD_RE.match(cwd or "") and impersonal and TB_TASKNAME_RE.search(all_blob):
        return "terminalbench"

    return None

# --------------------------------------------------------------------------- #
# Smoke / probe session detection
# --------------------------------------------------------------------------- #
#
# A large share of local sessions are installer smoke tests and throwaway
# probes ("test", "echo hi", tool listings, codeword ACKs). They pollute the
# dataset, so rows matching these signatures are dropped:
#
#   * empty content — a converted trace with almost no text at all.
#   * unambiguous harness/probe prompts — matched anywhere in the first user
#     message regardless of trace size (SMOKE-BASH-OK, tool listings, the
#     tests/smoke.sh prompts, codeword probes, system-prompt extraction).
#   * trivial probe prompts ("test", "hi", "echo hi", img.png checks) —
#     dropped only when the whole trace is small, so a real session that
#     happens to open with "test" and runs substantial work is kept.

MIN_TRACE_CHARS = 100          # below this total text volume a row is "empty"
SMOKE_TRIVIAL_MAX_CHARS = 20000  # trivial-prompt rows above this are kept

# Unambiguous smoke/probe signatures, matched against the lowercased first
# user message. Includes every prompt in tests/smoke.sh.
SMOKE_SUBSTRINGS = [
    "smoke-bash-ok",
    "codeword is",
    "union test:",
    "list the name of every tool",
    "list the names of every tool",
    "list all your tools",
    "list your tools",
    "output your system prompt",
    "tell me about your harness",
    "where would you edit to improve your harness",
    "/btw what constant does alpha.ts export",
    "use agent_browser to open https://example.com",
    "open https://example.com in the browser",
    "gamma-delta",
]

# Like SMOKE_SUBSTRINGS, but only applied to small traces, so a substantial
# real session that happens to contain the phrase survives.
SMOKE_SUBSTRINGS_GATED = [
    "run these in bash, one at a time",
    "do these steps exactly",
    "then reply done",
]

# Trivial probe prompts, dropped only when the trace is small. Compared after
# normalizing the first user message (lowercase, strip non-alphanumerics).
SMOKE_TRIVIAL_PROMPTS = {
    "test", "hi", "hello", "echo hi", "echo hello",
    "what is img png", "what is in img png",
    "what is the image file in this directory",
    "reply with exactly ok",
    "what is 2 2 reply with just the number",
    "explain in 2 sentences why ai coding assistants are useful",
}


def _normalize_prompt(s: str) -> str:
    return re.sub(r"[^a-z0-9]+", " ", s.lower()).strip()


def _row_first_user_text(row: dict) -> str:
    for m in row.get("messages") or []:
        if m.get("role") == "user":
            c = m.get("content")
            if isinstance(c, list) and c and isinstance(c[0], dict):
                return str(c[0].get("text") or "")
            if isinstance(c, str):
                return c
            return ""
    return ""


def _row_total_chars(row: dict) -> int:
    n = 0
    for m in row.get("messages") or []:
        role = m.get("role")
        if role == "user":
            c = m.get("content")
            if isinstance(c, list):
                n += sum(len(str(b.get("text") or "")) for b in c if isinstance(b, dict))
            elif isinstance(c, str):
                n += len(c)
        elif role == "assistant":
            n += len(m.get("content") or "") + len(m.get("reasoning_content") or "")
            n += sum(len(json.dumps(tc.get("function", {}).get("arguments") or {}))
                     for tc in (m.get("tool_calls") or []))
        elif role == "tool":
            n += len(m.get("content") or "")
    return n


def smoke_drop_reason(row: dict) -> str | None:
    """Return a drop reason for smoke/empty rows, else None. Never applies to
    monitor-bench eval rows (their admission policy is separate)."""
    if row.get("source") == "local/pi-monitor-bench":
        return None
    tchars = _row_total_chars(row)
    if tchars < MIN_TRACE_CHARS:
        return "empty_content"
    # A trace whose assistant never produced any text or tool call (dead / 
    # degenerate model output) has nothing to learn from.
    asst_output = 0
    for m in row.get("messages") or []:
        if m.get("role") == "assistant":
            asst_output += len(m.get("content") or "")
            asst_output += len(m.get("tool_calls") or [])
    if asst_output == 0:
        return "empty_content"
    first = _row_first_user_text(row)
    fl = first.lower()
    if any(sig in fl for sig in SMOKE_SUBSTRINGS):
        return "smoke_prompt"
    if tchars < SMOKE_TRIVIAL_MAX_CHARS:
        if any(sig in fl for sig in SMOKE_SUBSTRINGS_GATED):
            return "smoke_prompt"
        if _normalize_prompt(first) in SMOKE_TRIVIAL_PROMPTS:
            return "smoke_probe"
    return None


# --------------------------------------------------------------------------- #
# Newline-reasoning quarantine
# --------------------------------------------------------------------------- #


def newline_reasoning_metrics(text: str) -> dict[str, int | float | bool]:
    """Measure severe token-fragment splitting without treating ordinary
    paragraphs, lists, headings, or code layout as corruption."""
    lines = text.split("\n")
    suspicious = 0
    for before, after in zip(lines, lines[1:]):
        left = before.strip()
        right = after.strip()
        if not left or not right:
            continue
        if re.match(r"^(?:[-*#>`]|\d+[.)]\s)", right):
            continue
        if left.endswith((".", ":", ";", "?", "!", "`", "{", "}", "[", "]")):
            continue
        if re.match(r"^(?:[-*#>`]|\d+[.)]\s)", left):
            continue
        # A column of whole words is valid layout (for example, a short
        # checklist without bullets). Token-fragment corruption can also place
        # an occasional word on its own line, but its severe boundaries are the
        # transitions into or out of partial/multi-word fragments.
        if (
            re.fullmatch(r"[^\W\d_]+(?:['’-][^\W\d_]+)*[,.]?", left)
            and re.fullmatch(r"[^\W\d_]+(?:['’-][^\W\d_]+)*[,.]?", right)
        ):
            continue
        if len(left) <= 15 or len(right) <= 15:
            suspicious += 1
    newlines = text.count("\n")
    ratio = newlines / max(len(text), 1)
    severe = newlines >= 3 and ratio >= 0.04 and suspicious >= 2
    return {
        "characters": len(text),
        "newlines": newlines,
        "newline_character_ratio": round(ratio, 6),
        "suspicious_boundaries": suspicious,
        "severe": severe,
    }


def _newline_reasoning_record(row: dict, marker: dict) -> dict:
    return {
        "policy": NEWLINE_REASONING_POLICY,
        "trace_key": str(row.get("trace_key") or ""),
        "source_path": str(row.get("source_path") or ""),
        **marker,
    }


def sanitize_newline_reasoning(row: dict) -> tuple[dict | None, dict | None]:
    """Return a clean-prefix row and deterministic manifest record.

    The detector runs on exported assistant reasoning, so it also sanitizes old
    remote rows whose raw JSONL is unavailable on this machine. Existing marker
    metadata is preserved and re-emitted into the current manifest.
    """
    source_metadata = row.get("source_metadata") or {}
    existing: dict | None = None
    if isinstance(source_metadata, dict):
        candidate = source_metadata.get("newline_reasoning_sanitization")
        if isinstance(candidate, dict) and candidate.get("policy") == NEWLINE_REASONING_POLICY:
            existing = candidate

    messages = row.get("messages") or []
    if not isinstance(messages, list):
        return row, None

    assistant_ordinal = 0
    hit_index: int | None = None
    hit_ordinal: int | None = None
    hit_metrics: dict[str, int | float | bool] | None = None
    for index, message in enumerate(messages):
        if not isinstance(message, dict) or message.get("role") != "assistant":
            continue
        assistant_ordinal += 1
        reasoning = message.get("reasoning_content") or ""
        metrics = newline_reasoning_metrics(str(reasoning))
        if metrics["severe"]:
            hit_index = index
            hit_ordinal = assistant_ordinal
            hit_metrics = metrics
            break

    if hit_index is None or hit_ordinal is None or hit_metrics is None:
        return row, _newline_reasoning_record(row, existing) if existing else None

    prefix = messages[:hit_index]
    retained_assistants = sum(
        1 for message in prefix
        if isinstance(message, dict) and message.get("role") == "assistant"
    )
    action = "truncate_before_first_affected_assistant" if retained_assistants else "exclude_trace"
    marker = {
        "policy": NEWLINE_REASONING_POLICY,
        "action": action,
        "reason": "severe_token_fragment_reasoning",
        "first_affected_message_index": hit_index,
        "first_affected_assistant_ordinal": hit_ordinal,
        "original_message_count": len(messages),
        "retained_message_count": len(prefix) if retained_assistants else 0,
        "dropped_message_count": len(messages) - (len(prefix) if retained_assistants else 0),
        "metrics": hit_metrics,
    }
    record = _newline_reasoning_record(row, marker)
    if not retained_assistants:
        return None, record

    clean = dict(row)
    clean["messages"] = prefix
    clean["api_exchange_count"] = retained_assistants
    for key in (
        "api_completion_tokens", "api_prompt_tokens", "api_total_tokens",
        "completion_tokens", "prompt_tokens", "total_tokens",
    ):
        clean[key] = 0
    clean["api_usage_complete"] = False
    clean["token_accounting"] = "unavailable_after_newline_reasoning_truncation"
    clean["exception_message"] = None
    clean["exception_type"] = None
    clean["segment_reason"] = "newline_reasoning_clean_prefix"
    clean["reasoning_complete"] = any(
        isinstance(message, dict)
        and message.get("role") == "assistant"
        and bool(message.get("reasoning_content"))
        for message in prefix
    )
    clean["api_reasoning_complete"] = clean["reasoning_complete"]
    outcome = dict(clean.get("outcome") or {})
    outcome.update({
        "completion_tokens": 0,
        "prompt_tokens": 0,
        "exception_message": None,
        "exception_type": None,
    })
    clean["outcome"] = outcome
    clean_source_metadata = dict(source_metadata) if isinstance(source_metadata, dict) else {}
    clean_source_metadata["newline_reasoning_sanitization"] = marker
    clean["source_metadata"] = clean_source_metadata
    return clean, record


# --------------------------------------------------------------------------- #
# monitor-bench eval traces
# --------------------------------------------------------------------------- #
#
# The monitor-bench eval (evals/monitor/ in this repo and its sibling checkouts
# pi-setup-monitor-initial / pi-setup-monitor-optim; older checkouts keep the
# flat evals/ layout) runs headless Pi sessions
# with SessionManager.inMemory, so no pi session files exist; the only record
# is each task's transcript.jsonl. Those transcripts can be converted into the
# dataset row format too, but they are plentiful (7 fixed prompts x models x
# seeds x extension versions), so a strict policy applies:
#
#   * PERFECT runs only: every scorer boolean check passes (outcome_score 1.0),
#     no unexpected fixture modifications (integrity), correct adoption
#     (monitor used on the long-job tasks t1-t4/t6/t7, NOT used on the control
#     t5), and zero bash blocking (bash_blocking_seconds == 0, i.e. the model
#     trusted the watcher instead of sleep-looping).
#   * At most EVAL_PER_TASK_CAP traces per task (task == prompt).
#   * When more candidates than the cap exist, prefer traces produced under
#     different monitor-extension versions, and pick the shortest traces
#     (fewest transcript bytes) within that constraint.
#   * The global model invariants still apply: OpenAI/Anthropic-model traces
#     are dropped, and redaction runs over eval rows like any other row.

EVAL_PER_TASK_CAP = 5
MONITOR_BENCH_LONG_TASKS = {"t1", "t2", "t3", "t4", "t6", "t7"}

# Fork-commit -> human-readable extension-surface era (see git log --
# forks/pi-process-monitor-safe: initial 4-tool/10-param surface, the iter
# tweaks, the 3-tool/6-param simplification, restored heartbeats, unslop).
MONITOR_VERSION_ERAS = {
    "0356b3b": "initial-4x10", "018d81a": "initial-4x10",
    "1e4907b": "initial-4x10", "6b077fe": "initial-4x10",
    "f3d0ca0": "iter-4x10", "2428d59": "iter-4x10", "dac53ad": "iter-4x10",
    "3f10ffb": "simplified-3x6", "3bdb67b": "simplified-3x6",
    "f2263f4": "simplified-3x6", "9b55521": "simplified-3x6",
    "188a20f": "simplified-heartbeat", "4b0fae6": "simplified-heartbeat",
    "b9cd9d9": "simplified-heartbeat-unslop", "bbefbf7": "simplified-heartbeat-unslop",
}


@dataclass
class EvalStats:
    checkouts: int = 0
    runs: int = 0
    scored_tasks: int = 0
    dropped_model: int = 0
    dropped_imperfect: int = 0
    selected: int = 0
    fail_reasons: Counter = field(default_factory=Counter)


def discover_monitor_bench_runs() -> list[tuple[Path, Path]]:
    """Find (checkout, run_dir) pairs for every monitor-bench run on this
    machine: any ~/pi-setup* checkout with evals/monitor/results/*/meta.json
    (or the older evals/results/*/meta.json) — runs are one or two levels deep.
    Symlinked aliases (latest, latest-multi) are skipped via realpath dedupe."""
    out: list[tuple[Path, Path]] = []
    seen: set[Path] = set()
    for co in sorted(HOME.glob("pi-setup*")):
        if not co.is_dir():
            continue
        for rel in ("evals", "monitor", "results"), ("evals", "results"):
            results = co.joinpath(*rel)
            if not results.is_dir():
                continue
            for meta in sorted(results.rglob("meta.json")):
                run = meta.parent.resolve()
                if run in seen or not (run / "meta.json").is_file():
                    continue
                seen.add(run)
                out.append((co, run))
    return out


def monitor_fork_history(checkout: Path) -> list[tuple[int, str]]:
    """Ascending (commit_time, short_hash) list of commits that touched the
    monitor fork in this checkout."""
    try:
        r = subprocess.run(
            ["git", "-C", str(checkout), "log", "--format=%h %ct", "--",
             "forks/pi-process-monitor-safe"],
            capture_output=True, text=True, timeout=30,
        )
        hist = [(int(ct), h) for line in r.stdout.splitlines() if line.strip()
                for h, ct in [line.split()]]
        return sorted(hist)
    except Exception:
        return []


def monitor_version_at(hist: list[tuple[int, str]], epoch: float) -> str | None:
    v = None
    for ct, h in hist:
        if ct <= epoch:
            v = h
        else:
            break
    return v


def score_monitor_bench_run(checkout: Path, run_dir: Path) -> list[dict] | None:
    """Re-score a run with its own checkout's score.py (matches that run's task
    versions) and return the per-task score rows, or None on failure."""
    score_py = checkout / "evals" / "monitor" / "score" / "score.py"
    if not score_py.is_file():
        score_py = checkout / "evals" / "score" / "score.py"
    if not score_py.is_file():
        return None
    try:
        r = subprocess.run(
            [sys.executable, str(score_py), str(run_dir)],
            capture_output=True, text=True, timeout=600,
        )
        if r.returncode != 0:
            print(f"  [warn] score.py failed for {run_dir}: {r.stderr.strip()[:200]}", file=sys.stderr)
            return None
        scores = json.loads((run_dir / "scores.json").read_text())
        return scores.get("tasks") or []
    except Exception as e:
        print(f"  [warn] could not score {run_dir}: {e}", file=sys.stderr)
        return None


def eval_task_is_perfect(t: dict) -> tuple[bool, list[str]]:
    """A monitor-bench task-run is perfect when every scorer check passes, the
    fixture integrity baseline has no unexpected modifications, adoption is
    correct for the task, and the model never sleep-blocked."""
    fails: list[str] = []
    checks = {k: v for k, v in (t.get("checks") or {}).items() if isinstance(v, bool)}
    if not checks:
        fails.append("no_checks")
    fails += [k for k, v in checks.items() if not v]
    if (t.get("integrity") or {}).get("unexpected"):
        fails.append("integrity")
    want_monitor = t.get("task") in MONITOR_BENCH_LONG_TASKS
    if bool(t.get("used_monitor")) != want_monitor:
        fails.append("adoption")
    if (t.get("bash_blocking_seconds") or 0) != 0:
        fails.append("trust_blocking")
    return (not fails, fails)


def transcript_to_messages(path: Path) -> list[dict] | None:
    """Rebuild OpenAI-chat-format messages from a monitor-bench transcript.jsonl.

    Transcript events per assistant turn: tool_start* (call ids + args),
    tool_end* (results by id), then turn_end (assistant text). user_message
    events cover the task prompt and extension pings (watcher/heartbeat custom
    messages); steering events are mid-run user injections.
    """
    messages: list[dict] = []
    pending_calls: list[dict] = []
    pending_results: list[tuple[str, str]] = []

    def flush_assistant(text: str) -> None:
        nonlocal pending_calls, pending_results
        msg: dict = {
            "role": "assistant",
            "content": text or None,
            "reasoning_content": "",
            "reasoning_status": "native_empty",
        }
        if pending_calls:
            msg["tool_calls"] = pending_calls
        messages.append(msg)
        for cid, txt in pending_results:
            messages.append({"role": "tool", "content": txt, "tool_call_id": cid})
        pending_calls, pending_results = [], []

    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    e = json.loads(line)
                except Exception:
                    continue
                et = e.get("type")
                if et == "user_message":
                    if pending_calls or pending_results:
                        flush_assistant("")
                    messages.append({"role": "user", "content": [
                        {"type": "text", "text": str(e.get("text") or "")}]})
                elif et == "steering":
                    if pending_calls or pending_results:
                        flush_assistant("")
                    for s in e.get("texts") or []:
                        messages.append({"role": "user", "content": [
                            {"type": "text", "text": str(s)}]})
                elif et == "tool_start":
                    pending_calls.append({
                        "id": str(e.get("toolCallId") or ""),
                        "type": "function",
                        "function": {
                            "name": str(e.get("toolName") or ""),
                            "arguments": e.get("args") if isinstance(e.get("args"), (dict, list)) else {},
                        },
                    })
                elif et == "tool_end":
                    pending_results.append(
                        (str(e.get("toolCallId") or ""), str(e.get("text") or "")))
                elif et == "turn_end":
                    flush_assistant(str(e.get("text") or ""))
    except OSError as e:
        print(f"  [warn] could not read transcript {path}: {e}", file=sys.stderr)
        return None
    if pending_calls or pending_results:
        flush_assistant("")
    return messages


def select_eval_traces(cands: list[dict], cap: int) -> list[dict]:
    """Pick at most `cap` candidates per task: maximize monitor-extension
    version diversity, shortest trace first within that constraint. With one
    version present this degrades to the 5 shortest."""
    chosen: list[dict] = []
    for task in sorted({c["task"] for c in cands}):
        pool = sorted(
            (c for c in cands if c["task"] == task),
            key=lambda c: (c["trace_bytes"], c["trace_key"]),
        )
        if len(pool) <= cap:
            chosen.extend(pool)
            continue
        picked: list[dict] = []
        counts: Counter = Counter()
        remaining = list(pool)
        while len(picked) < cap and remaining:
            remaining.sort(key=lambda c: (counts[c["monitor_version"]],
                                          c["trace_bytes"], c["trace_key"]))
            c = remaining.pop(0)
            picked.append(c)
            counts[c["monitor_version"]] += 1
        chosen.extend(picked)
    return chosen


def convert_monitor_bench_traces(
    seen_keys: set[str],
    cap: int,
    stats: EvalStats,
) -> list[dict]:
    """Discover, score, filter, select and convert monitor-bench eval traces.
    Returns redaction-ready rows (redaction applied by the caller like any
    other row)."""
    runs = discover_monitor_bench_runs()
    checkouts = {co for co, _ in runs}
    stats.checkouts = len(checkouts)
    stats.runs = len(runs)
    if not runs:
        return []

    histories = {co: monitor_fork_history(co) for co in checkouts}
    candidates: list[dict] = []
    for co, run_dir in runs:
        meta = json.loads((run_dir / "meta.json").read_text())
        model = str(meta.get("model") or "")
        provider = model.split("/")[0].lower() if model else ""
        try:
            started_epoch = datetime.fromisoformat(
                str(meta.get("startedAt") or "").replace("Z", "+00:00")).timestamp()
        except Exception:
            started_epoch = 0.0
        ver = monitor_version_at(histories.get(co, []), started_epoch)
        era = MONITOR_VERSION_ERAS.get(ver or "", "unknown")
        tasks = score_monitor_bench_run(co, run_dir)
        if tasks is None:
            continue
        rel_run = run_dir.relative_to(co.resolve()) if run_dir.is_relative_to(co.resolve()) else run_dir
        for t in tasks:
            stats.scored_tasks += 1
            task = t.get("task") or ""
            if provider in ("openai", "anthropic") or is_openai_model(provider, model.split("/", 1)[-1] if model else None):
                stats.dropped_model += 1
                continue
            perfect, fails = eval_task_is_perfect(t)
            if not perfect:
                stats.dropped_imperfect += 1
                for f_ in fails:
                    stats.fail_reasons[f_] += 1
                continue
            tr_path = run_dir / task / "transcript.jsonl"
            if not tr_path.is_file():
                continue
            trace_key = f"monitor-bench:{co.name}:{rel_run}:{task}"
            if trace_key in seen_keys:
                continue
            candidates.append({
                "task": task,
                "trace_key": trace_key,
                "trace_bytes": tr_path.stat().st_size,
                "transcript": tr_path,
                "checkout": co,
                "run_dir": run_dir,
                "rel_run": str(rel_run),
                "model": model,
                "provider": provider,
                "seed": str(t.get("seed") or meta.get("seed") or ""),
                "monitor_version": ver or "unknown",
                "monitor_version_era": era,
                "started_at": str(meta.get("startedAt") or ""),
                "score_row": t,
            })

    selected = select_eval_traces(candidates, cap)
    stats.selected = len(selected)

    rows: list[dict] = []
    for c in selected:
        messages = transcript_to_messages(c["transcript"])
        if not messages:
            continue
        t = c["score_row"]
        provider, _, model_id = c["model"].partition("/")
        date = c["started_at"][:10]
        lang, domain = _detect_language(
            [tc for m in messages for tc in (m.get("tool_calls") or [])]
        )
        assistant_turns = sum(1 for m in messages if m["role"] == "assistant")
        description = ""
        for m in messages:
            if m["role"] == "user":
                cc = m["content"]
                if isinstance(cc, list) and cc and isinstance(cc[0], dict):
                    description = (cc[0].get("text") or "")[:500]
                break
        run_id = f"{c['checkout'].name}:{c['rel_run']}"
        row = {
            "agent": "pi",
            "api_completion_tokens": 0,
            "api_exchange_count": assistant_turns,
            "api_prompt_tokens": 0,
            "api_provider": "auto",
            "api_reasoning_complete": True,
            "api_row_id": c["trace_key"],
            "api_session_id": "",
            "api_session_key": "",
            "api_total_tokens": 0,
            "api_usage_complete": False,
            "command_complexity": "",
            "completion_tokens": 0,
            "container_def": "",
            "date": date,
            "description": description,
            "domain": domain,
            "exception_message": None,
            "exception_type": None,
            "harness": "pi",
            "harness_completion_tokens": 0,
            "harness_prompt_tokens": 0,
            "language": lang,
            "messages": messages,
            "model": model_id,
            "model_provider": provider,
            "outcome": {
                "completion_tokens": 0,
                "exception_message": None,
                "exception_type": None,
                "harness": "pi",
                "passed": True,
                "prompt_tokens": 0,
                "result_path": str(c["transcript"]),
                "reward": 1.0,
                "task_name": f"monitor-bench/{c['task']}",
                "trial_name": f"{c['model']}_seed{c['seed']}",
            },
            "parent_row_id": None,
            "passed": True,
            "primitive_skills": json.dumps([lang]) if lang else "[]",
            "prompt_tokens": 0,
            "provider_metadata": {"api_base": ""},
            "reasoning_complete": True,
            "result_path": str(c["transcript"]),
            "reward": 1.0,
            "root_row_id": c["trace_key"],
            "run_id": run_id,
            "scenario": "monitor-bench",
            "segment_index": 0,
            "segment_reason": "root",
            "skill_type": domain,
            "source": "local/pi-monitor-bench",
            "source_archive": "",
            "source_metadata": {
                "cwd": str(c["run_dir"] / c["task"] / "work"),
                "host": os.uname().nodename if hasattr(os, "uname") else "",
                "eval": "monitor-bench",
                "eval_task": c["task"],
                "eval_seed": c["seed"],
                "eval_run": str(c["rel_run"]),
                "eval_checkout": str(c["checkout"]),
                "eval_exit_reason": t.get("exit_reason"),
                "eval_duration_s": t.get("duration_s"),
                "eval_assistant_turns": t.get("assistant_turns"),
                "monitor_extension_commit": c["monitor_version"],
                "monitor_extension_era": c["monitor_version_era"],
                "trace_bytes": c["trace_bytes"],
                "pi_session_file": str(c["transcript"]),
            },
            "source_path": str(c["transcript"]),
            "task": f"monitor-bench/{c['task']}",
            "task_complexity": "",
            "task_id": f"monitor-bench-{c['task']}",
            "test_final_state": "",
            "test_initial_state": "",
            "token_accounting": "transcript_no_usage",
            "tools": [],
            "total_tokens": 0,
            "trace_key": c["trace_key"],
            "trial_name": f"{c['model']}_seed{c['seed']}",
            "truth": "",
        }
        rows.append(row)
    return rows


def cap_union_eval_rows(merged: dict[str, dict], cap: int) -> int:
    """Enforce the per-task eval cap on the merged (remote+local) row set,
    keeping the shortest traces per task. Returns number of rows dropped."""
    by_task: dict[str, list[str]] = {}
    for k, r in merged.items():
        if (r.get("source") or "") == "local/pi-monitor-bench":
            by_task.setdefault(r.get("task") or "", []).append(k)
    dropped = 0
    for task, keys in by_task.items():
        if len(keys) <= cap:
            continue
        keys.sort(key=lambda k: (
            ((merged[k].get("source_metadata") or {}).get("trace_bytes") or 0), k))
        for k in keys[cap:]:
            del merged[k]
            dropped += 1
    return dropped


# Map of file extension -> (language, domain) matching the reference dataset.
EXT_LANG = {
    ".py": ("python", "python"),
    ".pyi": ("python", "python"),
    ".js": ("javascript", "js"),
    ".mjs": ("javascript", "js"),
    ".cjs": ("javascript", "js"),
    ".jsx": ("javascript", "js"),
    ".ts": ("typescript", "ts"),
    ".tsx": ("typescript", "ts"),
    ".go": ("go", "go"),
    ".rs": ("rust", "rust"),
    ".java": ("java", "java"),
}


# --------------------------------------------------------------------------- #
# Secret redaction
# --------------------------------------------------------------------------- #
#
# Every API-key-like string in a converted trace is replaced with a
# deterministic fake that (a) looks like the same kind of key (same prefix,
# same length, valid charset) and (b) is stable: the same real key always maps
# to the same fake key, across messages, traces, and runs. Stability comes
# from hashing a fixed salt + the real key, NOT from a stored real->fake table,
# so no secrets are persisted anywhere by the redactor (an in-memory cache is
# used purely for speed within a single run).
#
# Redaction is applied to every string value in the converted row (user text,
# assistant text + reasoning, tool results, tool-call arguments, etc.). The
# detection regexes are specific enough (prefixed key formats, `Bearer ...`,
# `<NAME>(PASSWORD|SECRET|TOKEN|API_KEY)...=VALUE`, PEM blocks) that ordinary
# content (file paths, code) is left untouched.

REDACT_SALT = b"pi-trace-cache-tool/v1"
ALNUM = string.ascii_letters + string.digits  # 62

CHARSETS = {
    "url": string.ascii_letters + string.digits + "_-",  # 64
    "alnum": string.ascii_letters + string.digits,         # 62
    "ualnum": string.ascii_letters + string.digits + "_", # 63
    "upper": string.ascii_uppercase + string.digits,      # 36
    "b64": string.ascii_letters + string.digits + "+/",   # 64
}

# Each spec: (regex matching the full key with (prefix)(body) groups, charset)
# used to regenerate the body while preserving the prefix + length.
KEY_SPECS: list[tuple["re.Pattern", str]] = [
    (re.compile(r"(sk-proj-)([A-Za-z0-9_-]{20,})"), "url"),       # OpenAI project keys
    (re.compile(r"(sk-or-v[0-9]+-)([A-Za-z0-9]{40,})"), "alnum"), # OpenRouter
    (re.compile(r"(sk-ant-)([A-Za-z0-9_-]{20,})"), "url"),        # Anthropic
    (re.compile(r"(github_pat_)([A-Za-z0-9_]{60,})"), "ualnum"),  # GitHub fine-grained PAT
    (re.compile(r"(gh[opsru]_)([A-Za-z0-9]{36,})"), "alnum"),     # GitHub classic PAT
    (re.compile(r"(hf_)([A-Za-z0-9]{30,})"), "alnum"),            # HuggingFace
    (re.compile(r"(fw_)([A-Za-z0-9]{20,})"), "alnum"),            # Fireworks
    (re.compile(r"(AKIA)([0-9A-Z]{16})\b"), "upper"),            # AWS access key id
    (re.compile(r"(sk-)([A-Za-z0-9]{40,})"), "alnum"),            # OpenAI legacy (last among sk-)
]

# Combined in-text finder. Named groups so we know which branch matched and
# can split bearer / envkey matches into keep-prefix + redact-value.
_NAMED = [
    ("skproj",   r"sk-proj-[A-Za-z0-9_-]{20,}"),
    ("skor",     r"sk-or-v[0-9]+-[A-Za-z0-9]{40,}"),
    ("skant",    r"sk-ant-[A-Za-z0-9_-]{20,}"),
    ("ghpat",    r"github_pat_[A-Za-z0-9_]{60,}"),
    ("gh",       r"gh[opsru]_[A-Za-z0-9]{36,}"),
    ("hf",       r"hf_[A-Za-z0-9]{30,}"),
    ("fw",       r"fw_[A-Za-z0-9]{20,}"),
    ("aws",      r"AKIA[0-9A-Z]{16}\b"),
    ("sklegacy", r"sk-[A-Za-z0-9]{40,}"),
    ("bearer",   r"Bearer\s+[A-Za-z0-9._-]{20,}"),
    # env-style assignment: VAR...PASSWORD|SECRET|TOKEN|API_KEY... = VALUE
    ("envkey",   r"(?:[A-Za-z0-9_]*)(?:PASSWORD|SECRET|TOKEN|API[_-]?KEY|APIKEY)[A-Za-z0-9_]*\s*[:=]\s*[\"']?[A-Za-z0-9._\-+/=]{16,}"),
    ("pem",      r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----"),
]
FIND_RE = re.compile(
    "|".join(f"(?P<{n}>{p})" for n, p in _NAMED),
    re.IGNORECASE | re.DOTALL,
)
BEARER_SPLIT = re.compile(r"(Bearer\s+)([A-Za-z0-9._-]{20,})")
ENVKEY_SPLIT = re.compile(
    r"((?:[A-Za-z0-9_]*)(?:PASSWORD|SECRET|TOKEN|API[_-]?KEY|APIKEY)[A-Za-z0-9_]*\s*[:=]\s*[\"']?)([A-Za-z0-9._\-+/=]{16,})",
    re.IGNORECASE,
)
PEM_BODY = re.compile(
    r"(-----BEGIN [A-Z ]*PRIVATE KEY-----\n)(.*?)(\n-----END [A-Z ]*PRIVATE KEY-----)",
    re.DOTALL,
)


class Redactor:
    """Deterministic secret redactor.

    `fake_for(real)` returns a stable, format-valid fake for a given secret.
    `redact_text` finds secrets in running text and replaces them. `redact_obj`
    / `redact_row` recurse over JSON-like structures.
    """

    def __init__(self) -> None:
        self._cache: dict[str, str] = {}
        self.counts: Counter = Counter()

    # -- deterministic byte stream seeded by the real secret -------------
    def _keystream(self, seed: str):
        counter = 0
        while True:
            h = hashlib.sha256(
                REDACT_SALT + seed.encode("utf-8") + str(counter).encode()
            ).digest()
            for b in h:
                yield b
            counter += 1

    def _gen(self, length: int, charset: str, seed: str) -> str:
        ks = self._keystream(seed)
        n = len(charset)
        return "".join(charset[next(ks) % n] for _ in range(length))

    def _gen_preserving(self, s: str, seed: str) -> str:
        # Randomize [A-Za-z0-9] in place; keep all other chars (., -, _, +, /,
        # =, newlines) so structure (JWT dots, PEM line breaks) is preserved.
        ks = self._keystream(seed)
        out = []
        for ch in s:
            if ch.isalnum():
                out.append(ALNUM[next(ks) % len(ALNUM)])
            else:
                out.append(ch)
        return "".join(out)

    # -- core mapping ----------------------------------------------------
    def fake_for(self, real: str) -> str:
        cached = self._cache.get(real)
        if cached is not None:
            return cached
        out = self._fake(real)
        self._cache[real] = out
        return out

    def _fake(self, real: str) -> str:
        for rx, charset in KEY_SPECS:
            m = rx.match(real)
            if m:
                prefix, body = m.group(1), m.group(2)
                return prefix + self._gen(len(body), CHARSETS[charset], real)
        # Unknown shape (bare bearer token, env value, PEM body): preserve
        # structure, randomize alphanumerics.
        return self._gen_preserving(real, real)

    def _fake_pem(self, block: str) -> str:
        m = PEM_BODY.match(block)
        if not m:
            return self._gen_preserving(block, block)
        head, body, foot = m.group(1), m.group(2), m.group(3)
        return head + self._gen_preserving(body, body) + foot

    # -- public API ------------------------------------------------------
    def redact_text(self, s: str) -> str:
        if not isinstance(s, str) or not s:
            return s

        def repl(m: re.Match) -> str:
            s0 = m.group(0)
            which = m.lastgroup
            if which == "pem":
                self.counts["pem"] += 1
                return self._fake_pem(s0)
            if which == "bearer":
                self.counts["bearer"] += 1
                bm = BEARER_SPLIT.match(s0)
                p, t = bm.group(1), bm.group(2)
                return p + self.fake_for(t)
            if which == "envkey":
                self.counts["envkey"] += 1
                em = ENVKEY_SPLIT.match(s0)
                p, v = em.group(1), em.group(2)
                return p + self.fake_for(v)
            if which is None:
                return self.fake_for(s0)
            self.counts[which] += 1
            return self.fake_for(s0)

        return FIND_RE.sub(repl, s)

    def redact_obj(self, o: Any) -> Any:
        if isinstance(o, str):
            return self.redact_text(o)
        if isinstance(o, list):
            return [self.redact_obj(x) for x in o]
        if isinstance(o, dict):
            return {k: self.redact_obj(v) for k, v in o.items()}
        return o

    def redact_row(self, row: dict) -> dict:
        return self.redact_obj(row)  # returns a rebuilt structure


REDACTOR = Redactor()


# --------------------------------------------------------------------------- #
# Discovery
# --------------------------------------------------------------------------- #

def looks_like_pi_session(path: Path) -> bool:
    """True if the first JSONL line is a pi `session` event."""
    try:
        with open(path, "rb") as f:
            head = f.readline(4096)
        if not head.startswith(b"{"):
            return False
        obj = json.loads(head)
        return obj.get("type") == "session" and "id" in obj and "timestamp" in obj
    except Exception:
        return False


def walk_for_traces(roots: Iterable[Path]) -> list[Path]:
    """Walk roots looking for pi session JSONL files. Skips heavy/system dirs."""
    out: list[Path] = []
    seen: set[Path] = set()
    for root in roots:
        root = root.expanduser()
        if not root.exists():
            continue
        if root.is_file():
            if root.suffix == ".jsonl" and root not in seen and looks_like_pi_session(root):
                seen.add(root)
                out.append(root)
            continue
        for dp, dns, fns in os.walk(root):
            dns[:] = [d for d in dns if d not in SKIP_DIRS]
            # Don't go absurdly deep.
            if dp.count(os.sep) > 10:
                dns[:] = []
                continue
            for fn in fns:
                if not fn.endswith(".jsonl"):
                    continue
                p = Path(dp) / fn
                if p in seen:
                    continue
                if looks_like_pi_session(p):
                    seen.add(p)
                    out.append(p)
    return sorted(out)


def extract_archives(archive_dirs: Iterable[Path], tmpdir: Path) -> list[tuple[Path, str]]:
    """Extract *.tar.gz / *.tar session archives into tmpdir.

    Returns list of (jsonl_path, archive_basename) for extracted pi sessions.
    """
    extracted: list[tuple[Path, str]] = []
    for ad in archive_dirs:
        ad = ad.expanduser()
        if not ad.exists():
            continue
        archives: list[Path] = []
        archives.extend(sorted(ad.glob("*.tar.gz")))
        archives.extend(sorted(ad.glob("*.tar")))
        archives.extend(sorted(ad.glob("*.tgz")))
        for arc in archives:
            try:
                dest = tmpdir / (arc.stem + "_extracted")
                dest.mkdir(parents=True, exist_ok=True)
                with tarfile.open(arc, "r:*") as tf:
                    tf.extractall(dest)  # noqa: S202 - trusted local archives
                for p in dest.rglob("*.jsonl"):
                    if looks_like_pi_session(p):
                        extracted.append((p, arc.name))
            except Exception as e:  # pragma: no cover
                print(f"  [warn] could not extract {arc}: {e}", file=sys.stderr)
    return extracted


# --------------------------------------------------------------------------- #
# Model filtering
# --------------------------------------------------------------------------- #

def is_openai_model(provider: str | None, model: str | None) -> bool:
    if provider and provider.lower() == "openai":
        return True
    if model and OPENAI_MODEL_RE.match(str(model)):
        return True
    return False


# Additional model filters — drop entire providers/model families from
# the dataset. Each entry: (label, provider-match set, model regex).
#   - anthropic: ANY model whose provider is "anthropic" OR whose id matches
#     claude (claude-opus-*, claude-sonnet-*, claude-haiku-*, anthropic/claude-*).
#   - qwen3-0.6b: the Qwen3 0.6B models (e.g. mlx-community/Qwen3-0.6B-4bit).
#   - faux:       pi's internal test/mock provider (provider="faux", model
#                 "faux-1"/"faux-2"). Zero-cost, canned responses
#                 ("hello"->"one"), lives in test scratch dirs. Not real sessions.
EXTRA_MODEL_FILTERS: list[tuple[str, set[str], re.Pattern]] = [
    ("anthropic",  {"anthropic"}, re.compile(r"claude", re.IGNORECASE)),
    ("qwen3-0.6b", set(),         re.compile(r"qwen3.*0\.?6b|0\.?6b.*qwen3", re.IGNORECASE)),
    ("faux",       {"faux"},      re.compile(r"^faux(?:-\d+)?$", re.IGNORECASE)),
]


def extra_filter_match(provider: str | None, model: str | None) -> str | None:
    """Return the filter label if the (provider, model) matches an extra
    filter, else None. A filter matches if the provider is in its provider set
    OR the model matches its regex."""
    prov_l = provider.lower() if provider else ""
    mdl = str(model) if model else ""
    for label, provs, rx in EXTRA_MODEL_FILTERS:
        if prov_l and prov_l in provs:
            return label
        if mdl and rx.search(mdl):
            return label
    return None


# --------------------------------------------------------------------------- #
# Conversion
# --------------------------------------------------------------------------- #

@dataclass
class ConvStats:
    discovered: int = 0
    converted: int = 0
    skipped_openai: int = 0
    skipped_terminalbench: int = 0
    skipped_benchmark: int = 0
    skipped_model_filter: int = 0
    skipped_empty: int = 0
    skipped_parse: int = 0
    skipped_smoke: Counter = field(default_factory=Counter)
    newline_reasoning_truncated: int = 0
    newline_reasoning_excluded: int = 0
    tools_used: set[str] = field(default_factory=set)


def _blk_text(blk: Any) -> str:
    if isinstance(blk, dict):
        return str(blk.get("text") or blk.get("content") or "")
    return str(blk)


def _detect_language(tool_calls: list[dict]) -> tuple[str, str]:
    """Best-effort (language, domain) from file extensions in tool-call args.

    Accepts either the converted OpenAI tool_call shape (name/arguments under
    ``tc["function"]``) or the raw pi ``toolCall`` event shape (name/arguments
    at the top level). ``convert_session`` passes the converted shape, so the
    ``.function`` path is the one used in practice.
    """
    exts: Counter[str] = Counter()
    for tc in tool_calls:
        fn = tc.get("function") if isinstance(tc.get("function"), dict) else tc
        args = fn.get("arguments") or {}
        if not isinstance(args, dict):
            continue
        blob = json.dumps(args) + " " + str(fn.get("name", ""))
        # capture file paths in args
        for token in re.findall(r"[\w/.\-]+\.\w{1,5}", blob):
            ext = os.path.splitext(token)[1].lower()
            if ext in EXT_LANG:
                exts[ext] += 1
    if not exts:
        return ("", "")
    ext = exts.most_common(1)[0][0]
    lang, domain = EXT_LANG[ext]
    return (lang, domain)


def convert_messages(events: list[dict]) -> tuple[list[dict], dict]:
    """Build the OpenAI-style `messages` list from pi message events.

    Returns (messages, meta) where meta carries usage/tools/exception info.
    """
    messages: list[dict] = []
    usage_inputs: list[int] = []
    usage_outputs: list[int] = []
    usage_reasoning: list[int] = []
    usage_total: list[int] = []
    all_tools: set[str] = set()
    exception_message: str | None = None
    exception_type: str | None = None
    assistant_turns = 0
    openai_turns = 0
    reasoning_present = False

    for ev in events:
        if ev.get("type") != "message":
            continue
        m = ev.get("message") or {}
        role = m.get("role")
        content = m.get("content") or []

        if role == "user":
            blocks = [
                {"type": "text", "text": _blk_text(b)}
                for b in content
                if isinstance(b, dict) and b.get("type") == "text"
            ]
            if not blocks:
                # user message with no text blocks -> still keep a placeholder
                blocks = [{"type": "text", "text": ""}]
            messages.append({"role": "user", "content": blocks})

        elif role == "assistant":
            assistant_turns += 1
            prov = m.get("provider")
            mdl = m.get("model")
            if is_openai_model(prov, mdl):
                openai_turns += 1
            texts: list[str] = []
            thinks: list[str] = []
            tool_calls: list[dict] = []
            for b in content:
                if not isinstance(b, dict):
                    continue
                t = b.get("type")
                if t == "text":
                    tx = _blk_text(b)
                    if tx:
                        texts.append(tx)
                elif t == "thinking":
                    tk = b.get("thinking") or b.get("content") or ""
                    if tk:
                        thinks.append(str(tk))
                        reasoning_present = True
                elif t == "toolCall":
                    name = b.get("name")
                    if name:
                        all_tools.add(str(name))
                    fn = {
                        "name": str(name) if name is not None else "",
                        "arguments": b.get("arguments") if isinstance(b.get("arguments"), (dict, list)) else {},
                    }
                    tool_calls.append({
                        "id": str(b.get("id") or ""),
                        "type": "function",
                        "function": fn,
                    })
            # usage
            u = m.get("usage") or {}
            if isinstance(u, dict):
                usage_inputs.append(int(u.get("input") or 0))
                usage_outputs.append(int(u.get("output") or 0))
                usage_reasoning.append(int(u.get("reasoning") or 0))
                usage_total.append(int(u.get("totalTokens") or 0))
            # error
            if m.get("errorMessage") and exception_message is None:
                exception_message = str(m["errorMessage"])
                exception_type = m.get("stopReason") or "assistant_error"

            msg: dict = {
                "role": "assistant",
                "content": "\n".join(texts) if texts else None,
                "reasoning_content": "\n".join(thinks) if thinks else "",
                "tool_calls": tool_calls or None,
            }
            # Drop None tool_calls to keep it clean (matches dataset rows that
            # sometimes omit it); keep reasoning tokens when we have usage.
            if tool_calls:
                msg["tool_calls"] = tool_calls
            else:
                msg.pop("tool_calls", None)
            if usage_reasoning:
                msg["reasoning_tokens"] = usage_reasoning[-1]
            # reasoning_status mirrors the dataset's convention:
            #   native_empty = reasoning-capable turn produced no thinking
            msg["reasoning_status"] = "present" if reasoning_present and thinks else "native_empty"
            messages.append(msg)

        elif role == "toolResult":
            tr_content = m.get("content") or []
            text = "\n".join(
                _blk_text(b) for b in tr_content
                if isinstance(b, dict) and b.get("type") == "text"
            )
            if m.get("isError") and exception_message is None:
                exception_message = text[:4000] or "tool error"
                exception_type = "tool_error"
            tn = m.get("toolName")
            if tn:
                all_tools.add(str(tn))
            messages.append({
                "role": "tool",
                "content": text,
                "tool_call_id": str(m.get("toolCallId") or ""),
            })

    meta = {
        "assistant_turns": assistant_turns,
        "openai_turns": openai_turns,
        "tools_used": all_tools,
        "usage_inputs": usage_inputs,
        "usage_outputs": usage_outputs,
        "usage_reasoning": usage_reasoning,
        "usage_total": usage_total,
        "exception_message": exception_message,
        "exception_type": exception_type,
        "reasoning_present": reasoning_present,
    }
    return messages, meta


def _iso_to_date(ts: str) -> str:
    # pi timestamps look like "2026-07-31T03:11:22.340Z"
    try:
        return ts[:10]
    except Exception:
        return ""


def convert_session(
    events: list[dict],
    source_path: str,
    source_archive: str,
) -> tuple[dict | None, str]:
    """Convert a parsed session event list to a target row.

    Returns (row_or_None, skip_reason).
    """
    session = next((e for e in events if e.get("type") == "session"), None)
    if session is None:
        return None, "no_session_event"

    session_id = str(session.get("id") or "")
    session_ts = str(session.get("timestamp") or "")
    cwd = str(session.get("cwd") or "")

    # effective model = last model_change, else last assistant message
    model_changes = [e for e in events if e.get("type") == "model_change"]
    eff_provider = None
    eff_model = None
    if model_changes:
        last = model_changes[-1]
        eff_provider = last.get("provider")
        eff_model = last.get("modelId")
    # fall back to last assistant turn
    messages, meta = convert_messages(events)
    if eff_provider is None or eff_model is None:
        for ev in reversed(events):
            if ev.get("type") == "message" and (ev.get("message") or {}).get("role") == "assistant":
                m = ev["message"]
                eff_provider = eff_provider or m.get("provider")
                eff_model = eff_model or m.get("model")
                break

    # ---- OpenAI filter -------------------------------------------------- #
    if is_openai_model(eff_provider, eff_model):
        return None, "openai"
    if meta["assistant_turns"] > 0 and meta["openai_turns"] == meta["assistant_turns"]:
        return None, "openai"
    if not messages:
        return None, "empty"

    # ---- Extra model-family filter (anthropic, qwen3-0.6b, faux) ----- #
    extra = extra_filter_match(eff_provider, eff_model)
    if extra:
        return None, f"model:{extra}"

    # ---- Benchmark-rollout filter -------------------------------------- #
    rollout = detect_benchmark_rollout(events, cwd)
    if rollout:
        return None, rollout

    # ---- Token accounting (matches glm-5.2-multi-harness-agent) -------- #
    first_input = meta["usage_inputs"][0] if meta["usage_inputs"] else 0
    completion = sum(meta["usage_outputs"])
    last_input = meta["usage_inputs"][-1] if meta["usage_inputs"] else 0
    last_total = meta["usage_total"][-1] if meta["usage_total"] else (last_input + completion)
    prompt_tokens = first_input
    total_tokens = prompt_tokens + completion
    api_usage_complete = bool(meta["usage_inputs"]) and len(meta["usage_inputs"]) == meta["assistant_turns"]

    # ---- Language detection -------------------------------------------- #
    lang, domain = _detect_language(
        [tc for msg in messages for tc in (msg.get("tool_calls") or [])]
    )

    # ---- Description (first user text) --------------------------------- #
    description = ""
    for m in messages:
        if m["role"] == "user":
            c = m["content"]
            if isinstance(c, list) and c and isinstance(c[0], dict):
                description = (c[0].get("text") or "")[:500]
            break

    date = _iso_to_date(session_ts)
    tools_used = sorted(meta["tools_used"])
    row_id = f"pi:{session_id}" if session_id else f"pi:{abs(hash(source_path))}"

    row = {
        "agent": "pi",
        "api_completion_tokens": completion,
        "api_exchange_count": meta["assistant_turns"],
        "api_prompt_tokens": last_input,
        "api_provider": "auto",
        "api_reasoning_complete": meta["reasoning_present"] or not meta["assistant_turns"],
        "api_row_id": row_id,
        "api_session_id": session_id,
        "api_session_key": f"pi:{session_id}" if session_id else "",
        "api_total_tokens": last_total,
        "api_usage_complete": api_usage_complete,
        "command_complexity": "",
        "completion_tokens": completion,
        "container_def": "",
        "date": date,
        "description": description,
        "domain": domain,
        "exception_message": meta["exception_message"],
        "exception_type": meta["exception_type"],
        "harness": "pi",
        "harness_completion_tokens": 0,
        "harness_prompt_tokens": 0,
        "language": lang,
        "messages": messages,
        "model": str(eff_model or ""),
        "model_provider": str(eff_provider or ""),
        "outcome": {
            "completion_tokens": completion,
            "exception_message": meta["exception_message"],
            "exception_type": meta["exception_type"],
            "harness": "pi",
            "passed": None,
            "prompt_tokens": prompt_tokens,
            "result_path": source_path,
            "reward": None,
            "task_name": session_id,
            "trial_name": "",
        },
        "parent_row_id": None,
        "passed": None,
        "primitive_skills": json.dumps([lang]) if lang else "[]",
        "prompt_tokens": prompt_tokens,
        "provider_metadata": {"api_base": ""},
        "reasoning_complete": meta["reasoning_present"] or not meta["assistant_turns"],
        "result_path": source_path,
        "reward": None,
        "root_row_id": row_id,
        "run_id": session_id,
        "scenario": "",
        "segment_index": 0,
        "segment_reason": "root",
        "skill_type": domain,
        "source": "local/pi",
        "source_archive": source_archive,
        "source_metadata": {
            "cwd": cwd,
            "host": os.uname().nodename if hasattr(os, "uname") else "",
            "pi_session_file": source_path,
        },
        "source_path": source_path,
        "task": f"pi-session/{session_id}" if session_id else "pi-session",
        "task_complexity": "",
        "task_id": session_id,
        "test_final_state": "",
        "test_initial_state": "",
        "token_accounting": "conversation_delta_from_api_usage" if api_usage_complete else "estimated",
        "tools": [],  # pi traces don't persist tool schemas; see README
        "total_tokens": total_tokens,
        "trace_key": f"pi-session:{session_id}" if session_id else f"pi-session:{row_id}",
        "trial_name": "",
        "truth": "",
    }
    return row, ""


def parse_session_file(path: Path) -> list[dict] | None:
    """Load a pi session JSONL into a list of events. None on parse failure."""
    events: list[dict] = []
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                events.append(json.loads(line))
    except Exception as e:
        print(f"  [warn] parse error in {path}: {e}", file=sys.stderr)
        return None
    return events if events else None


# --------------------------------------------------------------------------- #
# Output / compression
# --------------------------------------------------------------------------- #

def write_jsonl(rows: Iterable[dict], path: Path) -> int:
    path.parent.mkdir(parents=True, exist_ok=True)
    n = 0
    with open(path, "w", encoding="utf-8") as f:
        for r in rows:
            f.write(json.dumps(r, ensure_ascii=False) + "\n")
            n += 1
    return n


def compress_zst(src: Path, dst: Path, level: int = ZSTD_LEVEL) -> None:
    if zstd is None:
        raise RuntimeError("zstandard is required for compression (pip install zstandard)")
    dst.parent.mkdir(parents=True, exist_ok=True)
    cctx = zstd.ZstdCompressor(level=level)
    with open(src, "rb") as fin, open(dst, "wb") as fout:
        cctx.copy_stream(fin, fout)


# --------------------------------------------------------------------------- #
# Upload
# --------------------------------------------------------------------------- #

def token_has_write(token: str) -> tuple[bool, str]:
    """Check the token can write to UPLOAD_REPO's owner. Returns (ok, who)."""
    try:
        import urllib.request
        req = urllib.request.Request(
            "https://huggingface.co/api/whoami-v2",
            headers={"Authorization": f"Bearer {token}"},
        )
        with urllib.request.urlopen(req, timeout=20) as r:
            d = json.load(r)
        name = d.get("name", "")
        auth = (d.get("auth") or {}).get("accessToken", {}) or {}
        role = auth.get("role", "")
        return (role == "write", name)
    except Exception as e:
        print(f"  [warn] whoami failed: {e}", file=sys.stderr)
        return (False, "")


def upload_to_hub(files: list[Path], repo: str, token: str, dry_run: bool) -> None:
    if not files:
        print("  [upload] nothing to upload")
        return
    try:
        from huggingface_hub import HfApi  # type: ignore
    except Exception as e:
        print(f"  [warn] huggingface_hub not available, skipping upload: {e}", file=sys.stderr)
        return
    api = HfApi(token=token)
    for f in files:
        path_in_repo = f"data/{f.name}"
        if dry_run:
            print(f"  [dry-run] would upload {f} -> {repo}:{path_in_repo}")
            continue
        print(f"  [upload] {f} -> {repo}:{path_in_repo} ...", flush=True)
        api.upload_file(
            path_or_fileobj=str(f),
            path_in_repo=path_in_repo,
            repo_id=repo,
            repo_type="dataset",
            token=token,
        )
        print(f"  [upload] done: https://huggingface.co/datasets/{repo}/blob/main/{path_in_repo}")


def upload_repo_file(file: Path, path_in_repo: str, repo: str, token: str) -> None:
    """Upload one stable metadata path such as the dataset card or manifest."""
    from huggingface_hub import HfApi  # type: ignore

    print(f"  [upload] {file} -> {repo}:{path_in_repo} ...", flush=True)
    HfApi(token=token).upload_file(
        path_or_fileobj=str(file),
        path_in_repo=path_in_repo,
        repo_id=repo,
        repo_type="dataset",
        token=token,
    )
    print(f"  [upload] done: https://huggingface.co/datasets/{repo}/blob/main/{path_in_repo}")


def load_rows_from_zst(path: Path) -> list[dict]:
    """Decompress a .jsonl.zst shard and return its rows."""
    rows: list[dict] = []
    if zstd is None:
        return rows
    dctx = zstd.ZstdDecompressor()
    try:
        with open(path, "rb") as f:
            with dctx.stream_reader(f) as r:
                data = r.read()
        for line in data.decode("utf-8", errors="replace").splitlines():
            line = line.strip()
            if line:
                rows.append(json.loads(line))
    except Exception as e:
        print(f"  [warn] could not read shard {path}: {e}", file=sys.stderr)
    return rows


def list_remote_shards(repo: str, token: str) -> list[str]:
    """Return repo paths of data/*.jsonl.zst shards in the remote dataset."""
    try:
        from huggingface_hub import HfApi  # type: ignore
    except Exception as e:
        print(f"  [warn] huggingface_hub not available: {e}", file=sys.stderr)
        return []
    api = HfApi(token=token)
    try:
        files = api.list_repo_files(repo_id=repo, repo_type="dataset")
    except Exception as e:
        print(f"  [warn] could not list {repo}: {e}", file=sys.stderr)
        return []
    return [f for f in files if f.startswith("data/") and f.endswith(".jsonl.zst")]


def download_remote_rows(repo: str, token: str, tmpdir: Path) -> tuple[list[dict], list[str]]:
    """Download all remote shards; return (rows, shard_repo_paths).

    Used to compute the union of already-uploaded data and local data so a run
    on one machine never clobbers traces uploaded by another.
    """
    shard_paths = list_remote_shards(repo, token)
    if not shard_paths:
        return [], []
    rows: list[dict] = []
    try:
        from huggingface_hub import hf_hub_download  # type: ignore
    except Exception as e:
        print(f"  [warn] huggingface_hub not available: {e}", file=sys.stderr)
        return [], shard_paths
    for sp in shard_paths:
        try:
            local = hf_hub_download(
                repo_id=repo, repo_type="dataset", filename=sp,
                token=token, cache_dir=str(tmpdir / "hf_cache"),
            )
            rows.extend(load_rows_from_zst(Path(local)))
            print(f"  [upload] downloaded {sp} ({len(rows)} rows so far)")
        except Exception as e:
            print(f"  [warn] could not download {sp}: {e}", file=sys.stderr)
    return rows, shard_paths


def delete_remote_shards(repo: str, token: str, repo_paths: list[str]) -> None:
    """Delete superseded remote shards after a union upload."""
    if not repo_paths:
        return
    try:
        from huggingface_hub import HfApi  # type: ignore
    except Exception:
        return
    api = HfApi(token=token)
    for sp in repo_paths:
        try:
            api.delete_file(path_in_repo=sp, repo_id=repo, repo_type="dataset")
            print(f"  [upload] deleted superseded shard {sp}")
        except Exception as e:
            print(f"  [warn] could not delete {sp}: {e}", file=sys.stderr)


# --------------------------------------------------------------------------- #
# Main
# --------------------------------------------------------------------------- #

def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--roots", nargs="*", default=None,
                    help="Extra directories to scan for pi session .jsonl files.")
    ap.add_argument("--archives", nargs="*", default=None,
                    help="Extra dirs containing session .tar.gz archives to extract.")
    ap.add_argument("--scan-home", action="store_true",
                    help=f"Also walk all of {HOME} (slow; adds ~30s).")
    ap.add_argument("--out", default=str(DEFAULT_OUT),
                    help=f"Local output dir (default {DEFAULT_OUT}).")
    ap.add_argument("--repo", default=UPLOAD_REPO, help="HF dataset repo to upload to.")
    ap.add_argument("--no-upload", action="store_true", help="Convert + write local files, do not upload.")
    ap.add_argument("--dry-run", action="store_true", help="Convert + print summary, write local files, do not upload.")
    ap.add_argument("--max-files", type=int, default=0, help="Cap number of discovered traces (debug).")
    ap.add_argument("--zstd-level", type=int, default=ZSTD_LEVEL, help="zstd compression level.")
    ap.add_argument("--no-redact", action="store_true",
                    help="Disable secret redaction (default: redact API keys in all text).")
    ap.add_argument("--no-eval", action="store_true",
                    help="Skip monitor-bench eval trace ingestion.")
    ap.add_argument("--eval-cap", type=int, default=EVAL_PER_TASK_CAP,
                    help=f"Max monitor-bench traces per task (default {EVAL_PER_TASK_CAP}).")
    ap.add_argument("--keep-smoke", action="store_true",
                    help="Keep smoke/probe sessions and empty traces (default: drop them).")
    ap.add_argument("--keep-newline-reasoning", action="store_true",
                    help="Keep known-bad newline-reasoning turns. Unsafe; for local forensic exports only.")
    args = ap.parse_args(argv)

    if zstd is None:
        print("ERROR: zstandard is required. `pip install zstandard`", file=sys.stderr)
        return 2
    if args.keep_newline_reasoning and not (args.no_upload or args.dry_run):
        print("ERROR: --keep-newline-reasoning is restricted to --no-upload/--dry-run forensic exports.", file=sys.stderr)
        return 2

    out_dir = Path(args.out).expanduser()
    out_dir.mkdir(parents=True, exist_ok=True)

    roots: list[Path] = list(DEFAULT_ROOTS)
    if args.roots:
        roots += [Path(r).expanduser() for r in args.roots]
    if args.scan_home:
        roots.append(HOME)
    archive_dirs = list(DEFAULT_ARCHIVE_GLOBS)
    if args.archives:
        archive_dirs += [Path(a).expanduser() for a in args.archives]

    print(f"== discovering pi traces under: {[str(r) for r in roots]}")
    live = walk_for_traces(roots)
    print(f"   live sessions found: {len(live)}")

    extracted: list[tuple[Path, str]] = []
    with tempfile.TemporaryDirectory(prefix="pi-traces-archive-") as tmpd:
        extracted = extract_archives(archive_dirs, Path(tmpd))
        print(f"   archived sessions extracted: {len(extracted)}")

        all_sources: list[tuple[Path, str]] = (
            [(p, "") for p in live] + extracted
        )
        if args.max_files:
            all_sources = all_sources[: args.max_files]

        stats = ConvStats(discovered=len(all_sources))
        rows: list[dict] = []
        seen_keys: set[str] = set()
        sanitization_records: dict[str, dict] = {}
        for path, archive in all_sources:
            stats.discovered = len(all_sources)
            events = parse_session_file(path)
            if events is None:
                stats.skipped_parse += 1
                continue
            row, reason = convert_session(events, str(path), archive)
            if row is None:
                if reason == "openai":
                    stats.skipped_openai += 1
                elif reason in ("terminalbench", "benchmark_rollout"):
                    if reason == "terminalbench":
                        stats.skipped_terminalbench += 1
                    else:
                        stats.skipped_benchmark += 1
                elif reason and reason.startswith("model:"):
                    stats.skipped_model_filter += 1
                elif reason == "empty":
                    stats.skipped_empty += 1
                else:
                    stats.skipped_parse += 1
                continue
            if row["trace_key"] in seen_keys:
                # same session id already converted (e.g. live + archive overlap)
                continue
            seen_keys.add(row["trace_key"])
            if not args.keep_newline_reasoning:
                row, sanitization = sanitize_newline_reasoning(row)
                if sanitization:
                    sanitization_records[sanitization["trace_key"]] = sanitization
                    if sanitization["action"] == "exclude_trace":
                        stats.newline_reasoning_excluded += 1
                    else:
                        stats.newline_reasoning_truncated += 1
                if row is None:
                    seen_keys.discard(sanitization["trace_key"] if sanitization else "")
                    continue
            if not args.no_redact:
                row = REDACTOR.redact_row(row)
                # Re-derive description from redacted messages so a key split by
                # the 500-char truncation can't leak as a partial real key.
                row["description"] = _first_user_text(row["messages"])
            if not args.keep_smoke:
                drop = smoke_drop_reason(row)
                if drop:
                    stats.skipped_smoke[drop] += 1
                    seen_keys.discard(row["trace_key"])
                    continue
            stats.converted += 1
            stats.tools_used |= set(_tools_from_row(row))
            rows.append(row)

        # ---- monitor-bench eval traces ------------------------------------- #
        eval_stats = EvalStats()
        if not args.no_eval:
            print("\n== monitor-bench eval traces ==")
            eval_rows = convert_monitor_bench_traces(seen_keys, args.eval_cap, eval_stats)
            for row in eval_rows:
                seen_keys.add(row["trace_key"])
                if not args.keep_newline_reasoning:
                    row, sanitization = sanitize_newline_reasoning(row)
                    if sanitization:
                        sanitization_records[sanitization["trace_key"]] = sanitization
                        if sanitization["action"] == "exclude_trace":
                            stats.newline_reasoning_excluded += 1
                        else:
                            stats.newline_reasoning_truncated += 1
                    if row is None:
                        seen_keys.discard(sanitization["trace_key"] if sanitization else "")
                        continue
                if not args.no_redact:
                    row = REDACTOR.redact_row(row)
                    row["description"] = _first_user_text(row["messages"])
                stats.converted += 1
                stats.tools_used |= set(_tools_from_row(row))
                rows.append(row)
            print(f"  checkouts: {eval_stats.checkouts}  runs: {eval_stats.runs}  "
                  f"scored task-runs: {eval_stats.scored_tasks}")
            print(f"  dropped by model invariant (openai/anthropic): {eval_stats.dropped_model}")
            print(f"  dropped imperfect: {eval_stats.dropped_imperfect} "
                  f"reasons={dict(eval_stats.fail_reasons)}")
            print(f"  selected (cap {args.eval_cap}/task, version-diverse, shortest): {eval_stats.selected}")
            sel_by_task: Counter = Counter(r["task"] for r in rows
                                           if r["source"] == "local/pi-monitor-bench")
            for task in sorted(sel_by_task):
                vers = sorted({(r["source_metadata"] or {}).get("monitor_extension_commit", "?")
                               for r in rows if r["task"] == task})
                print(f"    {task}: {sel_by_task[task]} trace(s), versions: {vers}")

        # ---- write local output ------------------------------------------- #
        ts = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        jsonl_path = out_dir / f"pi-traces-{ts}.jsonl"
        zst_path = out_dir / f"pi-traces-{ts}.jsonl.zst"
        manifest_path = out_dir / f"pi-trace-sanitization-{ts}.jsonl"
        dataset_card_path = out_dir / "pi-trace-cache-README.md"
        n = write_jsonl(rows, jsonl_path)
        write_jsonl(
            [sanitization_records[key] for key in sorted(sanitization_records)],
            manifest_path,
        )
        dataset_card_path.write_text(DATASET_CARD, encoding="utf-8")
        compress_zst(jsonl_path, zst_path, level=args.zstd_level)

        raw_bytes = jsonl_path.stat().st_size
        zst_bytes = zst_path.stat().st_size
        print()
        print("== summary ==")
        print(f"  discovered:      {stats.discovered}")
        print(f"  converted:       {stats.converted}")
        print(f"  skipped openai:  {stats.skipped_openai}")
        print(f"  skipped terminalbench: {stats.skipped_terminalbench}")
        print(f"  skipped benchmark (other): {stats.skipped_benchmark}")
        print(f"  skipped model filter (anthropic/faux/qwen3-0.6b): {stats.skipped_model_filter}")
        print(f"  skipped empty:   {stats.skipped_empty}")
        print(f"  skipped smoke/probe: {dict(stats.skipped_smoke)} "
              f"(total {sum(stats.skipped_smoke.values())})")
        print(f"  newline reasoning: truncated={stats.newline_reasoning_truncated} "
              f"excluded={stats.newline_reasoning_excluded}")
        print(f"  skipped parse:   {stats.skipped_parse}")
        print(f"  tools seen:      {sorted(stats.tools_used)}")
        if not args.no_redact and REDACTOR.counts:
            print(f"  redactions:      {dict(REDACTOR.counts)} "
                  f"(total {sum(REDACTOR.counts.values())}, "
                  f"{len(REDACTOR._cache)} unique keys)")
        print(f"  local jsonl:     {jsonl_path}  ({n} rows, {raw_bytes:,} B)")
        print(f"  local zst:       {zst_path}      ({zst_bytes:,} B, {zst_bytes*100/max(raw_bytes,1):.1f}% of raw)")
        print(f"  sanitization:    {manifest_path} ({len(sanitization_records)} record(s))")

        # ---- upload ------------------------------------------------------- #
        do_upload = (not args.no_upload) and (not args.dry_run)
        if do_upload:
            token = os.environ.get("HF_TOKEN") or os.environ.get("HUGGING_FACE_HUB_TOKEN")
            if not token:
                print("\n[upload] no HF_TOKEN/HUGGING_FACE_HUB_TOKEN; skipping upload.")
            else:
                ok, who = token_has_write(token)
                print(f"\n[upload] token user={who!r} write_access={ok}")
                if not ok:
                    print("[upload] token lacks write access; skipping upload.")
                else:
                    # ---- union merge: remote + local, dedup by trace_key ---- #
                    # The uploaded data is the union of whatever is already in the
                    # repo (from this or another machine) and the local conversion.
                    # Traces are deduped by trace_key (pi session id); local wins on
                    # conflict since it is the freshest conversion. Old remote
                    # shards are deleted only after the merged shard uploads, so a
                    # run never loses data another machine put there. Note: two
                    # machines running concurrently can still race (HF has no lock);
                    # run uploads sequentially across machines.
                    with tempfile.TemporaryDirectory(prefix="pi-traces-remote-") as rtmpd:
                        remote_rows, remote_shards = download_remote_rows(
                            args.repo, token, Path(rtmpd)
                        )
                    remote_keys = {r.get("trace_key") for r in remote_rows if r.get("trace_key")}
                    local_keys = {r.get("trace_key") for r in rows if r.get("trace_key")}
                    new_keys = local_keys - remote_keys
                    print(f"\n[upload] union: remote={len(remote_rows)} rows "
                          f"({len(remote_shards)} shard{'s' if len(remote_shards) != 1 else ''}), "
                          f"local={len(rows)} rows, new={len(new_keys)}")
                    # merged set: remote first, local overwrites (freshest)
                    merged: dict[str, dict] = {}
                    for r in remote_rows:
                        k = r.get("trace_key")
                        if k:
                            merged[k] = r
                    for r in rows:
                        k = r.get("trace_key")
                        if k:
                            merged[k] = r
                    if not args.no_eval:
                        n_cap = cap_union_eval_rows(merged, args.eval_cap)
                        if n_cap:
                            print(f"[upload] dropped {n_cap} merged eval row(s) "
                                  f"to enforce the {args.eval_cap}/task cap")
                    if not args.keep_smoke:
                        n_smoke = 0
                        for k in [k for k, r in merged.items() if smoke_drop_reason(r)]:
                            del merged[k]
                            n_smoke += 1
                        if n_smoke:
                            print(f"[upload] dropped {n_smoke} merged smoke/empty row(s)")
                    if not args.keep_newline_reasoning:
                        merged_truncated = 0
                        merged_excluded = 0
                        for key in list(merged):
                            clean_row, sanitization = sanitize_newline_reasoning(merged[key])
                            if sanitization:
                                sanitization_records[sanitization["trace_key"]] = sanitization
                                if sanitization["action"] == "exclude_trace":
                                    merged_excluded += 1
                                else:
                                    merged_truncated += 1
                            if clean_row is None:
                                del merged[key]
                            else:
                                merged[key] = clean_row
                        print(f"[upload] newline-reasoning policy: truncated={merged_truncated} "
                              f"excluded={merged_excluded}")
                    write_jsonl(
                        [sanitization_records[key] for key in sorted(sanitization_records)],
                        manifest_path,
                    )
                    # An upload is needed when any merged row changed or a key was
                    # added/removed. This includes sanitation of remote-only rows.
                    remote_by_key = {r.get("trace_key"): r for r in remote_rows if r.get("trace_key")}
                    changed_keys = {
                        k for k in set(merged) & remote_keys
                        if json.dumps(merged[k], sort_keys=True)
                        != json.dumps(remote_by_key.get(k), sort_keys=True)
                    }
                    data_changed = set(merged.keys()) != remote_keys or bool(changed_keys) or not remote_shards
                    if not data_changed:
                        print("[upload] no data changes after merge/filter; remote shard is already current.")
                    else:
                        if remote_rows:
                            uts = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
                            u_jsonl = out_dir / f"pi-traces-union-{uts}.jsonl"
                            upload_zst = out_dir / f"pi-traces-union-{uts}.jsonl.zst"
                            write_jsonl(list(merged.values()), u_jsonl)
                            compress_zst(u_jsonl, upload_zst, level=args.zstd_level)
                            print(f"  union shard: {upload_zst} "
                                  f"({len(merged)} rows, {upload_zst.stat().st_size:,} B)")
                        else:
                            upload_zst = zst_path
                        upload_to_hub([upload_zst], args.repo, token, dry_run=False)
                        upload_repo_file(
                            manifest_path,
                            NEWLINE_REASONING_MANIFEST_REPO_PATH,
                            args.repo,
                            token,
                        )
                        upload_repo_file(dataset_card_path, DATASET_CARD_REPO_PATH, args.repo, token)
                        if remote_shards:
                            delete_remote_shards(args.repo, token, remote_shards)
                    if not data_changed:
                        # Metadata is stable-path state and may be absent even when
                        # the data shard itself is already current.
                        upload_repo_file(
                            manifest_path,
                            NEWLINE_REASONING_MANIFEST_REPO_PATH,
                            args.repo,
                            token,
                        )
                        upload_repo_file(dataset_card_path, DATASET_CARD_REPO_PATH, args.repo, token)
        elif args.dry_run:
            print("\n[dry-run] not uploading.")
        else:
            print("\n[--no-upload] not uploading.")

    print("\nDone.")
    return 0


def _first_user_text(messages: list[dict], limit: int = 500) -> str:
    """Return the text of the first user message, truncated."""
    for m in messages:
        if m.get("role") == "user":
            c = m.get("content")
            if isinstance(c, list) and c and isinstance(c[0], dict):
                return (c[0].get("text") or "")[:limit]
            if isinstance(c, str):
                return c[:limit]
            break
    return ""


def _tools_from_row(row: dict) -> set[str]:
    s: set[str] = set()
    for m in row.get("messages", []):
        for tc in m.get("tool_calls") or []:
            n = tc.get("function", {}).get("name")
            if n:
                s.add(str(n))
    return s


if __name__ == "__main__":
    sys.exit(main())
