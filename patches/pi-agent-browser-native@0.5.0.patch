--- a/dist/extensions/agent-browser/lib/write-path-policy.js	1969-12-31 18:00:00.000000000 -0600
+++ b/dist/extensions/agent-browser/lib/write-path-policy.js	2026-08-24 15:09:58.000000000 -0500
