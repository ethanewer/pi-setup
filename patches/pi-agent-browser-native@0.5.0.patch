+        resolve(cwd),
+        resolve(tmpdir()),
+        ...(process.platform === "win32" ? [] : ["/tmp"]),
+        ...configuredRoots,
+    ].map((root) => resolveRealWritePath(root));
+}
+export function isConfinedWritePath(requestedPath, cwd, env = process.env) {
+    if (isTruthyEnvValue(env[UNCONFINED_WRITES_ENV]))
